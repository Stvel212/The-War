package UnitStats
import UnitObjEditing

/*
	Полная подсказка юнита («Характеристики: Награда / Атакующие / Атака, Скорость атаки / Тип атаки /
	Защитные: Здоровье, Защита / Тип защиты / Способность») собирается из цифр, а не пишется руками:

		let stats = new Stats()
			..bounty(2)..ranged(400)
			..attack(18, 24, 1.5, AttackType.Pierce)
			..defense(520, 0, ArmorType.Medium)
			..skill("Имеет 15% шанс заблокировать 15 ед. физического урона.")
			..skill("(Требуется 60 маны) (Перезарядка 10 секунд)")   // каждый вызов — ещё одна строка
		new UnitDefinition('h004', 'hrif')
		..setStats(stats)

	setStats задаёт только подсказку (так у зданий: их подсказка описывает обучаемого юнита). applyStats у юнита
	ещё и выставляет по тем же цифрам урон (1 кость: база = min − 1, грани = max − min + 1), перезарядку,
	здоровье и защиту — подсказка не разойдётся с юнитом. Юниту с другим числом костей атаки — setStats и
	поля руками. Перевод подсказок
	(locales/enUS.txt) ищет строку по готовому русскому тексту, так что формат ниже менять аккуратно.
*/
public class Stats
	private string bountyLine = null
	private string range = "(Ближний бой)"
	private string attackText = ""
	private string speedText = ""
	private string attackTypeText = ""
	private string hpText = ""
	private string armorText = ""
	private string armorTypeText = ""
	private string abilityText = null
	// цифры для applyStats
	int minDamage = 0
	int maxDamage = 0
	real attackCooldown = 0.
	int maxHp = 0
	int baseArmor = 0

	/** Награда: +n золота за убийство */
	function bounty(int n) returns thistype
		bountyLine = "|c00FFFF00Награда:|r " + (n > 0 ? "+" + n : n.toString())
		return this

	/** [Инком] +n — юнит даёт доход, а не награду */
	function income(int n) returns thistype
		bountyLine = "|c0000FF00[Инком]|r +" + n
		return this

	function melee() returns thistype
		range = "(Ближний бой)"
		return this

	function melee(int range) returns thistype
		this.range = "(Ближний бой/" + range + ")"
		return this

	function ranged(int range) returns thistype
		this.range = "(Дальний бой/" + range + ")"
		return this

	function attack(int min, int max, real cooldown, AttackType kind) returns thistype
		minDamage = min
		maxDamage = max
		attackCooldown = cooldown
		attackText = min + "-" + max
		speedText = fmt(cooldown)
		attackTypeText = attackTypeName(kind)
		return this

	function defense(int hp, int armor, ArmorType kind) returns thistype
		maxHp = hp
		baseArmor = armor
		hpText = hp.toString()
		armorText = armor.toString()
		armorTypeText = armorTypeName(kind)
		return this

	/** Текст после «Способность:»; повторный вызов добавляет строку. Без вызова — «Нет». */
	function skill(string line) returns thistype
		abilityText = abilityText == null ? line : abilityText + "\r\n" + line
		return this

	/** База урона при одной кости: атака min-max = база + 1 … база + грани */
	function damageBase() returns int
		return minDamage - 1

	function damageSides() returns int
		return maxDamage - minDamage + 1

	function text() returns string
		var s = "|c00C0C0C0    Характеристики:|r\r\n"
		if bountyLine != null
			s += "                                " + bountyLine + "\r\n"
		s += "|c00FF0000Атакующие:|r |c005BADFF" + range + "|r\r\n"
		s += "     |c00C0C0C0Атака:|r " + attackText + "       |c00C0C0C0 Скорость атаки|r " + speedText + "\r\n"
		s += "|c00C0C0C0Тип атаки:|r " + attackTypeText + "\r\n\r\n"
		s += "|c0000FF00Защитные:|r\r\n"
		s += "     |c00C0C0C0Здоровье:|r " + hpText + "       |c00C0C0C0Защита:|r " + armorText + "\r\n"
		s += "|c00C0C0C0Тип защиты:|r " + armorTypeText + "\r\n\r\n"
		s += "|c00FF8000Способность:|r " + (abilityText == null ? "Нет" : abilityText)
		return s

/** Подсказка из Stats; объект Stats после этого не нужен */
public function UnitOrBuildingOrHeroDefinition.setStats(Stats stats)
	this.setTooltipExtended(stats.text())
	destroy stats

/** Подсказка из Stats и те же цифры в полях юнита: урон (1 кость), перезарядка, здоровье, защита */
public function UnitDefinition.applyStats(Stats stats)
	this.setAttack1DamageBase(stats.damageBase())
	this.setAttack1DamageSidesperDie(stats.damageSides())
	this.setAttack1CooldownTime(stats.attackCooldown)
	this.setHitPointsMaximumBase(stats.maxHp)
	this.setDefenseBase(stats.baseArmor)
	this.setStats(stats)

/** 1.5 -> "1.5", 2.88 -> "2.88", 1.0 -> "1" (R2S даёт "1.500") */
function fmt(real r) returns string
	let whole = r.toInt()
	let cents = ((r - whole) * 100 + 0.5).toInt()
	if cents == 0
		return whole.toString()
	if cents mod 10 == 0
		return whole + "." + (cents div 10)
	return whole + "." + (cents < 10 ? "0" : "") + cents

function attackTypeName(AttackType t) returns string
	switch t
		case Normal
			return "Обычный"
		case Pierce
			return "Колющий"
		case Siege
			return "Осадный"
		case Spells
			return "Магия"
		case Chaos
			return "Хаос"
		case Magic
			return "Магия"
		case Hero
			return "Герой"
		default
			return "?"

function armorTypeName(ArmorType t) returns string
	switch t
		case Small
			return "Лёгкий"
		case Medium
			return "Средний"
		case Large
			return "Тяжёлый"
		case Fortified
			return "Укреплённый"
		case Normal
			return "Обычный"
		case Hero
			return "Герой"
		case Divine
			return "Божественный"
		case Unarmored
			return "Без защиты"
