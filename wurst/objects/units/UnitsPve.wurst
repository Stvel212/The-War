package UnitsPve
import AbilityObjEditing

/*
    Объекты PvE — копии Just Fight 5.6 (те же числа: константы геймплея у карт одинаковые):
    - Забытые (H0BS / H0BR / H0BM, «уровень 200 / 500 / 1000») — неподвижные герои Злого Бога на средней линии,
      атака по 4 / 8 / 12 целям сразу (Шквал), без регенерации; 'UPB4' — «Забытый (ложный)» (H0C9) уровней 3+:
      после его смерти появляется настоящий; 'nPB5' — Терминатор (H0BT), волны после 69-й.
    - 'hPGN' — Генератор энергии игрока (h0BN): монстры его линии сначала ломают его; есть «Благословение» (A0L1). */

/** Шквал Забытого: бьёт ещё по targets целям в 800 вокруг (Rocket Attack, как A0I2/A0HV/A0HN) */
function barrage(int id, int targets)
	new AbilityDefinitionRocketAttack(id)
		..setName("Ледяная скорбь")
		..setTooltipNormal(1, "Ледяная скорбь")
		..setTooltipNormalExtended(1, "Таинственный клинок: атака поражает сразу несколько врагов.")
		..setRequirements("")
		..setTargetsAllowed(1, "ground,ward,enemies,air")
		..setMaximumNumberofTargets(1, targets)
		..setMaximumTotalDamage(1, 100000.0)
		..setDamagePerTarget(1, 0.0)
		..setCooldown(1, 0.1)
		..setMissileArt("Abilities\\Spells\\NightElf\\CorrosiveBreath\\CorrosiveBreathMissile.mdl")
		..setAreaofEffect(1, 800.0)
		..setDurationHero(1, 0.1)
		..setDurationNormal(1, 0.1)
		..setMissileArc(0.0)
		..setMissileSpeed(1800)
		..setRace(Race.Creeps)
		..setEditorSuffix("(PvE)")

@compiletime function create_w3a_PveAbilities()
	barrage('APB1', 4)
	barrage('APB2', 8)
	barrage('APB3', 12)
	// крит Терминатора (A083)
	new AbilityDefinitionCriticalStrikecreep('APB4')
		..setTargetsAllowed(1, "neutral,ground,ward,enemies,air")
		..setChancetoCriticalStrike(1, 25.0)
		..setEditorSuffix("(PvE)")
	// иллюзия Мечника / Мастера Чёрной скалы (nJ1Q / nJ1U) на 3 с — кастуют на себя (CreepSpells)
	new AbilityDefinitionItemIllusion('APB5')
		..setItemAbility(false)
		..setName("Чёрная скала")
		..setTargetsAllowed(1, "self")
		..setDurationNormal(1, 3.0)
		..setDurationHero(1, 3.0)
		..setDamageDealtofnormal(1, 1.0)
		..setDamageReceivedMultiplier(1, 1.0)
		..setCooldown(1, 0.0)
		..setManaCost(1, 0)
		..setEditorSuffix("(PvE)")
	// Благословение генератора (A0L1): мгновенно, перезарядка 300 с — золото «100 + раунд·3» (Pve)
	new AbilityDefinitionIllidanChannel('APBL')
		..setLevels(1)
		..setName("Благословение")
		..setTooltipNormal(1, "Благословение (|cffffcc00R|r)")
		..setTooltipNormalExtended(1, "После молитвы вы получите «100 + раунд·3» золота.|n|n|cffc0c0c0Перезарядка: 300 секунд|nИспользований: PvE 1 — 3, PvE 2 — 2, PvE 3 — 1|r")
		..setIconNormal("ReplaceableTextures\\CommandButtons\\BTNHolyBolt.blp")
		..setHotkeyNormal("R")
		..setButtonPositionNormalX(0)
		..setButtonPositionNormalY(2)
		..setCooldown(1, 300.0)
		..setManaCost(1, 0)
		..setTargetType(1, 0)
		..setOptions(1, 1)
		..setFollowThroughTime(1, 0.0)
		..setArtDuration(1, 0.0)
		..setDisableOtherAbilities(1, false)
		..setBaseOrderID(1, "charm")
		..setArtEffect("")
		..setArtTarget("")
		..setArtCaster("Abilities\\Spells\\Human\\HolyBolt\\HolyBoltSpecialArt.mdl")
		..setEditorSuffix("(PvE)")

/** Забытый: неподвижный герой с атакой по площади 800, броня Укреплённая, без регенерации и награды */
function forgotten(int id, string name, string suffix, int hp, int armor, int str, int agi, int intel, string abilities, real scale)
	new HeroDefinition(id, 'Harf')
		..setName(name)
		..setProperNames(name)
		..setTooltipBasic(name)
		..setTooltipExtended("")
		..setModelFile("Units\\Creeps\\ForgottenOne\\ForgottenOne.mdl")
		..setIconGameInterface("ReplaceableTextures\\CommandButtons\\BTNForgottenOne.blp")
		..setScalingValue(scale)
		..setSelectionScale(scale * 2.)
		..setHitPointsMaximumBase(hp)
		..setHitPointsRegenerationRate(0.0)
		..setManaRegeneration(0.0)
		..setManaInitialAmount(0)
		..setDefenseBase(armor)
		..setArmorType(ArmorType.Fortified)
		..setStartingStrength(str)
		..setStartingAgility(agi)
		..setStartingIntelligence(intel)
		..setStrengthPerLevel(0.0)
		..setAgilityPerLevel(0.0)
		..setIntelligencePerLevel(0.0)
		..setPrimaryAttribute("INT")
		..setHeroAbilities("")
		..setNormalAbilities(abilities)
		..setAttack1ProjectileArt("Abilities\\Weapons\\FarseerMissile\\FarseerMissile.mdl")
		..setAttack1ProjectileSpeed(1800)
		..setAttack1ProjectileHomingEnabled(true)
		..setAttack1WeaponType(WeaponType.Missile)
		..setAttack1TargetsAllowed("ground,structure,debris,air,item,ward")
		..setAttack1Range(800)
		..setAttack1CooldownTime(0.3)
		..setAttack1DamageBase(-1)
		..setAttack1DamageNumberofDice(1)
		..setAttack1DamageSidesperDie(1)
		..setAcquisitionRange(800.0)
		..setSpeedBase(0)
		..setGoldCost(0)
		..setLumberCost(0)
		..setRepairGoldCost(0)
		..setRepairLumberCost(0)
		..setUpgradesUsed("")
		..setGoldBountyAwardedBase(0)
		..setGoldBountyAwardedNumberofDice(0)
		..setGoldBountyAwardedSidesperDie(0)
		..setNameEditorSuffix(suffix)

@compiletime function create_w3u_PveBosses()
	forgotten('UPB1', "Забытый", "(PvE малый босс)", 60000, 20, 100, 100, 40, "APB1", 1.2)
	forgotten('UPB2', "Забытый", "(PvE средний босс)", 150000, 50, 300, 300, 120, "APB2", 1.5)
	forgotten('UPB3', "Злой Бог", "(PvE главный босс)", 300000, 100, 500, 500, 190, "AInv,APB3", 2.0)
	forgotten('UPB4', "Забытый (ложный)", "(PvE ложный босс)", 300000, 100, 500, 500, 190, "AInv,APB3", 2.0)

@compiletime function create_w3u_nPB5()
	// в Just Fight — герой H0BT (ИНТ 300 основной); здесь обычный юнит с той же атакой 300: героев-монстров Tree не
	// ведёт по линии (Main.isFighter), и после боя они бы стояли
	new UnitDefinition('nPB5', 'nbal')
	..setName("Терминатор")
	..setTooltipBasic("Терминатор")
	..setTooltipExtended("")
	..setModelFile("units\\demon\\DoomGuard\\DoomGuard.mdl")
	..setIconGameInterface("ReplaceableTextures\\CommandButtons\\BTNDoomGuard.blp")
	..setScalingValue(1.5)
	..setSelectionScale(3.)
	..setHitPointsMaximumBase(30000)
	..setHitPointsRegenerationRate(0.0)
	..setManaRegeneration(0.0)
	..setManaInitialAmount(0)
	..setDefenseBase(30)
	..setArmorType(ArmorType.Fortified)
	..setNormalAbilities("APB4")
	..setAttack1ProjectileArt("Abilities\\Weapons\\DemonHunterMissile\\DemonHunterMissile.mdl")
	..setAttack1ProjectileSpeed(1800)
	..setAttack1ProjectileHomingEnabled(true)
	..setAttack1WeaponType(WeaponType.Missile)
	..setAttack1TargetsAllowed("ground,structure,debris,air,item,ward")
	..setAttack1Range(500)
	..setAttack1CooldownTime(0.3)
	..setAttack1DamageBase(299)
	..setAttack1DamageNumberofDice(1)
	..setAttack1DamageSidesperDie(1)
	..setAcquisitionRange(800.0)
	..setSpeedBase(300)
	..setAttack1AttackType(AttackType.Hero)
	..setRace(Race.Demon)
	..setFoodCost(0)
	..setBuildTime(1)
	..setCanFlee(false)
	..setUnitClassification("giant")
	..setGoldCost(0)
	..setLumberCost(0)
	..setRepairGoldCost(0)
	..setRepairLumberCost(0)
	..setUpgradesUsed("")
	..setGoldBountyAwardedBase(0)
	..setGoldBountyAwardedNumberofDice(0)
	..setGoldBountyAwardedSidesperDie(0)
	..setNameEditorSuffix("(PvE после 69-й волны)")

@compiletime function create_w3u_hPGN()
	new BuildingDefinition('hPGN', 'hhou')
	..setName("Генератор энергии")
	..setTooltipBasic("Генератор энергии")
	..setTooltipExtended("Монстры линии сначала ломают генератор. Разрушен — монстры прорываются к Богу Войны.")
	..setModelFile("buildings\\other\\PowerGenerator\\PowerGenerator.mdl")
	..setIconGameInterface("ReplaceableTextures\\CommandButtons\\BTNPowerGenerator.blp")
	..setNormalAbilities("APBL")
	..setUpgradesUsed("")
	..setGoldCost(0)
	..setLumberCost(0)
	..setRepairGoldCost(0)
	..setRepairLumberCost(0)
	..setRepairTime(0)
	..setBuildTime(1)
	..setFoodProduced(0)
	..setFoodCost(0)
	..setHitPointsMaximumBase(3000)
	..setHitPointsRegenerationType("always")
	..setHitPointsRegenerationRate(30.0)
	..setDefenseBase(10)
	..setArmorType(ArmorType.Fortified)
	// не перекрывает линию: без карты проходимости
	..setPathingMap("")
	// ставится и на землю «нельзя строить» (середина линии): иначе игра сдвигает здание к стройплощадке
	..setPlacementRequires("")
	..setPlacementPreventedBy("")
	..setCollisionSize(0.)
	..setNameEditorSuffix("(PvE)")
