@compiletime function create_w3u_u004()
	let stats = new Stats()
		..bounty(6)..ranged(225)
		..attack(61, 73, 2.1, AttackType.Magic)
		..defense(880, 16, ArmorType.Fortified)
		..skill("Восстанавливает 20 здоровья всем союзным юнитам.")
