package UnitsCritters
import UnitObjEditing

@compiletime function create_w3u_h02T()
	new UnitDefinition('h02T', 'hhes')
	..setName("Артас")
	..setTooltipBasic("Артас")
	..setTooltipExtended("Ходячая аура и деф")
	..setScalingValue(0.5)
	..setSelectionScale(0.6)
	..setModelFile("units\\human\\ArthaswithSword\\ArthaswithSword.mdl")
	..setIconGameInterface("ReplaceableTextures\\CommandButtons\\BTNArthas.blp")
	..setAttack1DamageBase(9)
	..setAttack1DamageSidesperDie(1)
	..setAttack1CooldownTime(1.3)
	..setGoldCost(0)
	..setHitPointsMaximumBase(777)
	..setFoodCost(0)
	..setSpeedBase(300)
	..setUpgradesUsed("")
	..setNormalAbilities("Avul,A100,A038,A007")
	..setCollisionSize(0.0)
	..setUnitSoundSet("")
	..setAttack1AnimationBackswingPoint(0.567)
	..setAttack1AnimationDamagePoint(0.433)
	..setAttack1TargetsAllowed("ground,structure,debris,air,item,ward")
	..setRace(Race.Critters)
	..setCategorizationCampaign(false)
	..setAttack1AttackType(AttackType.Chaos)
	..setArmorType(ArmorType.Hero)
	..setAnimationCastPoint(0.0)
	..setAnimationCastBackswing(0.0)
	..setAttack1ShowUI(false)
	..setAttack1Range(120)
	..setDeathType(0)
	..setSightRadiusDay(120)
	..setSightRadiusNight(120)
	..setHitPointsRegenerationRate(1.0)
	..setMovementType(MovementType.Fly)
	..setUnitClassification("ancient")
	..setAttack1WeaponType(WeaponType.Missile)
	..setTargetedAs("hero")

