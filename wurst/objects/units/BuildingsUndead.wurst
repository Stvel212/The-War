package BuildingsUndead
import UnitObjEditing
import UnitStats

@compiletime function create_w3u_h025()
	let stats = new Stats()
		..bounty(10)..melee(200)
		..attack(60, 70, 1.2, AttackType.Hero)
		..defense(1180, 3, ArmorType.Hero)
		..skill("Имеет ауру, восстанавливающую 8 здоровья в секунду.")
		..skill("Когда здоровье этого существа становится ниже 50%, то восстанавливает 490 ед.")
		..skill("(Требуется 60 маны) (Перезарядка 10 секунд)")
		..skill("Атаки замедляют скорость атаки и передвижения цели на 15% на 3 секунды.")
	new BuildingDefinition('h025', 'hhou')
	..setName("|c00C0C0C0[Баррак]|r")
	..setModelFile("units\\undead\\HeroDeathKnight\\HeroDeathKnight.mdl")
	..setTooltipBasic("|c00FF8000[Гepoй]|r - |c00C082FFPыцapь Cмepти|r")
	..setStats(stats)
	..setIconGameInterface("ReplaceableTextures\\CommandButtons\\BTNHeroDeathKnight.blp")
	..setUpgradesUsed("")
	..setScalingValue(0.8)
	..setSelectionScale(2.0)
	..setNormalAbilities("Avul")
	..setGoldCost(625)
	..setLumberCost(0)
	..setRepairGoldCost(0)
	..setRepairLumberCost(0)
	..setRepairTime(0)
	..setBuildTime(1)
	..setFoodProduced(0)
	..setFoodCost(5)
	..setUnitSoundSet("HeroDeathKnight")
	..setUpgradesTo("h026")
	..setRace(Race.Undead)
	..setHitPointsMaximumBase(625)
	..setPointValue(318)
	..setButtonPositionY(2)
	..setButtonPositionX(0)
	..setHotkey("Z")
	..setArtTarget("custom_u001")
	..setRequirements("e100")
	..setPathingMap("PathTextures\\4x4unbuildable.tga")
	..setCollisionSize(0.0)
	..setGroundTexture("")
	..setUnitsTrained("u001")

