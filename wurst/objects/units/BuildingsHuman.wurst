package BuildingsHuman
import UnitObjEditing
import UnitStats

@compiletime function create_w3u_h00T()
	let stats = new Stats()
		..bounty(4)..melee()
		..attack(27, 35, 1.5, AttackType.Normal)
		..defense(800, 5, ArmorType.Large)
		..skill("Имеет 15% шанс заблокировать 15 ед. физического урона.")
	new BuildingDefinition('h00T', 'hhou')
	..setName("|c00C0C0C0[Баррак]|r")
	..setModelFile("units\\human\\Knight\\Knight.mdl")
	..setTooltipBasic("|c00C0C0C0[Построить:]|r Рыцарь |c00FF8000[Т3]|r")
	..setStats(stats)
	..setHotkey("E")
	..setIconGameInterface("ReplaceableTextures\\CommandButtons\\BTNKnight.blp")
	..setUpgradesUsed("")
	..setScalingValue(0.8)
	..setSelectionScale(2.0)
	..setButtonPositionY(0)
	..setNormalAbilities("A006,Avul")
	..setGoldCost(220)
	..setLumberCost(0)
	..setRepairGoldCost(0)
	..setRepairLumberCost(0)
	..setRepairTime(0)
	..setBuildTime(1)
	..setFoodProduced(0)
	..setFoodCost(2)
	..setButtonPositionX(2)
	..setUnitSoundSet("")
	..setRequiredAnimationNames("upgrade,first")
	..setRequiredAnimationNamesAttachments("large")
	..setUpgradesTo("h03O,h013")
	..setHitPointsMaximumBase(220)
	..setPointValue(7)
	..setArtTarget("custom_h006")
	..setPathingMap("PathTextures\\4x4unbuildable.tga")
	..setUnitsTrained("h006")

