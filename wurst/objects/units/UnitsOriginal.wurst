package UnitsOriginal
import UnitObjEditing
import UnitStats

@compiletime function create_w3u_ucs1()
	new UnitDefinition('ucs1', 'ucs1')
	..setHitPointsMaximumBase(150)
	..setUnitClassification("giant")

@compiletime function create_w3u_eaow()
	new BuildingDefinition('eaow', 'eaow')
	..setArtSpecial("Objects\\Spawnmodels\\NightElf\\NECancelDeath\\NECancelDeath.mdl")

@compiletime function create_w3u_npn3()
	let stats = new Stats()
		..bounty(0)..melee(128)
		..attack(37, 43, 1.35, AttackType.Hero)
		..defense(1000, 5, ArmorType.Hero)
		..skill("15% шанс нанести х3 урон, 15% шанс уклониться от атаки противника, частичная невосприимчивость к магии.")
		..skill("Громовая поступь на 97 ед. урона и стан на 1.15 секунд в радиусе 250.")
		..skill("(Требуется 60 маны) (Перезарядка 10 секунд)")
	new UnitDefinition('npn3', 'npn3')
	..setNormalAbilities("ACrk,A068,A03U")
	..setHitPointsMaximumBase(1000)
	..setManaRegeneration(3.0)
	..setManaMaximum(60)
	..setManaInitialAmount(60)
	..setAttack1AttackType(AttackType.Hero)
	..setArmorType(ArmorType.Hero)
	..setSpeedBase(200)
	..setStats(stats)

@compiletime function create_w3u_npn6()
	new UnitDefinition('npn6', 'npn6')
	..setNormalAbilities("ACpv,ANta,ACrk")

@compiletime function create_w3u_npn2()
	let stats = new Stats()
		..bounty(0)..ranged(500)
		..attack(37, 43, 1.5, AttackType.Hero)
		..defense(1000, 2, ArmorType.Hero)
		..skill("15% шанс нанести х3 урон, 15% шанс уклониться от атаки противника.")
		..skill("Аура на повышение скорости атаки и передвижения на 10%, частичная невосприимчивость к магии.")
	new UnitDefinition('npn2', 'npn2')
	..setNormalAbilities("ACrk,A068,S00F")
	..setArmorType(ArmorType.Hero)
	..setAttack1AttackType(AttackType.Hero)
	..setManaMaximum(0)
	..setManaInitialAmount(0)
	..setManaRegeneration(0.0)
	..setSpeedBase(200)
	..setStats(stats)

@compiletime function create_w3u_npn1()
	let stats = new Stats()
		..bounty(0)..melee(128)
		..attack(52, 62, 1.35, AttackType.Hero)
		..defense(1000, 2, ArmorType.Hero)
		..skill("15% шанс нанести х3 урон, 15% шанс уклониться от атаки противника.")
		..skill("Жар преисподней: наносит 10 урона в секунду в радиусе 220 и частичная невосприимчивость к магии.")
	new UnitDefinition('npn1', 'npn1')
	..setNormalAbilities("Apig,ACrk,A068")
	..setHitPointsMaximumBase(1000)
	..setArmorType(ArmorType.Hero)
	..setAttack1AttackType(AttackType.Hero)
	..setSpeedBase(200)
	..setStats(stats)
