	..setNormalAbilities("A02U,A0BP,A0BQ")
	..setStartingStrength(60)
	..setStartingAgility(60)
	..setStartingIntelligence(60)
	..setStrengthPerLevel(0.0)
	..setAgilityPerLevel(0.0)
