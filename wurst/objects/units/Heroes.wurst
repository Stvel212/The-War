	..setGoldCost(0)
	..setRepairLumberCost(0)
	..setRepairGoldCost(0)
	..setManaMaximum(660)
	..setArmorType(ArmorType.Fortified)
	..setDeathTimeseconds(5.0)
	..setUpgradesUsed("")
	..setAttack1AnimationBackswingPoint(0.55)
	..setPriority(10)
	..setProperNames("|c00FF8000Король|r")
	..setModelFile("models\\King.mdl")
	..setNameEditorSuffix("")
	..setUnitSoundSet("Uther")
	..setIconGameInterface("ReplaceableTextures\\CommandButtons\\BTNHeroPaladin.blp")
