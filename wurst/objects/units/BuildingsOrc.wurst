package BuildingsOrc
import UnitObjEditing
import UnitStats

@compiletime function create_w3u_h021()
	let stats = new Stats()
		..bounty(10)..melee()
		..attack(64, 75, 1.35, AttackType.Hero)
		..defense(1350, 4, ArmorType.Hero)
		..skill("Призывает на свою сторону медведя.")
		..skill("(Требуется 60 маны) (Перезарядка 10 секунд)")
		..skill("При появлении призывает летучую мышь.")
		..skill("Мышь наносит 50 ед. урона случайному противнику каждую секунду и имеет 30% шанс оглушить на 0.3 секунды.")
	new BuildingDefinition('h021', 'hhou')
	..setName("|c00C0C0C0[Баррак]|r")
	..setModelFile("Units\\Other\\Rexxar\\Rexxar.mdl")
	..setTooltipBasic("|c00FF8000[Гepoй]|r - |c00D1D1A3Пoвeлитeль Звepeй|r")
	..setStats(stats)
	..setIconGameInterface("ReplaceableTextures\\CommandButtons\\BTNBeastMaster.blp")
	..setUpgradesUsed("")
	..setSelectionScale(2.0)
	..setNormalAbilities("Avul,A0H3")
	..setGoldCost(620)
	..setLumberCost(0)
	..setRepairGoldCost(0)
	..setRepairLumberCost(0)
	..setRepairTime(0)
	..setBuildTime(1)
	..setFoodProduced(0)
	..setFoodCost(5)
	..setUnitSoundSet("Beastmaster")
	..setHitPointsMaximumBase(620)
	..setRace(Race.Orc)
	..setPointValue(167)
	..setCategorizationCampaign(true)
	..setShadowTextureBuilding("ShadowCrates")
	..setGroundTexture("OSMA")
	..setUpgradesTo("h022")
	..setButtonPositionY(2)
	..setHotkey("")
	..setArtTarget("custom_n003")
	..setRequirements("e100")
	..setPathingMap("PathTextures\\4x4unbuildable.tga")
	..setUnitsTrained("n003")

