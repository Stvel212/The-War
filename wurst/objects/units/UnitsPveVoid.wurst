	leader('nPL2', 'oshm', "Отчуждённый Убийца теней", "units\\orc\\HeroShadowHunter\\HeroShadowHunter.mdl", 3868, 8, 188, 22, 1.0, 420, AttackType.Hero)
	leader('nPL3', 'even', "Отчуждённый Демон", "units\\nightelf\\HeroDemonHunter\\HeroDemonHunter.mdl", 6800, 9, 382, 10, 0.9, 128, AttackType.Chaos)
