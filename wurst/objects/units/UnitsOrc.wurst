@compiletime function create_w3u_n004()
	let stats = new Stats()
		..bounty(0)..melee(128)
		..attack(76, 77, 1.2, AttackType.Normal)
		..defense(2500, 3, ArmorType.Large)
	new UnitDefinition('n004', 'ncen')
	..setCollisionSize(12.0)
	..setSpeedBase(200)
	..setFoodCost(0)
	..setRace(Race.Orc)
	..setCategorizationCampaign(true)
	..setHitPointsRegenerationRate(0.25)
	..setTooltipBasic("|c00B1B165Гризли|r")
	..setHotkey("")
	..applyStats(stats)
	..setNormalAbilities("")
	..setAttack1Range(128)
	..setAcquisitionRange(800.0)
	..setGoldCost(0)
	..setBuildTime(38)
	..setUnitClassification("ward,giant")
	..setAttack1TargetsAllowed("ground,structure,debris,air,item,ward")
	..setName("|c00B1B165Гризли|r")
	..setModelFile("units\\creeps\\GrizzlyBear\\GrizzlyBear.mdl")
	..setIconGameInterface("ReplaceableTextures\\CommandButtons\\BTNGrizzlyBear.blp")
	..setRequiredAnimationNamesAttachments("")
	..setAttack1WeaponSound(WeaponSound.WoodMediumBash)
	..setScalingValue(1.0)
	..setUnitSoundSet("GrizzlyBear")
	..setSelectionScale(2.0)
	..setPriority(5)
	..setTintingColorBlue(100)
	..setTintingColorGreen(100)
	..setTintingColorRed(100)

