package BuildingsNightElf
import UnitObjEditing
import UnitStats

@compiletime function create_w3u_h029()
	let stats = new Stats()
		..bounty(10)..melee()
		..attack(45, 65, 1.35, AttackType.Hero)
		..defense(975, 5, ArmorType.Hero)
		..skill("Имеет 35% шанс увернуться от атаки.")
		..skill("Сжигает 10 здоровья в секунду вражеским существам в радиусе 300.")
		..skill("Призывает свою копию, которая наносит 50% урона, а также получает она на 200% урона больше.")
		..skill("(Требуется 60 маны) (Перезарядка 10 секунд) (Время действия 15 секунд)")
	new BuildingDefinition('h029', 'hhou')
	..setName("|c00C0C0C0[Баррак]|r")
	..setModelFile("units\\nightelf\\HeroDemonHunter\\HeroDemonHunter.mdl")
	..setTooltipBasic("|c00FF8000[Гepoй]|r - |c0080FF80Oxoтник Ha Дeмoнoв|r")
	..setStats(stats)
	..setIconGameInterface("ReplaceableTextures\\CommandButtons\\BTNHeroDemonHunter.blp")
	..setUpgradesUsed("")
	..setScalingValue(0.8)
	..setSelectionScale(2.0)
	..setNormalAbilities("Avul")
	..setGoldCost(650)
	..setLumberCost(0)
	..setRepairGoldCost(0)
	..setRepairLumberCost(0)
	..setRepairTime(0)
	..setBuildTime(1)
	..setFoodProduced(0)
	..setFoodCost(5)
	..setUnitSoundSet("HeroDemonHunter")
	..setRace(Race.Nightelf)
	..setHitPointsMaximumBase(650)
	..setUpgradesTo("h02A")
	..setPointValue(218)
	..setButtonPositionY(2)
	..setHotkey("")
	..setArtTarget("custom_e000")
	..setRequirements("e100")
	..setPathingMap("PathTextures\\4x4unbuildable.tga")
	..setUnitsTrained("e000")

