package BuildingsNaga
import UnitObjEditing
import UnitStats
import UnitTemplates

@compiletime function create_w3u_h02B()
	let stats = new Stats()
		..bounty(10)..ranged(500)
		..attack(53, 69, 1.35, AttackType.Hero)
		..defense(780, 3, ArmorType.Hero)
		..skill("Наносит грозой 325 ед. урона по 3 целям.")
		..skill("(Требуется 60 маны) (Перезарядка 15 секунд)")
		..skill("Атаки имеют 20% шанс наложить очищение, снимая с него любые баффы и парализуя на 1 секунду.")
		..skill("Наносит 300 ед. урона, если цель атаки призванный юнит.")
	barrack('h02B', 'hhou')
	..setModelFile("units\\naga\\LadyVashj\\LadyVashj.mdl")
	..setTooltipBasic("|c00FF8000[Гepoй]|r - |c0080FFFFKopoлeвa Змeй|r")
	..setStats(stats)
	..setIconGameInterface("ReplaceableTextures\\CommandButtons\\BTNNagaSeaWitch.blp")
	..setNormalAbilities("Avul")
	..setGoldCost(560)
	..setFoodCost(5)
	..setUnitSoundSet("SeaWitch")
	..setRace(Race.Naga)
	..setGroundTexture("")
	..setHitPointsMaximumBase(560)
	..setScalingValue(0.85)
	..setSelectionScale(2.0)
	..setUpgradesTo("h02C")
	..setPointValue(418)
	..setButtonPositionY(2)
	..setButtonPositionX(1)
	..setHotkey("X")
	..setArtTarget("custom_n007")
	..setRequirements("e100")
	..setUnitsTrained("n007")

