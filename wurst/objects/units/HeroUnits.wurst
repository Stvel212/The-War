@compiletime function create_w3u_h018()
	let stats = new Stats()
		..bounty(10)..ranged(450)
		..attack(64, 75, 1.6, AttackType.Hero)
		..defense(865, 2, ArmorType.Hero)
		..skill("Призывает 2 волков.")
		..skill("(Требуется 60 маны) (Перезарядка 10 секунд)")
		..skill("Цепь молний наносит 150 ед. урона, распространяющаяся на 3 юнитов.")
		..skill("(Перезарядка 40 секунд)")
	new UnitDefinition('h018', 'hsor')
	..setUpgradesUsed("")
	..setManaMaximum(60)
	..setManaRegeneration(2.0)
	..setManaInitialAmount(60)
	..setFoodCost(0)
	..setLumberCost(0)
	..setGoldCost(0)
	..setTooltipBasic("|c00FF8000[Гepoй]|r - |c0000FF00Гoвopящий C Дyxaми|r")
	..setNormalAbilities("A07Z,A081,A094")
	..setStats(stats)
	..setCasterUpgradeNames("")
	..setCasterUpgradeTips("")
	..setAttack1Range(450)
	..setUnitClassification("ward,giant")
	..setDefaultActiveAbility("")
	..setModelFile("units\\orc\\HeroFarSeer\\HeroFarSeer.mdl")
	..setIconGameInterface("ReplaceableTextures\\CommandButtons\\BTNHeroFarseer.blp")
	..setAttack1DamageBase(63)
