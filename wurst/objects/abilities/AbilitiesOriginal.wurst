package AbilitiesOriginal
import AbilityObjEditing

@compiletime function create_w3a_ACvs()
	new AbilityDefinitionVenomSpearsCreep('ACvs')
	..setTargetsAllowed(1, "ground,ward,organic,air")
	..setDurationNormal(1, 10.0)
	..setDamageperSecond(1, 10.0)
	..setEditorSuffix("")

