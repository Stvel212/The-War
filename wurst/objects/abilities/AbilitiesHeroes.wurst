package AbilitiesHeroes
import AbilityObjEditing
import AbilityTemplates

/* Roo2/Roo4 в карте хранятся как int, а stdlib ждёт строку — пишем сырые значения как было. */
class AbilityDefinitionRootAncientsRaw extends AbilityDefinitionRootAncients
	construct(int newAbilityId)
		super(newAbilityId)

	function setUprootedWeaponsRaw(int level, int value)
		def.setLvlDataInt("Roo2", level, 2, value)

	function setUprootedDefenseTypeRaw(int level, int value)
		def.setLvlDataInt("Roo4", level, 4, value)

@compiletime function create_w3a_A000()
	new AbilityDefinitionSpellBook('A000')
	..setName("|c0000FF80Koмaнды:|r")
	..setMaximumSpells(1, 2)
	..setMinimumSpells(1, 2)
	..setItemAbility(false)
	..setSpellList(1, "A001,A002")
	..setTooltipNormal(1, "|c0000FF80Koмaнды:|r")
	..setTooltipNormalExtended(1, "|c00FF8000Bы ocтaнaвливaeтe или ycкopяeтe вaшy apмию|r")
	..setTooltipTurnOffExtended(1, "|c0000FFFF[Пepeзapядкa:]|r 60 ceкyнд")
	..setTooltipTurnOff(1, "|c00FF8000Bы ocтaнaвливaeтe или ycкopяeтe вaшy apмию|r")
	..setButtonPositionNormalY(1)
	..setButtonPositionNormalX(1)
	..setButtonPositionTurnOffX(1)
	..setButtonPositionTurnOffY(1)
	..setIconNormal("ReplaceableTextures\\CommandButtons\\BTNUpgradeRegenerationAura.blp")
	..setHotkeyNormal("W")

@compiletime function create_w3a_A003()
	channelAbility('A003')
	..setLevels(1)
	..setBaseOrderID(1, "revenge")
	..setOptions(1, 3)
	..setName("|cffff0000[Bзopвaть]|r")
	..setTooltipNormal(1, "|cffff0000[Bзopвaть]|r (|cffffcc00E|r)")
	..setTooltipNormalExtended(1, "|c00FF8000Уничтoжaeт вcex вpaгoв в paдиyce 600 и зaмeняeт этy cпocoбнocть нa:|r |c0000FFFF[Taктикa]|r")
	..setIconNormal("ReplaceableTextures\\CommandButtons\\BTNAvengingAssassin.blp")
	..setRace(Race.Other)
	..setTargetsAllowed(1, "ground,enemies,air")
	..setButtonPositionNormalY(1)
	..setHotkeyNormal("E")
	..setCooldown(1, 15.0)
	..setAreaofEffect(1, 300.0)
	..setTargetType(1, 2)
	..setRequirements("e100")

