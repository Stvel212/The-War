@compiletime function create_w3a_A0D6()
	new AbilityDefinitionMountainKingBash('A0D6')
	..setLevels(1)
	..setHeroAbility(false)
	..setRace(Race.Other)
	..setDamageBonus(1, 0.0)
	..setChancetoBash(1, 0.0)
	..setName("Команды")
	..setTooltipNormal(1, "Список команд")
	..setTooltipNormalExtended(1, "-up 0-600: отдаление камеры.\n-rob: кол-во денег, которое награбил волчьими всадниками. \n-give: Разделить дерево ливера между всей командой.\n-kickafk (слот игрока от 0 до 7): кикает игрока, который афкшит более 5 минут.\n-roll: ввод случайного числа (от 1 до 1000). \n-tunR 0-1000; Пример: -tunR 800 показ области\n-control (только для особых игроков): берёт контроль над своим союзником.")
	..setIconNormal("ReplaceableTextures\\CommandButtons\\BTNSkillz.tga")
	..setButtonPositionNormalX(3)
	..setButtonPositionNormalY(1)
	..setDurationHero(1, 0.0)
	..setDurationNormal(1, 0.0)
	..setBuffs(1, "")
	..setTargetsAllowed(1, "")

