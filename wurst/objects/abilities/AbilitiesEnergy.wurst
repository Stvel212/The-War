package AbilitiesEnergy
import AbilityObjEditing
import EnergyData
import Preloader

/*
    Кнопки энергий на Генераторе энергии в PvE (как в Just Fight: A0JL «Activate Energy» и A0JK… — энергии на
    генераторе h0BN). 'AEN0'..'AEN7' — 8 энергий (уровень способности = уровень энергии, 40 уровней), 'AENA' —
    активировать новую. Канал без цели и без эффекта: щелчок обрабатывает Energies (покупка за энергию профиля).
    Подсказки всех уровней — здесь, в данных (заданные в игре подсказки типа способности клиент не показывает);
    кнопки загружаются при старте карты (preloadAbility), чтобы первая не подтормаживала. У каждой кнопки свой
    приказ — каналы на одном юните не должны совпадать. */

public constant ENERGY_ACTIVATE = 'AENA'
constant ORDERS = ["absorb", "ancestralspirit", "battleroar", "berserk", "bladestorm", "darkconversion", "chemicalrage",
    "cloudoffog", "corporealform"]

/** Способность энергии kind (0..7) */
public function energyAbility(int kind) returns int
    return 'AEN0' + kind

function energyButton(int id, string icon, string order, int levels, int x, int y) returns AbilityDefinition
    let a = new AbilityDefinitionIllidanChannel(id)
        ..setHeroAbility(false)
        ..setLevels(levels)
        ..setIconNormal(icon)
        ..setButtonPositionNormalX(x)
        ..setButtonPositionNormalY(y)
        ..setHotkeyNormal("")
        ..setRequirements("")
        ..setArtCaster("")
        ..setArtEffect("")
        ..setArtTarget("")
        ..setName("Energy")
        ..setEditorSuffix("(PvE generator)")
    for lvl = 1 to levels
        a..setTargetType(lvl, 0)
        ..setOptions(lvl, 1)
        ..setBaseOrderID(lvl, order)
        ..setFollowThroughTime(lvl, 0.)
        ..setArtDuration(lvl, 0.)
        ..setCooldown(lvl, 0.3)
        ..setManaCost(lvl, 0)
        ..setDisableOtherAbilities(lvl, false)
        ..setCastRange(lvl, 0.)
    return a

@compiletime function create_energy_buttons()
    // энергии: два верхних ряда по 4, внизу — «Благословение» генератора (APBL, 0:2) и активация (3:2)
    for kind = 0 to ENERGY_KINDS - 1
        let a = energyButton(energyAbility(kind), energyIcon(kind), ORDERS[kind], ENERGY_MAX_LEVEL, kind mod 4, kind div 4)
        for lvl = 1 to ENERGY_MAX_LEVEL
            a..setTooltipNormal(lvl, energyTooltip(kind, lvl))
            ..setTooltipNormalExtended(lvl, energyTooltipExtended(kind, lvl))
    energyButton(ENERGY_ACTIVATE, "ReplaceableTextures\\CommandButtons\\BTNManaFlare.blp", ORDERS[8], 1, 3, 2)
        ..setTooltipNormal(1, ACTIVATE_TOOLTIP)
        ..setTooltipNormalExtended(1, activateTooltipExtended())

init
    for kind = 0 to ENERGY_KINDS - 1
        preloadAbility(energyAbility(kind))
    preloadAbility(ENERGY_ACTIVATE)
