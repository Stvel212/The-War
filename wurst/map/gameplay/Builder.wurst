package Builder
import Initialization
import MapGlobals
import ArtifactShop
import ClosureEvents
import ClosureTimers
import ClosureForGroups
import Messages

// ============================================================
// Триггер: ControlAdd — выделил чужого юнита при общем контроле → полный контроль и заклинания; показать таблицу
// ============================================================

@noinline
function controlAdd()
    let owner = GetTriggerUnit().getOwner()
    let p = GetTriggerPlayer()
    if not owner.getPlayerAlliance(p, ALLIANCE_SHARED_CONTROL)
        return
    owner.setPlayerAlliance(p, ALLIANCE_SHARED_ADVANCED_CONTROL, true)
    owner.setPlayerAlliance(p, ALLIANCE_SHARED_SPELLS, true)
    board.display(true)

// ============================================================
// Триггер: Repick — 'A00I': замена расы за 100·(уровень-1) дерева, уровень растёт до 6
// ============================================================

@noinline
function repick()
    let u = GetTriggerUnit()
    let p = u.getOwner()
    let lvl = u.getAbilityLevel('A00I')
    let cost = 100 * (lvl - 1)
    if p.getLumber() < cost
        p.message("|c00FF8080Not enough resources for the replacement!|r")
        return
    addEffect("Abilities\\Spells\\Human\\MarkOfChaos\\MarkOfChaosTarget.mdl", u.getPos()).destr()
    random(p)
    p.setLumber(p.getLumber() - cost)
    u.issueImmediateOrder("stop")
    if lvl < 6
        u.setAbilityLevel('A00I', lvl + 1)

// ============================================================
// Триггер: Flag — флаги 'e004' с разными способностями за золото/дерево; при нехватке — случайная реплика
// ============================================================

/** Ставит флаг со способностью abil за gold/lumber; если ресурсов нет — отменяет каст и ругается */
function placeFlag(unit builder, int abil, int gold, int lumber, string joke)
    let p = builder.getOwner()
    if p.getLumber() >= lumber and p.getGold() >= gold
        p.setGold(p.getGold() - gold)
        p.setLumber(p.getLumber() - lumber)
        createUnit(p, 'e004', EventData.getSpellTargetPos())
            ..addAbility(abil)
            ..setTimedLife(10.0, 'BHwe')
        return
    builder.issueImmediateOrder("stop")
    let roll = GetRandomInt(0, 5)
    if roll < 3
        p.message("|c00FF8080Not enough resources to place a flag!|r")
    else if roll < 5
        p.message("|c00FF8080You have no resources, you wreck!|r")
    else
        p.message("|c00FF8080" + joke + "|r")

@noinline
function flag()
    let abil = GetSpellAbilityId()
    let u = GetTriggerUnit()
    if abil == 'A00A'
        placeFlag(u, 'S000', 0, 30, "Where are you poking?")
    else if abil == 'A00C'
        placeFlag(u, 'S001', 80, 30, "Doesn't stand up? Happens.")
    else if abil == 'A00B'
        placeFlag(u, 'S002', 300, 100, "Do you really need it?")
    else if abil == 'A00D'
        placeFlag(u, 'A00F', 500, 300, "Our flag burned down, the party's over!")
    else if abil == 'A00E'
        placeFlag(u, 'A00G', 1000, 500, "Did I ever tell you what the definition of insanity is?")

// ============================================================
// Триггер: Sell — продажа юнита ('A006' себя, 'A005' цель) или артефакта ('A00H')
// ============================================================

/** Продать юнита u игроку p за gold золота (из «силы» power вычитается полный максимум HP) */
function sellUnit(unit u, player p, int gold)
    p.message("|cffffff00You sold a unit for: " + gold + " gold|r")
    p.setGold(p.getGold() + gold)
    power[p.getId()] -= u.getMaxHP().toInt()
    buildUnits.remove(u)
    u.remove()
    addEffect("Abilities\\Spells\\Other\\Transmute\\PileofGold.mdl", u.getPos()).destr()

/** Продать артефакт s игроку p: снова доступен команде в панели артефактов, золото = жизнь·заряды + userData */
function sellArtifact(item s, player p)
    let id = p.getId()
    let sid = s.getTypeId()
    if isDamageArtifact(sid)
        itemZapretD[id] -= 1
    if isStunArtifact(sid)
        itemZapretS[id] -= 1
    returnArtifact(p, sid)
    let charges = max(1, s.getCharges())
    let gold = (charges * s.getLife()).toInt() + s.getUserData()
    p.setGold(p.getGold() + gold)
    p.message("|cffffff00You sold an artifact for: " + gold + " gold|r")
    powerItem[id] -= gold
    s.remove()

/** Продажа строителем ('A005' — юнит-цель, 'A00H' — артефакт) по годной цели */
function canSell(int ab, unit t, item s) returns bool
    return ab == 'A005' ? t != null and t.getAbilityLevel('A006') == 2 : s != null and s.getTypeId() != 'I000'

/** Начало заклинания: негодная цель — приказ отменяется до эффекта, перезарядка не начинается */
@noinline
function sellCheck()
    let ab = GetSpellAbilityId()
    if ab != 'A005' and ab != 'A00H'
        return
    let u = GetSpellAbilityUnit()
    if not canSell(ab, GetSpellTargetUnit(), GetSpellTargetItem())
        u.issueImmediateOrder("stop")
        u.getOwner().message("Impossible!")

/** Эффект заклинания (перезарядка уже пошла — раньше продажа шла на начале каста через 0.4 с, цель исчезала до
    эффекта, каст срывался и перезарядки не было) */
@noinline
function sell()
    let t = GetSpellTargetUnit()
    let u = GetSpellAbilityUnit()
    let s = GetSpellTargetItem()
    let ab = GetSpellAbilityId()
    let p = u.getOwner()
    if not (t.isType(UNIT_TYPE_STRUCTURE) or u.isType(UNIT_TYPE_MECHANICAL) or ab == 'A00H')
        return
    if ab == 'A006'
        if u.getAbilityLevel('A006') == 1
            sellUnit(u, p, u.getMaxHP().toInt())
        else if u.getAbilityLevel('A006') == 2
            sellUnit(u, p, (u.getMaxHP() / 2).toInt())
    else if (ab == 'A005' or ab == 'A00H') and canSell(ab, t, s)
        if ab == 'A005'
            sellUnit(t, p, t.getMaxHP().toInt())
        else
            sellArtifact(s, p)

// ============================================================
// Триггер: ZaminaVzryva — 'A003' «Взрыв»: смерть всем врагам (не героям) в радиусе 300 от точки
// ============================================================

@noinline
function zaminaVzryva()
    let c = GetTriggerUnit()
    let p = c.getOwner()
    let target = EventData.getSpellTargetPos()
    addEffect("Units\\NightElf\\Wisp\\WispExplode.mdl", target).destr()
    forUnitsInRange(target, 300.0) u ->
        if u.isEnemyOf(p) and u.getAbilityLevel('Avul') != 1 and not u.isType(UNIT_TYPE_HERO)
            addEffect("Abilities\\Spells\\Demon\\DemonBoltImpact\\DemonBoltImpact.mdl", u.getPos()).destr()
            c.damageTarget(u, 100000.0, true, false, ATTACK_TYPE_NORMAL, DAMAGE_TYPE_NORMAL, WEAPON_TYPE_WHOKNOWS)
    boom[p.getId()] = false
    c.removeAbility('A003')
    c.addAbility('A004')
    printAll(p.coloredName() + "|cffff80ff used \"Blast\"!|r")

// ============================================================
// Триггер: SpeedBuild — 'A002': на 2 секунды носитель предмета 'I01Q' (ускорение стройки)
// ============================================================

@noinline
function speedBuild()
    let c = GetTriggerUnit()
    let holder = createUnit(c.getOwner(), 'e00Y', c.getPos())
    holder.addItemHandle(createItem('I01Q', holder.getPos()))
    holder.setTimedLife(2.0, 'BHwe')

// ============================================================
// Триггер: StopBuild — 'A001': союзные гиганты в радиусе 1000 стоят 5 секунд
// ============================================================

@noinline
function stopBuild()
    let c = GetTriggerUnit()
    let p = c.getOwner()
    forUnitsInRange(c.getPos(), 1000.0) u ->
        if u.isAllyOf(p) and u.isType(UNIT_TYPE_GIANT)
            u.setMoveSpeed(1.0)
            doAfter(5.0) ->
                u.setMoveSpeed(u.getDefaultMovespeed())

init
    EventListener.add(EVENT_PLAYER_UNIT_SELECTED) ->
        controlAdd()
    EventListener.add(EVENT_PLAYER_UNIT_SPELL_CAST) ->
        flag()
        sellCheck()
    EventListener.add(EVENT_PLAYER_UNIT_SPELL_EFFECT) ->
        sell()
    EventListener.onCast('A00I') (_caster) ->
        repick()
    EventListener.onCast('A003') (_caster) ->
        zaminaVzryva()
    EventListener.onCast('A002') (_caster) ->
        speedBuild()
    EventListener.onCast('A001') (_caster) ->
        stopBuild()
