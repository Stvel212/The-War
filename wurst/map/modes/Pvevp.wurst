package Pvevp
import GameMode
import CreepWaves
import Initialization
import MapGlobals
import ClosureTimers
import ClosureForGroups
import GameTimer

/*
    PvEvP — «LTD» (по образцу Just Fight 5.6, «Battle Chess (PvEvP)»). Команды против друг друга, но армии игроков
    не встречаются: каждый держит свою половину линии (GameMode: HOLD_LEFT_X / HOLD_RIGHT_X), команды друг для
    друга «пассивны». На каждую волну каждому игроку из центра его линии идут одинаковые монстры (CreepWaves):
    против левых — слот CREEP_VS_LEFT (союзник правых), против правых — CREEP_VS_RIGHT.
    - Следующая волна — только когда монстры обеих команд перебиты (или прошло WAVE_TIMEOUT: оставшиеся на линиях
      прорываются к королю), после паузы BREAK_TIME; выжившие бойцы игроков на линиях убираются — каждую волну
      здания выпускают армию заново («шахматы»).
    - Наёмники (Naim) не идут сами, а становятся монстрами против противника на выбранной линии (GameMode.becomeSend).
    - Прорвавшийся монстр идёт по средней линии к королю этой стороны; Стража Короля по-прежнему идёт к чужому королю.
    - Победа — как в PvP: смерть вражеского короля. */

/** До первой волны (постройка) и между волнами, с — как в Just Fight */
constant FIRST_WAVE_DELAY = 50.
constant BREAK_TIME = 20.
/** Стартовое золото сверх обычного (Just Fight: +2100 на «доску») */
constant START_GOLD = 2100
/** Каждая волна — монстры таблицы три раза (через 0, 2 и 4 с) */
constant BATCHES = 3
constant BATCH_DELAY = 2.
/** Пока идёт появление, волну не завершать */
constant MIN_WAVE_TIME = 10.
/** Волна дольше этого — оставшиеся на линиях монстры прорываются, волна закончена */
constant WAVE_TIMEOUT = 100.

var waveActive = false
var waveStartedAt = 0.
var waveNumber = 0
/** Таблица волн Just Fight следующей волны: 1 или 2, заново на каждую волну */
var waveTable = 1

function printAll(string msg, real duration)
    if bj_FORCE_ALL_PLAYERS.containsPlayer(localPlayer)
        localPlayer.print(msg, duration)

public function startPvevp()
    gameMode = GameModeKind.PVEVP
    manualRounds = true
    waveTable = GetRandomInt(1, 2)
    updateBoardTitle()
    let vsLeft = players[CREEP_VS_LEFT]
    let vsRight = players[CREEP_VS_RIGHT]
    vsLeft.setName("|cffff0000Monsters|r")
    vsRight.setName("|cffff0000Monsters|r")
    vsLeft.setColor(PLAYER_COLOR_BLACK_AGGRESSIVE)
    vsRight.setColor(PLAYER_COLOR_BLACK_AGGRESSIVE)
    // армии команд друг друга не трогают (короли и их стража — враги, как в PvP)
    for a = 0 to 3
        for b = 4 to 7
            setAllied(players[a], players[b], false)
    // монстры против левых — союзники правых и наоборот; друг друга не трогают
    setAllied(vsLeft, vsRight, false)
    for i = 0 to 9
        let right = i >= 4 and i != 8
        setAllied(right ? vsLeft : vsRight, players[i], false)
        // и явно враги своей цели: союзы по силам карты не должны остаться
        setEnemies(right ? vsRight : vsLeft, players[i])
    // порталы, из которых выходят монстры, — на половине каждого игрока (бойцы через них не ходят: держат линию)
    for pid = 0 to 7
        if players[pid].isIngame()
            addLanePortal(pid, false)
    printAll("|cffff0000Host selected PvEvP (Battle Chess)|r", 15.)
    printAll("|cffffcc00Every wave the same monsters attack each player's half of the lane. Your units hold your half.|r", 15.)
    printAll("|cffffcc00The next wave comes only when both teams have cleared their monsters. Survivors are removed - buildings send a new army every wave.|r", 15.)
    printAll("|cffffcc00Mercenaries join the monsters attacking the enemy. Monsters that break through go to the King!|r", 15.)

function startTimer(real time, string title)
    roundTimer.start(time, null)
    timerD = CreateTimerDialog(roundTimer)
        ..setTitle(title)
        ..display(true)

function announceNext()
    if waveExists(waveTable, waveNumber + 1)
        printAll("Next wave: [" + (waveNumber + 1) + "]    Unit: [" + waveDescription(waveTable, waveNumber + 1, BATCHES) + "]", 15.)

@noinline
function onRoundStart(int r)
    if not isPvevp()
        return
    if r == 1
        for pid = 0 to 7
            if isInGame(players[pid])
                players[pid].addGold(START_GOLD)
        startTimer(FIRST_WAVE_DELAY, "Wave 1")
        announceNext()
        return
    waveNumber = r - 1
    waveActive = true
    waveStartedAt = getElapsedGameTime()
    let t = waveTable
    let w = waveNumber
    for batch = 0 to BATCHES - 1
        doAfter(batch * BATCH_DELAY) ->
            for pid = 0 to 7
                if isInGame(players[pid])
                    let left = pid < 4
                    spawnTableWave(t, w, players[left ? CREEP_VS_LEFT : CREEP_VS_RIGHT], pid mod 4, left)
    printAll("|cffff00ffRound:|r |cffff0000" + w + "|r |cffff00ffstarted!|r", 10.)

/** Награда за волну (Just Fight: 300 + (волна - 2)·9, с 69-й — 900) */
function waveReward(int w) returns int
    return w <= 68 ? 300 + (w - 2) * 9 : 900

@noinline
function endWave()
    waveActive = false
    forUnitsAll() u ->
        if u.isAlive() and u.isCreep() and not isMidLane(u.getY())
            creepBreakthrough(u)
        else if u.isLaneFighter()
            u.recallFighter()
    let gold = waveReward(waveNumber)
    for pid = 0 to 7
        if isInGame(players[pid])
            players[pid].addGold(gold)
            DisplayTextToPlayer(players[pid], 0., 0., "Round Rewards: |cffffff00" + gold + " gold!|r")
    printAll("|cffffcc00End of the Round!|r Next wave in " + BREAK_TIME.toInt() + " seconds.", 8.)
    waveTable = GetRandomInt(1, 2)
    startTimer(BREAK_TIME, "Wave: " + (waveNumber + 1))
    doAfter(3.) ->
        announceNext()

/** Монстры волны на линиях (прорвавшиеся к королю на средней линии волну не держат) */
function creepsOnLanes() returns int
    return creepsOnLanes(players[CREEP_VS_LEFT]) + creepsOnLanes(players[CREEP_VS_RIGHT])

function creepsOnLanes(player owner) returns int
    var n = 0
    let g = CreateGroup()
    g.enumUnitsOfPlayer(owner, null)
    for u from g
        if u.isAlive() and not isMidLane(u.getY())
            n++
    g.destr()
    return n

/** Волна закончена: монстров на линиях не осталось ни у одной команды (или вышло время) */
@noinline
function checkWave()
    if not isPvevp() or not waveActive
        return
    let elapsed = getElapsedGameTime() - waveStartedAt
    // монстры появляются порциями несколько секунд, наёмники — через 1 с
    if elapsed < MIN_WAVE_TIME
        return
    if elapsed >= WAVE_TIMEOUT or creepsOnLanes() == 0
        endWave()

init
    onRound() r ->
        onRoundStart(r)
    doPeriodically(1.) cb ->
        checkWave()
