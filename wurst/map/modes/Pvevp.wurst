package Pvevp
import GameMode
import CreepWaves
import Initialization
import MapGlobals
import ClosureTimers
import ClosureForGroups
import ClosureEvents
import Dummies
import GameTimer
import Messages
import PveJfTriggers

/*
    PvEvP — «LTD» (по образцу Just Fight 5.6, «Battle Chess (PvEvP)»). Команды против друг друга, но армии игроков
    не встречаются: каждый воюет на своей половине линии, команды друг для друга «пассивны».
    На каждую волну каждому игроку из центра его линии идут одинаковые монстры (CreepWaves):
    против левых — слот CREEP_VS_LEFT (союзник правых), против правых — CREEP_VS_RIGHT.
    - Следующая волна — только когда убиты все монстры обеих команд (и на линиях, и прорвавшиеся к королям), после
      паузы BREAK_TIME; выжившие бойцы игроков убираются — каждую волну здания выпускают армию заново («шахматы»).
    - Наёмники (Naim) не идут сами, а становятся монстрами против противника на выбранной линии (GameMode.becomeSend).
    - Боец, дошедший до портала в конце своей половины, переносится к своему королю и стоит перед ним (GameMode:
      DEFEND_LEFT_X / DEFEND_RIGHT_X; "Soldiers who break through will protect the War God"); прорвавшийся монстр
      выходит на среднюю линию (MID_HOLD_LEFT_X / MID_HOLD_RIGHT_X) и идёт к королю своей стороны. Стражи Короля нет;
      юниты Алтаря Вызова идут к чужому королю, как в PvP.
    - Победа — как в PvP: смерть вражеского короля. */

/** До первой волны (постройка) и между волнами, с — как в Just Fight */
constant FIRST_WAVE_DELAY = 50.
constant BREAK_TIME = 20.
/** Стартовое золото сверх обычного (Just Fight: +2100 на «доску») */
constant START_GOLD = 2100
/** Каждая волна — монстры таблицы три раза (через 0, 2 и 4 с) */
constant BATCHES = 3
constant BATCH_DELAY = 2.
/** Пока идёт появление, волну не завершать */
constant MIN_WAVE_TIME = 10.

var waveActive = false
var waveStartedAt = 0.
var waveNumber = 0
/** Таблица волн Just Fight следующей волны: 1 или 2, заново на каждую волну */
var waveTable = 1

public function startPvevp()
    gameMode = GameModeKind.PVEVP
    jfRegisterTriggers()
    manualRounds = true
    waveTable = GetRandomInt(1, 2)
    updateBoardTitle()
    let vsLeft = players[CREEP_VS_LEFT]
    let vsRight = players[CREEP_VS_RIGHT]
    vsLeft.setName("|cffff0000Monsters|r")
    vsRight.setName("|cffff0000Monsters|r")
    vsLeft.setColor(PLAYER_COLOR_BLACK_AGGRESSIVE)
    vsRight.setColor(PLAYER_COLOR_BLACK_AGGRESSIVE)
    // армии команд друг друга не трогают (короли и их стража — враги, как в PvP)
    for a = 0 to 3
        for b = 4 to 7
            setAllied(players[a], players[b], false)
    // монстры против левых — союзники правых и наоборот; друг друга не трогают
    setAllied(vsLeft, vsRight, false)
    for i = 0 to 9
        let right = i >= 4 and i != 8
        setAllied(right ? vsLeft : vsRight, players[i], false)
        // и явно враги своей цели: союзы по силам карты не должны остаться
        setEnemies(right ? vsRight : vsLeft, players[i])
    // порталы, из которых выходят монстры, — на половине каждого игрока; бойцы, дойдя, переносятся к своему королю
    for pid = 0 to 7
        if players[pid].isIngame()
            addLanePortal(pid, true)
    // средняя линия (оба короля и их защитники) открыта всем — как в Just Fight (Battle Chess: обзор поля у королей)
    let world = GetWorldBounds()
    let mid = Rect(world.getMinX(), MID_LOW_Y - 300., world.getMaxX(), MID_HIGH_Y + 300.)
    for pid = 0 to 7
        if players[pid].isIngame()
            createFogModifier(players[pid], FOG_OF_WAR_VISIBLE, mid, true, false).start()
    mid.remove()
    world.remove()
    print("|cffff0000Host selected PvEvP (Battle Chess)|r", 15.)
    print("|cffffcc00Every wave the same monsters attack each player's half of the lane. Units that reach the portal defend your King.|r", 15.)
    print("|cffffcc00The next wave comes only when both teams have cleared their monsters. Survivors are removed - buildings send a new army every wave.|r", 15.)
    print("|cffffcc00Mercenaries join the monsters attacking the enemy. Monsters that break through go to the King!|r", 15.)

function startTimer(real time, string title)
    roundTimer.start(time, null)
    timerD = roundTimer.createTimerDialog()
        ..setTitle(title)
        ..display(true)

function announceNext()
    if waveExists(waveTable, waveNumber + 1)
        print("Next wave: [" + (waveNumber + 1) + "]    Unit: [" + waveDescription(waveTable, waveNumber + 1, BATCHES) + "]", 15.)

@noinline
function onRoundStart(int r)
    if not isPvevp()
        return
    if r == 1
        for pid = 0 to 7
            if isInGame(players[pid])
                players[pid].addGold(START_GOLD)
        startTimer(FIRST_WAVE_DELAY, "Wave 1")
        announceNext()
        return
    waveNumber = r - 1
    waveActive = true
    waveStartedAt = getElapsedGameTime()
    let t = waveTable
    let w = waveNumber
    for batch = 0 to BATCHES - 1
        doAfter(batch * BATCH_DELAY) ->
            for pid = 0 to 7
                if isInGame(players[pid])
                    let left = pid < 4
                    spawnTableWave(t, w, players[left ? CREEP_VS_LEFT : CREEP_VS_RIGHT], pid mod 4, left)
    print("|cffff00ffRound:|r |cffff0000" + w + "|r |cffff00ffstarted!|r", 10.)

/** Награда за волну (Just Fight: 300 + (волна - 2)·9, с 69-й — 900) */
function waveReward(int w) returns int
    return w <= 68 ? 300 + (w - 2) * 9 : 900

@noinline
function endWave()
    waveActive = false
    // монстров не осталось: выжившие бойцы на линиях и защитники королей на средней линии уходят
    forUnitsAll() u ->
        if u.isLaneFighter() or u.isMidDefender()
            u.recallFighter()
    removeLeavers()
    let gold = waveReward(waveNumber)
    for pid = 0 to 7
        if isInGame(players[pid])
            players[pid].addGold(gold)
            players[pid].message("Round Rewards: |cffffff00" + gold + " gold!|r")
    print("|cffffcc00End of the Round!|r Next wave in " + BREAK_TIME.toInt() + " seconds.", 8.)
    waveTable = GetRandomInt(1, 2)
    startTimer(BREAK_TIME, "Wave: " + (waveNumber + 1))
    doAfter(3.) ->
        announceNext()

/** Живые монстры обеих команд — на линиях и прорвавшиеся к королям (без саранчи 'Aloc' и даммиков) */
function creepsAlive() returns int
    return creepsAlive(players[CREEP_VS_LEFT]) + creepsAlive(players[CREEP_VS_RIGHT])

function creepsAlive(player owner) returns int
    var n = 0
    let g = CreateGroup()
    g.enumUnitsOfPlayer(owner, null)
    for u from g
        if u.isAlive() and u.getAbilityLevel('Aloc') == 0 and not u.isDummy() and not u.onLeaverLane()
            n++
    g.destr()
    return n

/** Волна закончена: убиты все монстры обеих команд, включая прорвавшихся к королям */
@noinline
function checkWave()
    if not isPvevp() or not waveActive
        return
    let elapsed = getElapsedGameTime() - waveStartedAt
    // монстры появляются порциями несколько секунд, наёмники — через 1 с
    if elapsed < MIN_WAVE_TIME
        return
    if creepsAlive() == 0
        endWave()

/** Вышедшие игроки (их юниты убираются в конце волны) */
bool array leaver

/** Монстр на половине линии вышедшего игрока: волну не держит (воевать с ним уже может быть некому) */
function unit.onLeaverLane() returns bool
    return not isMidLane(this.getY()) and leaver[this.creepTargetPlayer()]

/** Игрок вышел: до конца волны его армия воюет (управление у команды), в конце волны — или сразу, если волны
    нет, — убирается всё его (кроме королей) и монстры его половины линии */
@noinline
function playerLeft(player p)
    if not isPvevp() or p.getId() > 7
        return
    leaver[p.getId()] = true
    if not waveActive
        removeLeavers()

function removeLeavers()
    forUnitsAll() u ->
        let id = u.getOwner().getId()
        if id < 8 and leaver[id] and u != kings[1] and u != kings[2]
            buildUnits.remove(u)
            u.remove()
        else if u.isCreep() and u.onLeaverLane()
            u.remove()

init
    EventListener.add(EVENT_PLAYER_LEAVE) ->
        playerLeft(GetTriggerPlayer())
    onRound() r ->
        onRoundStart(r)
    doPeriodically(1.) cb ->
        checkWave()
