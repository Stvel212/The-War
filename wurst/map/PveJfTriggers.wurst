// Триггер Just Fight: Tauren Chieftain ('oJ5A') — его атакуют
// ============================================================

@noinline
function taurenChieftainAttacked()
    let target = GetTriggerUnit()
    if target.getAbilityLevel('AJ74') == 1
        return
    if target.getHP() / target.getMaxHP() <= 0.3
        target.addAbility('AJ8A')
        target.addAbility('AJ74')
        doAfter(3.0) ->
            target.removeAbility('AJ8A')
        let pos = target.getPos()
        flashEffect("Abilities\\Spells\\Items\\TomeOfRetraining\\TomeOfRetrainingCaster.mdl", pos)

