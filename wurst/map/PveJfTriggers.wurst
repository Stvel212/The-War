// ============================================================
// Триггер Just Fight: Orc Brute ('oJ4Z') — наносит урон
// ============================================================

@noinline
function orcBruteDamage()
    let source = GetEventDamageSource()
    var value = source.getHP() / source.getMaxHP()
    value = 1.0 - value
    value = 100.0 * value
    bountyGold = value.toInt() div 10
    bountyGold = bountyGold + 1
    if source.getAbilityLevel('AJ54') != bountyGold
        source.setAbilityLevel('AJ54', bountyGold)

