// ============================================================
// Триггер Just Fight: Furbolg Fighter (способность 'AJ3X') — атака
// ============================================================

@noinline
function furbolgFighterAttack()
    let a = GetAttacker()
    let target = GetTriggerUnit()
    if a.getAbilityLevel('AJ3X') < 1
        return
    if a.getAbilityLevel('AJ3X') >= 1 and a.getAbilityLevel('AJ3X') <= 20
        a.incAbilityLevel('AJ3X')
        if a.getAbilityLevel('AJ3X') == 10
            addEffect("Abilities\\Spells\\Orc\\TrollBerserk\\HeadhunterWEAPONSRight.mdl", a, "overhead")
    if GetRandomInt(1, 10) == 2
        let pos = target.getPos()
        doAfter(0.2) ->
            if not a.isType(UNIT_TYPE_DEAD) and a.getHP() > 0.405
                a.damageTarget(target, 100.0, true, false, ATTACK_TYPE_MELEE, DAMAGE_TYPE_NORMAL, WEAPON_TYPE_WHOKNOWS)
                flashEffect("Abilities\\Spells\\Orc\\WarStomp\\WarStompCaster.mdl", pos)

