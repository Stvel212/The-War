// ============================================================
// Триггер Just Fight: Cavalryman ('hJ1I') — наносит урон
// ============================================================

@noinline
function cavalrymanDamage()
    let source = GetEventDamageSource()
    if GetRandomInt(1, 10) <= 3
        if source.getAbilityLevel('AJ76') != 1
            source.addAbility('AJ76')
            source.addAbility('AJ6Q')
            let pos = source.getPos()
            flashEffect("Abilities\\Spells\\Other\\Incinerate\\FireLordDeathExplode.mdl", pos)
            jfDestroyEffectLater(2.0, addEffect("Abilities\\Spells\\Orc\\Bloodlust\\BloodlustTarget.mdl", source, "weapon"))
            doAfter(2.0) ->
                if source.getHP() >= 1.0
                    source.removeAbility('AJ76')
                    source.removeAbility('AJ6Q')

// ============================================================
// Триггер Just Fight: 'oJ59', Tauren Chieftain ('oJ5A') — атакует
// ============================================================

@noinline
function jfAttackoJ59()
    let a = GetAttacker()
    let target = GetTriggerUnit()
    if GetRandomInt(1, 4) == 1
        let pos = target.getPos()
        var g = unitsInRange(250.0, pos, Condition(function jfAttackoJ59Filter))
        g = jfRandomSubGroup(3, g)
        if a.getTypeId() == 'oJ59'
            a.setAnimation("attack slam")
            for u in g
                let u2 = u
                doAfter(0.46) ->
                    if not a.isType(UNIT_TYPE_DEAD) and a.getHP() > 0.405
                        a.damageTarget(u2, 40.0, true, false, ATTACK_TYPE_NORMAL, DAMAGE_TYPE_ENHANCED, WEAPON_TYPE_WHOKNOWS)
        else
            a.setAnimation("attack slam")
            for u3 in g
                let pos2 = target.getPos()
                let u4 = u3
                doAfter(0.46) ->
                    if not a.isType(UNIT_TYPE_DEAD) and a.getHP() > 0.405
                        a.damageTarget(u4, 80.0, true, false, ATTACK_TYPE_NORMAL, DAMAGE_TYPE_ENHANCED, WEAPON_TYPE_WHOKNOWS)
                        flashEffect("Abilities\\Spells\\Human\\Thunderclap\\ThunderClapCaster.mdl", pos2)

function jfAttackoJ59Filter() returns bool
    return GetFilterUnit().isEnemyOf(GetAttacker().getOwner()) and not GetFilterUnit().isType(UNIT_TYPE_DEAD) and GetFilterUnit().getHP() > 0.405 and GetFilterUnit().getAbilityLevel('Avul') == 0

