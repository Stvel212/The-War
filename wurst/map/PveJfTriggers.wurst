@noinline
function jfDeatheJ6P()
    let dying = GetDyingUnit()
    let pos = dying.getPos()
    if GetRandomInt(1, 2) == 1
        createUnit(dying.getOwner(), 'nJ78', pos, GetUnitFacing(dying).fromDeg())
    else
        jfCreateUnits(2, 'nJ78', dying.getOwner(), pos, GetUnitFacing(dying))
    dying.remove()

