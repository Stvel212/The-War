// ============================================================
// Триггер Just Fight: 'oJ53', Elite Raider ('oJ54') — атакует
// ============================================================

@noinline
function jfAttackoJ53()
    let a = GetAttacker()
    let target = GetTriggerUnit()
    if a.getAbilityLevel('AJ56') != 1
        return
    if GetRandomInt(1, 10) <= 3
        a.removeAbility('AJ56')
        if a.getTypeId() == 'oJ53'
            a.getOwner().addGold(3)
            target.getOwner().addGold(-3)
            attackUpgradeCounter[a.getOwner().getId() + 1] = attackUpgradeCounter[a.getOwner().getId() + 1] + 3
            DisplayTextToPlayer(a.getOwner(), 0, 0, "|cff80ff00Raider:|r |cffffff00Boss, I've got 3 gold for you!|r")
        else
            a.getOwner().addGold(5)
            target.getOwner().addGold(-5)
            attackUpgradeCounter[a.getOwner().getId() + 1] = attackUpgradeCounter[a.getOwner().getId() + 1] + 5
            DisplayTextToPlayer(a.getOwner(), 0, 0, "|cff80ff00Elite Raider:|r |cffffff00Boss, I've got 5 gold for you!|r")

