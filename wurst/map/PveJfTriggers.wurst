package PveJfTriggers
import PveJfSupport
import UnitEvents
import ClosureEvents
import ClosureTimers
import Preloader
// Триггеры юнитов Just Fight 5.6.2 (war3map.j) для копий юнитов Just Fight (UnitsPveJf): способности, которые
// в Just Fight делает скрипт карты. Сгенерировано tools/jf/gen_pve_waves.sh (PortJfTriggers.java, JassToWurst.java);
// руками не править. Каждый триггер — функция с условием в начале, подписка в jfRegisterTriggers
// (UnitEvents, EventListener.onCast, onUnitEnter) — её вызывают старты PvE и PvEvP.

unit jfLastUnit = null
int array jfI111
int array upgradeNJ4B
unit array playerHero
hashtable jfL = InitHashtable()
int array upgradeNJ3E
int array upgradeEJ0C
int array upgradeOJ54
int array upgradeAir
int bountyGold = 0
unit jfLLIlII = null
unit jfLLIlLI = null
int array jfLLllI
int array unitTypeByPointValue
force array jflII1
int array attackUpgradeCounter
int array upgradeAir2
int array summonUpgrade
int bountyUnitType = 0
int array upgradeNJ44
bool kingKongDamageRunning = false
bool kingKongKillRunning = false
bool trollBerserkerDamageRunning = false
bool jfDamagenJ2MRunning = false
bool snapDragonGreenDamageRunning = false
bool jfDamagenJ2PRunning = false
bool infernalStoneAttackedRunning = false
bool underworldBlackDragonDeathRunning = false
bool goblinEngineerDamageRunning = false
bool explodingBloatbatDamageRunning = false
bool underworldBlackDragonDamageRunning = false

function unitsInRange(real value, vec2 pos, boolexpr filter) returns group
    let g = CreateGroup()
    g.enumUnitsInRange(pos, value, filter)
    filter.destr()
    return g

function forceOfPlayer(player p) returns force
    let players = CreateForce()
    ForceAddPlayer(players, p)
    return players

function unitWoodCost(int n) returns int
    if IsHeroUnitId(n)
        return 100
    return GetUnitWoodCost(n)

// ============================================================
// Триггер Just Fight: King Kong ('oJ5K') — наносит урон
// ============================================================

@noinline
function kingKongDamage()
    let source = GetEventDamageSource()
    let target = GetTriggerUnit()
    if kingKongDamageRunning
        return
    if target.isType(UNIT_TYPE_HERO)
        return
    kingKongDamageRunning = true
    if source.getHP() / source.getMaxHP() <= 0.38
        bountyGold = 5
    else
        bountyGold = 3
    if GetRandomInt(1, 100) <= bountyGold
        source.damageTarget(target, 10000.0, true, false, ATTACK_TYPE_CHAOS, DAMAGE_TYPE_ENHANCED, WEAPON_TYPE_WHOKNOWS)
        var pos = target.getPos()
        flashEffect("Abilities\\Spells\\Other\\Volcano\\VolcanoDeath.mdl", pos)
        pos = source.getPos()
        let tag = jfTextTag("Bingo！", pos, 0, 10.0, 75.0, 75.0, 75.0, 0)
        var n = 0
        var value = 10.0
        doPeriodically(0.01) cb ->
            n = n + 1
            if n <= 21
                value = value + 0.5
                SetTextTagTextBJ(tag, "Bingo!", value)
            else if n <= 41
                value = value - 0.5
                SetTextTagTextBJ(tag, "Bingo!", value)
            else
                destroy cb
        tag.jfSetVelocity(64, 90)
        tag.setPermanent(false)
        tag.setLifespan(5.0)
        tag.setFadepoint(2.0)
    kingKongDamageRunning = false

// ============================================================
// Триггер Just Fight: King Kong ('oJ5K') — убивает
// ============================================================

@noinline
function kingKongKill()
    let dying = GetDyingUnit()
    let killer = GetKillingUnit()
    if kingKongKillRunning
        return
    kingKongKillRunning = true
    let pos = killer.getPos()
    killer.setHP(killer.getHP() + dying.getMaxHP() * 0.1)
    flashEffect("Abilities\\Spells\\Human\\Heal\\HealTarget.mdl", pos)
    kingKongKillRunning = false

// ============================================================
// Триггер Just Fight: Paladin ('hJ26') — наносит урон
// ============================================================

@noinline
function paladinDamage()
    let source = GetEventDamageSource()
    if source.getMana().toInt() != 60
        return
    let pos = source.getPos()
    var g = unitsInRange(500.0, pos, Condition(function paladinDamageFilter))
    g = jfRandomSubGroup(1, g)
    if g.size() > 0
        for u in g
            source.issueTargetOrder("holybolt", u)
    g.destr()

function paladinDamageFilter() returns bool
    return GetFilterUnit().isAllyOf(GetEventDamageSource().getOwner()) and GetFilterUnit().isAlive() and GetFilterUnit().getMaxHP() - GetFilterUnit().getHP() >= 600.0

// ============================================================
// Триггер Just Fight: Paladin ('hJ26') — получает урон
// ============================================================

@noinline
function paladinDamaged()
    let target = GetTriggerUnit()
    target.issueImmediateOrder("divineshield")

// ============================================================
// Триггер Just Fight: Soul Eater Banshee ('uJ69') — атакует
// ============================================================

@noinline
function soulEaterBansheeAttack()
    let a = GetAttacker()
    a.issueImmediateOrder("waterelemental")

// ============================================================
// Триггер Just Fight: Soul Eater Banshee (способность 'AJ6E') — применяет способность
// ============================================================

@noinline
function soulEaterBansheeCast(unit caster)
    let pos = caster.getPos()
    var g = unitsInRange(700.0, pos, Condition(function soulEaterBansheeCastFilter))
    g = jfRandomSubGroup(2, g)
    if g.size() > 0
        for u in g
            let u2 = createUnit(caster.getOwner(), 'eJ6O', pos, bj_UNIT_FACING.fromDeg())
            u2.setTimedLife(8.0, 'BHwe')
            u2.addAbility('AJ8C')
            u2.issueTargetOrder("possession", u)
    g.destr()
    caster.remove()

function soulEaterBansheeCastFilter() returns bool
    return not GetFilterUnit().isAllyOf(GetTriggerUnit().getOwner()) and GetFilterUnit().isAlive() and GetFilterUnit().isType(UNIT_TYPE_GIANT) and GetFilterUnit().getAbilityLevel('Avul') == 0 and GetFilterUnit().getMaxMana() == 0.0 and GetFilterUnit().getAbilityLevel('AJ6I') == 0

// ============================================================
// Триггер Just Fight: 'AJ8C' — применяет способность
// ============================================================

@noinline
function jfCastAJ8C()
    let u = GetSpellTargetUnit()
    doAfter(1.0) ->
        jfAttackLane(u)

// ============================================================
// Триггер Just Fight: Priestess of the Moon ('eJ0K') — наносит урон
// ============================================================

@noinline
function priestessOfTheMoonDamage()
    let source = GetEventDamageSource()
    let target = GetTriggerUnit()
    if source.getMana().toInt() != 60
        return
    source.setMana(0)
    jfDestroyEffectLater(1.8, addEffect("Abilities\\Spells\\NightElf\\Starfall\\StarfallCaster.mdl", source, "origin"))
    var pos = target.getPos()
    let g = unitsInRange(200.0, pos, Condition(function priestessOfTheMoonDamageFilter))
    for u in g
        pos = u.getPos()
        let u2 = createUnit(source.getOwner(), 'eJ6L', pos, bj_UNIT_FACING.fromDeg())
        u2.addAbility('AJ8R')
        u2.issueTargetOrder("thunderbolt", u)
        u2.setTimedLife(2.0, 'BHwe')
    g.destr()

function priestessOfTheMoonDamageFilter() returns bool
    return not GetFilterUnit().isAllyOf(GetEventDamageSource().getOwner()) and GetFilterUnit().isAlive() and GetFilterUnit().getAbilityLevel('Avul') == 0

// ============================================================
// Триггер Just Fight: Shrimp Queen ('nJ4C') — появляется
// ============================================================

@noinline
function shrimpQueenEnter()
    let entering = GetTriggerUnit()
    if entering.getTypeId() != 'nJ4C'
        return
    doPeriodically(12.0) cb ->
        if entering.isAlive()
            let pos = entering.getPos()
            let pos2 = pos.polarOffset((GetUnitFacing(entering) + 180.0).fromDeg(), 130.0)
            let u = createUnit(entering.getOwner(), 'eJ6P', pos2, GetUnitFacing(entering).fromDeg())
            u.setTimedLife(5.0, 'BHwe')
        else
            destroy cb

// ============================================================
// Триггер Just Fight: Archimonde (способность 'AJ4F') — урон
// ============================================================

@noinline
function archimondeDamage()
    let source = GetEventDamageSource()
    let target = GetTriggerUnit()
    if source.getAbilityLevel('AJ4F') <= 0 or source.getMana().toInt() < 40
        return
    let pos = target.getPos()
    source.issuePointOrder("rainofchaos", pos)

// ============================================================
// Триггер Just Fight: 'BJ0Q' — смерть
// ============================================================

@noinline
function jfDeathBJ0Q()
    let dying = GetDyingUnit()
    let killer = GetKillingUnit()
    if dying.isType(UNIT_TYPE_TAUREN) or not dying.isType(UNIT_TYPE_GIANT) or not killer.hasAbility('BJ0Q') or dying.isType(UNIT_TYPE_SUMMONED) or dying.isIllusion()
        return
    bountyUnitType = dying.getTypeId()
    bounty()
    bountyGold = bountyGold div 2
    let tag = jfTextTag("+" + bountyGold, killer, 0, 10, 100, 78.43, 0.0, 0)
    killer.getOwner().addGold(bountyGold)
    tag.jfSetVelocity(64.0, 90)
    tag.setVisibility(false)
    let players = forceOfPlayer(killer.getOwner())
    tag.jfShowForce(true, players)
    players.destr()
    tag.setPermanent(false)
    tag.setLifespan(2.0)
    tag.setFadepoint(1.0)
    flashEffect("Abilities\\Spells\\Items\\ResourceItems\\ResourceEffectTarget.mdl", killer, "chest")

