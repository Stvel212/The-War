// ============================================================
// Триггер Just Fight: 'nJ2P', Elite Wind Serpent ('nJ2Q') — наносит урон
// ============================================================

@noinline
function jfDamagenJ2P()
    let source = GetEventDamageSource()
    let target = GetTriggerUnit()
    if jfDamagenJ2PRunning
        return
    if target.isType(UNIT_TYPE_HERO)
        return
    jfDamagenJ2PRunning = true
    if GetRandomInt(1, 100) <= 25
        int n
        if target.getAbilityLevel('A00W') == 0
            if source.getTypeId() == 'nJ2P'
                n = target.getMaxHP().toInt() div 20
            else
                n = target.getMaxHP().toInt() div 15
        else if source.getTypeId() == 'nJ2P'
            n = target.getMaxHP().toInt() div 20
        else
            n = target.getMaxHP().toInt() div 7
        UnitDamageTarget(source, target, n.toReal(), true, true, ATTACK_TYPE_PIERCE, DAMAGE_TYPE_NORMAL, WEAPON_TYPE_WHOKNOWS)
        let pos = target.getPos()
        flashEffect("Abilities\\Spells\\Other\\Cleave\\CleaveDamageTarget.mdl", pos)
        let tag = jfTextTag("+" + n + "！", source, 0, 10, 100, 0.0, 0.0, 0)
        tag.jfSetVelocity(60.0, 90)
        tag.setPermanent(false)
        tag.setLifespan(3.0)
        tag.setFadepoint(2.0)
    jfDamagenJ2PRunning = false

