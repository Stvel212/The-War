// Триггер Just Fight: Spirit Wyvern (способность 'AJ5L') — атака
// ============================================================

@noinline
function spiritWyvernAttack()
    let a = GetAttacker()
    if a.getAbilityLevel('AJ5L') <= 0
        return
    flashEffect("Abilities\\Spells\\Undead\\ReplenishMana\\SpiritTouchTarget.mdl", a, "overhead")
    if a.getAbilityLevel('AJ5L') == 1
        if a.getAbilityLevel('AJ8B') != 1
            a.addAbility('AJ8B')
        doAfter(1.0) ->
            a.removeAbility('AJ8B')
    if a.getAbilityLevel('AJ5L') == 6
        a.setAbilityLevel('AJ5L', 1)
    else
        a.incAbilityLevel('AJ5L')

