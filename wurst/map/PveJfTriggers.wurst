    entering.issueImmediateOrder("manashieldon")

// ============================================================
// Триггер Just Fight: Goblin Zeppelin ('nJ37'), Goblin Flying Fortress ('nJ36') — атакует
// ============================================================

@noinline
function goblinZeppelinAttack()
    let a = GetAttacker()
