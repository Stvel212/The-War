// Триггер Just Fight: King Shrimp ('nJ3U') — убивает
// ============================================================

@noinline
function kingShrimpKill()
    let dying = GetDyingUnit()
    let killer = GetKillingUnit()
    if dying.isType(UNIT_TYPE_HERO) or dying.isType(UNIT_TYPE_SUMMONED)
        return
    let pos = killer.getPos()
    let pos2 = pos.polarOffset((GetUnitFacing(killer) + 180.0).fromDeg(), 130.0)
    killer.setAnimation("spell")
    let u = createUnit(killer.getOwner(), 'eJ6P', pos2, GetUnitFacing(killer).fromDeg())
    u.setTimedLife(5.0, 'BHwe')

