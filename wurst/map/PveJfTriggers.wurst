// ============================================================
// Триггер Just Fight: Machine Gunner ('hJ1V'), Marine ('hJ1W') — атакует
// ============================================================

@noinline
function machineGunnerAttack()
    let a = GetAttacker()
    if a.getHP() <= 1.0
        return
    if a.getHP() / a.getMaxHP() >= 0.7
        if a.getAbilityLevel('AJ21') != 1
            a.addAbility('AJ21')
    else if a.getAbilityLevel('AJ21') == 1
        a.removeAbility('AJ21')

// ============================================================
// Триггер Just Fight: Heavy Infantry ('hJ1Z') — атакует
// ============================================================

@noinline
function heavyInfantryAttack()
    let a = GetAttacker()
    if a.getHP() <= 1.0
        return
    if a.getHP() / a.getMaxHP() >= 0.7
        if a.getAbilityLevel('AJ8K') == 1
            a.removeAbility('AJ8K')
            a.removeAbility('AJ8J')
    else if a.getAbilityLevel('AJ8K') == 0
        a.addAbility('AJ8J')
        a.addAbility('AJ8K')

// ============================================================
// Триггер Just Fight: Goblin Tinker (способность 'AJ25'), Pit Lord (способность 'AJ66') — атака
// ============================================================

@noinline
function goblinTinkerAttack()
    let a = GetAttacker()
    if a.getAbilityLevel('AJ25') <= 0 and a.getAbilityLevel('AJ66') <= 0 or a.getMana() < 60.0
        return
    a.issueImmediateOrder("waterelemental")

// ============================================================
// Триггер Just Fight: Goblin Tinker (способность 'AJ25') — применяет способность
// ============================================================

@noinline
function goblinTinkerCast(unit caster)
    let pos = caster.getPos()
    let u = createUnit(caster.getOwner(), 'eJ6O', pos, bj_UNIT_FACING.fromDeg())
    u.addAbility('AJ6Z')
    if caster.getTypeId() == 'hJ1X'
        doAfter(0.59) ->
            u.removeAbility('AJ6Z')
    if caster.getTypeId() == 'hJ1Y'
        doAfter(1.39) ->
            u.removeAbility('AJ6Z')
    u.setTimedLife(3.0, 'BHwe')

