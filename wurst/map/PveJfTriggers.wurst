@noinline
function jfAttackAJ43()
    let a = GetAttacker()
    if a.getAbilityLevel('AJ43') != 1
        return
    a.issueImmediateOrder("stomp")

// ============================================================
// Триггер Just Fight: Naisha the Huntress ('eJ0C') — появляется
// ============================================================

@noinline
function naishaTheHuntressEnter()
    let entering = GetTriggerUnit()
    if entering.getTypeId() != 'eJ0C'
        return
    if upgradeEJ0C[entering.getOwner().getId() + 1] >= 5
        entering.addAbility('AJ7B')
        entering.addAbility('AJ7J')
        addEffect("Abilities\\Spells\\NightElf\\SpiritOfVengeance\\SpiritOfVengeanceBirthMissile.mdl", entering, "weapon")

// ============================================================
// Триггер Just Fight: Living Puppet ('nJ44') — появляется
// ============================================================

@noinline
function livingPuppetEnter()
    let entering = GetTriggerUnit()
    if entering.getTypeId() != 'nJ44' or upgradeNJ44[entering.getOwner().getId() + 1] < 2
        return
    if upgradeNJ44[entering.getOwner().getId() + 1] == 2
        entering.addAbility('AJ8F')
    else if upgradeNJ44[entering.getOwner().getId() + 1] == 3
        entering.addAbility('AJ8G')
    else if upgradeNJ44[entering.getOwner().getId() + 1] == 4
        entering.addAbility('AJ8H')
    else
        entering.addAbility('AJ8I')

// ============================================================
// Триггер Just Fight: Elite Raider ('oJ54') — появляется
// ============================================================

@noinline
function eliteRaiderEnter()
    let entering = GetTriggerUnit()
    if entering.getTypeId() != 'oJ54'
        return
    if upgradeOJ54[entering.getOwner().getId() + 1] >= 3
        entering.addAbility('AJ7H')
        entering.addAbility('AJ7G')
        entering.addAbility('AJ7I')

// ============================================================
// Триггер Just Fight: 'nJ3E' — появляется
// ============================================================

@noinline
function jfEnternJ3E()
    let entering = GetTriggerUnit()
    if entering.getTypeId() != 'nJ3E'
        return
    addEffect("Abilities\\Spells\\Undead\\AbsorbMana\\AbsorbManaBirthMissile.mdl", entering, "weapon,left")
    if upgradeNJ3E[entering.getOwner().getId() + 1] >= 5
        entering.setAbilityLevel('AJ3D', 5)
        entering.setAbilityLevel('AJ3C', 5)
        entering.setAbilityLevel('AJ3E', 5)
    else
        entering.setAbilityLevel('AJ3D', upgradeNJ3E[entering.getOwner().getId() + 1])
        entering.setAbilityLevel('AJ3C', upgradeNJ3E[entering.getOwner().getId() + 1])
        entering.setAbilityLevel('AJ3E', upgradeNJ3E[entering.getOwner().getId() + 1])

// ============================================================
// Триггер Just Fight: Chimera Electricity (способность 'A00W') — появляется
// ============================================================

@noinline
function chimeraElectricityEnter()
    let entering = GetTriggerUnit()
    if entering.getAbilityLevel('A00W') != 1
        return
    if upgradeAir[entering.getOwner().getId() + 1] >= 1
        entering.addAbility('AJ87')
        entering.addAbility('AJ86')
    if upgradeAir2[entering.getOwner().getId() + 1] >= 1
        entering.addAbility('AJ9C')

// ============================================================
// Триггер Just Fight: Sea Elemental ('nJ4B') — появляется
// ============================================================

@noinline
function seaElementalEnter()
    let entering = GetTriggerUnit()
    if entering.getTypeId() != 'nJ4B'
        return
    if ModuloInteger(upgradeNJ4B[entering.getOwner().getId() + 1], 2) > 0
        entering.addAbility('AJ8Q')
        entering.addAbility('AJ8S')
        entering.setVertexColor(255, 0, 0, 255)
    else
        entering.addAbility('AJ75')
        entering.addAbility('AJ79')
        entering.setVertexColor(0, 255, 0, 255)

// ============================================================
// Триггер Just Fight: Troll Berserker ('oJ51'), Elite Troll Headhunter ('oJ52') — атакует
// ============================================================

@noinline
function trollBerserkerAttack()
    let a = GetAttacker()
    if a.getAbilityLevel('AJ7C') != 0 or a.getAbilityLevel('AJ7D') != 0
        return
    if GetRandomInt(1, 4) <= 1
        if a.getTypeId() == 'oJ51'
            a.addAbility('AJ7E')
            a.addAbility('AJ7C')
            a.addAbility('AJ77')
            a.addAbility('AJ88')
            doAfter(5.0) ->
                if a.getHP() >= 1.0
                    a.removeAbility('AJ7E')
                    a.removeAbility('AJ7C')
                    a.removeAbility('AJ88')
                    a.removeAbility('AJ77')
        else
            a.addAbility('AJ7F')
            a.addAbility('AJ7D')
            a.addAbility('AJ77')
            a.addAbility('AJ89')
            doAfter(5.0) ->
                if a.getHP() >= 1.0
                    a.removeAbility('AJ7F')
                    a.removeAbility('AJ7D')
                    a.removeAbility('AJ89')
                    a.removeAbility('AJ77')

// ============================================================
// Триггер Just Fight: Troll Berserker ('oJ51'), Elite Troll Headhunter ('oJ52') — наносит урон
// ============================================================

@noinline
function trollBerserkerDamage()
    let source = GetEventDamageSource()
    let target = GetTriggerUnit()
    if trollBerserkerDamageRunning
        return
    trollBerserkerDamageRunning = true
    if source.getHP() / source.getMaxHP() >= 0.5
        if source.getAbilityLevel('AJ55') == 0
            source.addAbility('AJ55')
        if source.getTypeId() == 'oJ51'
            source.setHP(source.getHP() - 4.0)
            source.damageTarget(target, 4.0, true, false, ATTACK_TYPE_NORMAL, DAMAGE_TYPE_ENHANCED, WEAPON_TYPE_WHOKNOWS)
        else
            source.setHP(source.getHP() - 10.0)
            source.damageTarget(target, 10.0, true, false, ATTACK_TYPE_NORMAL, DAMAGE_TYPE_ENHANCED, WEAPON_TYPE_WHOKNOWS)
    else if source.getAbilityLevel('AJ55') == 1
        source.removeAbility('AJ55')
    trollBerserkerDamageRunning = false

