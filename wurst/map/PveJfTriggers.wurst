// ============================================================
// Триггер Just Fight: Warden (способность 'AJ02') — атака
// ============================================================

@noinline
function wardenAttack()
    let a = GetAttacker()
    if a.getAbilityLevel('AJ02') < 1 or a.getAbilityLevel('AJ02') > 4
        return
    a.incAbilityLevel('AJ02')
    if a.getAbilityLevel('AJ02') == 5
        a.setAbilityLevel('AJ04', 2)
        a.removeAbility('AJ03')

// ============================================================
// Триггер Just Fight: Warden (способность 'AJ02') — смерть
// ============================================================

@noinline
function wardenDeath()
    let killer = GetKillingUnit()
    if killer.getAbilityLevel('AJ02') < 1
        return
    if killer.getAbilityLevel('AJ04') == 2
        killer.setAbilityLevel('AJ04', 1)
        killer.addAbility('AJ03')
    killer.setAbilityLevel('AJ02', 1)
    killer.removeAbility('AJ01')
    killer.addAbility('AJ01')

// ============================================================
// Триггер Just Fight: Void Revenant ('nJ3Z') — атакует
// ============================================================

@noinline
function voidRevenantAttack()
    let a = GetAttacker()
    let target = GetTriggerUnit()
    if target.getHP() > 330.0 or target.isType(UNIT_TYPE_HERO) or target.isType(UNIT_TYPE_STRUCTURE)
        return
    if GetRandomInt(1, 10) <= 4
        force players
        if unitWoodCost(target.getTypeId()) >= 20
            bountyGold = unitWoodCost(target.getTypeId()) div 20
            if bountyGold != 0
                a.getOwner().addGold(bountyGold)
                let tag = jfTextTag("+" + bountyGold, target, 0, 10, 100, 78.43, 0.0, 0)
                tag.jfSetVelocity(64.0, 90)
                tag.setVisibility(false)
                players = forceOfPlayer(a.getOwner())
                tag.jfShowForce(true, players)
                players.destr()
                tag.setPermanent(false)
                tag.setLifespan(2.0)
                tag.setFadepoint(1.0)
        if not target.isType(UNIT_TYPE_SUMMONED) and not target.isIllusion()
            bountyUnitType = target.getTypeId()
            bounty()
            a.getOwner().addGold(bountyGold)
            if bountyGold != 0
                let tag2 = jfTextTag("+" + bountyGold, target, 0, 10, 100, 78.43, 0.0, 0)
                tag2.jfSetVelocity(64.0, 90)
                tag2.setVisibility(false)
                players = forceOfPlayer(a.getOwner())
                tag2.jfShowForce(true, players)
                players.destr()
                tag2.setPermanent(false)
                tag2.setLifespan(2.0)
                tag2.setFadepoint(1.0)
        let pos = target.getPos()
        flashEffect("Abilities\\Spells\\Items\\TomeOfRetraining\\TomeOfRetrainingCaster.mdl", pos)
        target.remove()
        doAfter(0.1) ->
            jfAttackLane(a)

// ============================================================
// Триггер Just Fight: Void Revenant ('nJ3Z') — появляется
// ============================================================

@noinline
function voidRevenantEnter()
    let entering = GetTriggerUnit()
    if entering.getTypeId() != 'nJ3Z'
        return
    entering.setVertexColor((100 * 2.55).toInt(), (100 * 2.55).toInt(), (100 * 2.55).toInt(), 255 - (50.0 * 2.55).toInt())
    addEffect("Abilities\\Weapons\\AvengerMissile\\AvengerMissile.mdl", entering, "weapon")
    addEffect("Abilities\\Weapons\\AvengerMissile\\AvengerMissile.mdl", entering, "left,hand")

// ============================================================
// Триггер Just Fight: Flame Tree Demon ('nJ3I'), Shadow Tree Demon ('nJ77') — наносит урон
// ============================================================

@noinline
function flameTreeDemonDamage()
    let source = GetEventDamageSource()
    let target = GetTriggerUnit()
    let pos = target.getPos()
    let g = jfRandomSubGroup(1, unitsInRange(500.0, pos, Condition(function flameTreeDemonDamageFilter)))
    if g.size() == 1
        if source.getTypeId() == 'nJ3I'
            jfLastUnit = createUnit(source.getOwner(), 'nJ7A', pos, bj_UNIT_FACING.fromDeg())
        else
            jfLastUnit = createUnit(source.getOwner(), 'nJ7B', pos, bj_UNIT_FACING.fromDeg())
        jfLastUnit.setTimedLife(2.0, 'BHwe')
        for u in g
            jfLastUnit.issueTargetOrder("attackonce", u)
    g.destr()

function flameTreeDemonDamageFilter() returns bool
    return GetFilterUnit().isEnemyOf(GetEventDamageSource().getOwner()) and not GetFilterUnit().isType(UNIT_TYPE_DEAD) and GetFilterUnit().getHP() > 0.405 and GetFilterUnit().isType(UNIT_TYPE_GIANT) and GetFilterUnit() != GetTriggerUnit()

// ============================================================
// Триггер Just Fight: Small Panda (способность 'AJ4D') — атака
// ============================================================

@noinline
function smallPandaAttack()
    let a = GetAttacker()
    if a.getAbilityLevel('AJ4D') <= 0 or a.getAbilityLevel('AJ4D') >= 30
        return
    a.incAbilityLevel('AJ4D')
    if a.getAbilityLevel('AJ4D') == 20
        addEffect("Abilities\\Spells\\NightElf\\SpiritOfVengeance\\SpiritOfVengeanceOrbs1.mdl", a, "left,hand")
    if a.getAbilityLevel('AJ4D') == 30
        addEffect("Abilities\\Spells\\NightElf\\SpiritOfVengeance\\SpiritOfVengeanceOrbs1.mdl", a, "right,hand")

// ============================================================
// Триггер Just Fight: Pit Lord ('uJ64'), Pit Lord ('uJ63'), Pit Lord ('uJ7M'), Pit Lord ('uJ7N') — атакует
// ============================================================

@noinline
function pitLordAttack()
    let a = GetAttacker()
    if a.getMana() != 60.0
        return
    a.issueImmediateOrder("waterelemental")

// ============================================================
// Триггер Just Fight: Pit Lord (способность 'AJ66') — применяет способность
// ============================================================

@noinline
function pitLordCast(unit caster)
    let u = caster
    var n = 0
    let pos = caster.getPos()
    doPeriodically(0.1) cb ->
        vec2 pos2
        n = n + 1
        if n == 1
            pos2 = pos.polarOffset(GetUnitFacing(u).fromDeg(), 128.0)
            if u.getTypeId() == 'uJ64' or u.getTypeId() == 'uJ63'
                jfDestroyEffectLater(1.0, addEffect("Units\\Demon\\Infernal\\InfernalBirth.mdl", pos2))
            else
                jfDestroyEffectLater(1.0, addEffect("models\\yunshidabaozha.mdx", pos2))
        if n == 10
            pos2 = pos.polarOffset(GetUnitFacing(u).fromDeg(), 128.0)
            if u.getTypeId() == 'uJ64'
                jfLastUnit = createUnit(u.getOwner(), 'nJ2V', pos2, bj_UNIT_FACING.fromDeg())
            else if u.getTypeId() == 'uJ63'
                jfLastUnit = createUnit(u.getOwner(), 'nJ2Z', pos2, bj_UNIT_FACING.fromDeg())
            else if u.getTypeId() == 'uJ7M'
                jfLastUnit = createUnit(u.getOwner(), 'nJ7C', pos2, bj_UNIT_FACING.fromDeg())
            else if u.getTypeId() == 'uJ7N'
                jfLastUnit = createUnit(u.getOwner(), 'nJ7D', pos2, bj_UNIT_FACING.fromDeg())
            jfLastUnit.setTimedLife(30.0, 'BHwe')
            jfLastUnit = jfDummy(u.getOwner(), pos2)
            jfLastUnit.jfDummyLife(1.0)
            if u.getTypeId() == 'uJ64' or u.getTypeId() == 'uJ7M'
                jfLastUnit.jfDummyAbility('AJ91')
            else
                jfLastUnit.jfDummyAbility('AJ92')
            jfLastUnit.issueImmediateOrder("stomp")
            destroy cb

