@noinline
function snapDragonGreenDamage()
    int n
    let source = GetEventDamageSource()
    let target = GetTriggerUnit()
    if snapDragonGreenDamageRunning
        return
    if target.isType(UNIT_TYPE_HERO)
        return
    snapDragonGreenDamageRunning = true
    if source.getTypeId() == 'nJ2G'
        n = (target.getMaxHP().toInt() - target.getHP().toInt()) div 25
        if n >= 40
            n = 40
    else
        n = (target.getMaxHP().toInt() - target.getHP().toInt()) div 12
        if n >= 90
            n = 90
    UnitDamageTarget(source, target, n.toReal(), true, true, ATTACK_TYPE_MELEE, DAMAGE_TYPE_NORMAL, WEAPON_TYPE_WHOKNOWS)
    let pos = target.getPos()
    flashEffect("Abilities\\Spells\\Other\\CrushingWave\\CrushingWaveDamage.mdl", pos)
    let tag = jfTextTag("+" + n + "！", source, 0, 10, 100, 0.0, 0.0, 0)
    tag.jfSetVelocity(60.0, 90)
    tag.setPermanent(false)
    tag.setLifespan(3.0)
    tag.setFadepoint(2.0)
    snapDragonGreenDamageRunning = false

// ============================================================
// Триггер Just Fight: Naga Myrmidon ('nJ2I'), 'nJ2J' — атакует
// ============================================================

@noinline
function nagaMyrmidonAttack()
    vec2 pos
    let a = GetAttacker()
    if a.getHP() < 1.0
        return
    if a.getTypeId() == 'nJ2I'
        if a.getAbilityLevel('AJ2R') == 7
            pos = a.getPos()
            flashEffect("Abilities\\Spells\\Other\\CrushingWave\\CrushingWaveDamage.mdl", pos)
            a.setHP(a.getHP() + a.getMaxHP() / 10.0)
            a.setAbilityLevel('AJ2R', 1)
        else
            a.incAbilityLevel('AJ2R')
    else if a.getAbilityLevel('AJ2R') == 5
        pos = a.getPos()
        flashEffect("Abilities\\Spells\\Other\\CrushingWave\\CrushingWaveDamage.mdl", pos)
        a.setHP(a.getHP() + a.getMaxHP() / 10.0)
        a.setAbilityLevel('AJ2R', 1)
    else
        a.incAbilityLevel('AJ2R')

// ============================================================
// Триггер Just Fight: Naga Banshee ('nJ76'), 'nJ2M' — наносит урон
// ============================================================

@noinline
function nagaBansheeDamage()
    let source = GetEventDamageSource()
    if source.getMana() != 60.0
        return
    let pos = source.getPos()
    let g = unitsInRange(700.0, pos, Condition(function nagaBansheeDamageFilter))
    if g.size() >= 1
        source.issueTargetOrder("frostarmor", g.getRandom())
        g.destr()

function nagaBansheeDamageFilter() returns bool
    return GetFilterUnit().isAllyOf(GetEventDamageSource().getOwner()) and GetFilterUnit().isType(UNIT_TYPE_GIANT) and GetFilterUnit().isType(UNIT_TYPE_MELEE_ATTACKER) and not GetFilterUnit().isType(UNIT_TYPE_DEAD) and GetFilterUnit().getHP() > 0.405 and not GetFilterUnit().hasAbility('BJ0N')

// ============================================================
// Триггер Just Fight: Naga Banshee (способность 'AJ6R'), 'AJ2V' — применяет способность
// ============================================================

@noinline
function nagaBansheeCast()
    if GetSpellAbilityId() == 'AJ6R'
        if GetSpellTargetUnit().getAbilityLevel('AJ6S') == 0
            GetSpellTargetUnit().addAbility('AJ6S')
            let u = GetSpellTargetUnit()
            doAfter(15.0) ->
                u.removeAbility('AJ6S')
    else if GetSpellTargetUnit().getAbilityLevel('AJ6T') == 0
        GetSpellTargetUnit().addAbility('AJ6T')
        let u2 = GetSpellTargetUnit()
        doAfter(24.0) ->
            u2.removeAbility('AJ6T')

