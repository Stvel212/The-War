// ============================================================
// Триггер Just Fight: Ancient Medusa ('nJ2S') — появляется
// ============================================================

@noinline
function ancientMedusaEnter()
    let entering = GetTriggerUnit()
    if entering.getTypeId() != 'nJ2S'
        return
    let t = CreateTimer()
    SaveUnitHandle(jfL, t.getHandleId(), -1587459251, entering)
    TimerStart(t, 1.0, false, function ancientMedusaEnterHelper)

function ancientMedusaEnterHelper()
    var pos = LoadUnitHandle(jfL, GetExpiredTimer().getHandleId(), -1587459251).getPos()
    let g = unitsInRange(700.0, pos, Condition(function ancientMedusaEnterFilter))
    for u in g
        pos = u.getPos()
        let u2 = jfDummy(u.getOwner(), pos)
        u2.jfDummyAbility('AJ6X')
        u2.jfDummyLife(1.0)
        u2.issueTargetOrder("antimagicshell", u)
    g.destr()
    FlushChildHashtable(jfL, GetExpiredTimer().getHandleId())
    GetExpiredTimer().destr()

function ancientMedusaEnterFilter() returns bool
    return GetFilterUnit().isAllyOf(LoadUnitHandle(jfL, GetExpiredTimer().getHandleId(), -1587459251).getOwner()) and GetFilterUnit().isType(UNIT_TYPE_GIANT) and not GetFilterUnit().isType(UNIT_TYPE_DEAD) and GetFilterUnit().getHP() > 0.405 and not GetFilterUnit().hasAbility('Bams')

