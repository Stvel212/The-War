@noinline
function darkRangerAttack()
    let a = GetAttacker()
    if a.getMana() == 60.0
        if a.getTypeId() == 'hJ20'
            a.addAbility('AJ8L')
        else
            a.addAbility('AJ8M')
        a.setMana(0)
    else if a.getTypeId() == 'hJ20'
        a.removeAbility('AJ8L')
    else
        a.removeAbility('AJ8M')

