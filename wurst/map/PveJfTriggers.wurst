    let dying = GetDyingUnit()
    let killer = GetKillingUnit()
    if dying.isType(UNIT_TYPE_HERO) or dying.isType(UNIT_TYPE_SUMMONED) or dying.isIllusion()
        return
    jfDestroyEffectLater(0.0, addEffect("Abilities\\Spells\\Undead\\AnimateDead\\AnimateDeadTarget.mdl", dying, "origin"))
    let pos = dying.getPos()
    let u = createUnit(killer.getOwner(), jfCopyType(dying), pos, GetUnitFacing(dying).fromDeg())
    u.addAbility('Aloc')
    u.setVertexColor(55, 55, 55, 150)
    if u.getTypeId() == 'eJ05'
        u.setMana(0)
    doAfter(10.0) ->
        u.remove()
    dying.remove()

