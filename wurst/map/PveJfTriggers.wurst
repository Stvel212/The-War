@noinline
function jfDeathuJ68()
    let dying = GetDyingUnit()
    let pos = dying.getPos()
    let g = unitsInRange(500.0, pos, Condition(function jfDeathuJ68Filter))
    var n = g.size()
    n = n * 2
    if n == 0
        n = 2
    g.destr()
    let u = createUnit(dying.getOwner(), 'uJ7J', pos, GetUnitFacing(dying).fromDeg())
    u.setTimedLife(n.toReal(), 'BHwe')
    let u2 = createUnit(dying.getOwner(), 'uJ7J', pos, GetUnitFacing(dying).fromDeg())
    u2.setTimedLife(n.toReal(), 'BHwe')

function jfDeathuJ68Filter() returns bool
    return GetFilterUnit().getOwner() == GetTriggerUnit().getOwner() and GetFilterUnit().isAlive() and GetTriggerUnit().getTypeId() == 'uJ68'

