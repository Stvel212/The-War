@noinline
function jfAttackBJ1B()
    let target = GetTriggerUnit()
    if not target.hasAbility('BJ1B') or target.getAbilityLevel('AJ6V') != 0
        return
    target.addAbility('AJ6V')
    jfDestroyEffectLater(1.5, addEffect("Abilities\\Spells\\Items\\AIda\\AIdaTarget.mdl", target, "overhead"))

// ============================================================
// Триггер Just Fight: Hellfire (способность 'AJ49') — атака
// ============================================================

@noinline
function hellfireAttack()
    let target = GetTriggerUnit()
    if target.getAbilityLevel('AJ49') < 1 or target.getAbilityLevel('AJ49') >= 13 or target.getHP() < 1.0
        return
    target.incAbilityLevel('AJ49')

// ============================================================
// Триггер Just Fight: Balnazzar (способность 'AJ4A') — атака
// ============================================================

@noinline
function balnazzarAttack()
    let target = GetTriggerUnit()
    if target.getAbilityLevel('AJ4A') != 1 or target.getHP() / target.getMaxHP() > 0.25
        return
    target.removeAbility('AJ4A')
    target.addAbility('AJ8N')
    jfDestroyEffectLater(3.0, addEffect("Abilities\\Spells\\Items\\VampiricPotion\\VampPotionCaster.mdl", target, "chest"))
    doAfter(3.0) ->
        target.removeAbility('AJ8N')
    doAfter(30.0) ->
        target.addAbility('AJ4A')

// ============================================================
// Триггер Just Fight: Wandering Swordsman (способность 'AJ4E') — атака
// ============================================================

@noinline
function wanderingSwordsmanAttack()
    let a = GetAttacker()
    if a.getAbilityLevel('AJ4E') != 1 or a.getHP() < 900.0 or a.hasAbility('Broa')
        return
    a.issueImmediateOrder("roar")

// ============================================================
// Триггер Just Fight: Wandering Swordsman (способность 'AJ4E') — применяет способность
// ============================================================

@noinline
function wanderingSwordsmanCast(unit caster)
    let u = caster
    doAfter(6.0) ->
        if u.getHP() > 1.0 and u.hasAbility('Broa')
            if summonUpgrade[u.getOwner().getId() + 1] < 3
                u.damageTarget(u, 680.0, true, false, ATTACK_TYPE_HERO, DAMAGE_TYPE_NORMAL, WEAPON_TYPE_WHOKNOWS)
            else
                u.damageTarget(u, 340.0, true, false, ATTACK_TYPE_HERO, DAMAGE_TYPE_NORMAL, WEAPON_TYPE_WHOKNOWS)

// ============================================================
// Триггер Just Fight: Medicine Maker ('hJ23') — атакует
// ============================================================

@noinline
function medicineMakerAttack()
    let a = GetAttacker()
    if a.getMana() >= 60.0
        let pos = a.getPos()
        var g = unitsInRange(500.0, pos, Condition(function medicineMakerAttackFilter))
        g = jfRandomSubGroup(1, g)
        if g.size() > 0
            for u in g
                let u2 = createUnit(a.getOwner(), 'eJ6N', pos, bj_UNIT_FACING.fromDeg())
                u2.issueTargetOrder("attack", u)
                u2.setTimedLife(1.0, 'BHwe')
            a.setMana(0.0)
        g.destr()
    else
        bountyGold = GetRandomInt(10, 13)
        a.setMana(a.getMana() + bountyGold.toReal())

function medicineMakerAttackFilter() returns bool
    return GetFilterUnit().isAllyOf(GetAttacker().getOwner()) and GetFilterUnit().getHP() / GetFilterUnit().getMaxHP() <= 0.84

// ============================================================
// Триггер Just Fight: 'eJ6N' — наносит урон
// ============================================================

@noinline
function jfDamageeJ6N()
    let target = GetTriggerUnit()
    if target.getHP() < 1.0
        return
    target.setHP(target.getHP() + target.getMaxHP() * 0.16)

// ============================================================
// Триггер Just Fight: Blood Mage ('hJ27'), Flame Mage ('hJ28') — атакует
// ============================================================

@noinline
function bloodMageAttack()
    vec2 pos
    let a = GetAttacker()
    let target = GetTriggerUnit()
    if a.getMana() >= 60.0
        pos = a.getPos()
        let u = createUnit(a.getOwner(), 'eJ6Q', pos, bj_UNIT_FACING.fromDeg())
        u.addAbility('AJ95')
        if a.getTypeId() == 'hJ28'
            u.incAbilityLevel('AJ95')
            u.setTimedLife(0.35, 'BHwe')
        else
            u.setTimedLife(0.15, 'BHwe')
        a.setMana(0)
    if a.getAbilityLevel('AJ96') == 0 and not target.isType(UNIT_TYPE_HERO)
        pos = target.getPos()
        let g = unitsInRange(300.0, pos, Condition(function bloodMageAttackFilter))
        if g.size() > 0
            let u2 = g.getRandom()
            a.addAbility('AJ96')
            jfDestroyEffectLater(2, addEffect("Abilities\\Spells\\Other\\Drain\\ManaDrainTarget.mdl", a, "chest"))
            jfDestroyEffectLater(2, addEffect("Abilities\\Spells\\Other\\Drain\\ManaDrainCaster.mdl", u2, "chest"))
            a.setMana(a.getMana() + u2.getMana())
            u2.setMana(0.0)
            if a.getTypeId() == 'hJ28'
                doAfter(15.0) ->
                    a.removeAbility('AJ96')
            else
                doAfter(24.0) ->
                    a.removeAbility('AJ96')
        g.destr()

function bloodMageAttackFilter() returns bool
    return not GetFilterUnit().isAllyOf(GetAttacker().getOwner()) and GetFilterUnit().isAlive() and GetFilterUnit().isType(UNIT_TYPE_GIANT) and GetFilterUnit().getAbilityLevel('Avul') == 0 and GetFilterUnit().getMana() >= 30.0 and GetFilterUnit().getAbilityLevel('AJ6I') == 0

// ============================================================
// Триггер Just Fight: 'BJ0J' — атака
// ============================================================

@noinline
function jfAttackBJ0J()
    let a = GetAttacker()
    if not a.hasAbility('BJ0J') or a.getAbilityLevel('AJ8T') != 0
        return
    if a.getHP() <= 180.0 and a.getHP() >= 1.0
        a.setHP(a.getHP() + 400.0)
        a.addAbility('AJ8T')
        flashEffect("Abilities\\Spells\\Other\\Incinerate\\FireLordDeathExplode.mdl", a, "origin")

// ============================================================
// Триггер Just Fight: Prophet (способность 'AJ2K'), Seer (способность 'AJ2M') — атака
// ============================================================

@noinline
function prophetAttack()
    let a = GetAttacker()
    if a.getMana() < 60.0 or a.getAbilityLevel('AJ2K') != 1 and a.getAbilityLevel('AJ2M') != 1
        return
    a.issueImmediateOrder("spiritwolf")

// ============================================================
// Триггер Just Fight: 'BJ0K', 'BJ0L' — атака
// ============================================================

@noinline
function jfAttackBJ0K()
    let a = GetAttacker()
    if not a.hasAbility('BJ0K') and not a.hasAbility('BJ0L') or a.getAbilityLevel('AJ8U') != 0 or a.getHP() < 1.0
        return
    if a.hasAbility('BJ0L')
        if a.getHP() <= 460.0
            a.addAbility('AJ8U')
            a.incAbilityLevel('AJ8U')
            jfDestroyEffectLater(2.0, addEffect("Abilities\\Spells\\Orc\\Purge\\PurgeBuffTarget.mdl", a, "origin"))
    else if a.getHP() <= 320.0
        a.addAbility('AJ8U')
        jfDestroyEffectLater(2.0, addEffect("Abilities\\Spells\\Orc\\Purge\\PurgeBuffTarget.mdl", a, "origin"))

// ============================================================
// Триггер Just Fight: 'AJ8U' — атака
// ============================================================

@noinline
function jfAttackAJ8U()
    let a = GetAttacker()
    if a.getAbilityLevel('AJ8U') <= 0
        return
    if a.getAbilityLevel('AJ8U') == 2
        if a.getHP() > 460.0
            a.removeAbility('AJ8U')
    else if a.getHP() > 320.0
        a.removeAbility('AJ8U')

// ============================================================
// Триггер Just Fight: Spirit Walker ('oJ5L') — атакует
// ============================================================

@noinline
function spiritWalkerAttack()
    let a = GetAttacker()
    if a.getMana() < 60.0
        return
    a.issueTargetOrder("spiritlink", a)

// ============================================================
// Триггер Just Fight: Spirit Walker (способность 'AJ5O') — применяет способность
// ============================================================

@noinline
function spiritWalkerCast(unit caster)
    if caster.getTypeId() != 'oJ5L'
        return
    var pos = caster.getPos()
    caster.issueTargetOrder("spiritlink", caster)
    var g = unitsInRange(500.0, pos, Condition(function spiritWalkerCastFilter))
    if g.size() > 3
        g = jfRandomSubGroup(3, g)
    if g.size() > 0
        for u in g
            pos = u.getPos()
            let u2 = jfDummy(caster.getOwner(), pos)
            u2.jfDummyAbility('AJ5O')
            u2.issueTargetOrder("spiritlink", u)
            u2.jfDummyLife(1.0)
    g.destr()

function spiritWalkerCastFilter() returns bool
    return GetFilterUnit().isAllyOf(GetTriggerUnit().getOwner()) and not GetFilterUnit().isType(UNIT_TYPE_DEAD) and GetFilterUnit().getHP() > 0.405 and not GetFilterUnit().hasAbility('Bspl') and GetFilterUnit().isType(UNIT_TYPE_GIANT) and GetFilterUnit() != GetTriggerUnit() and GetFilterUnit().getAbilityLevel('AJ6I') == 0

// ============================================================
// Триггер Just Fight: Tree Elf Guardian ('eJ0M') — наносит урон
// ============================================================

@noinline
function treeElfGuardianDamage()
    let source = GetEventDamageSource()
    let target = GetTriggerUnit()
    if source.getMana() < 60.0 or target.hasAbility('BEer') or not target.isType(UNIT_TYPE_GROUND) or target.isType(UNIT_TYPE_HERO)
        return
    source.setMana(0)
    let pos = source.getPos()
    let u = createUnit(source.getOwner(), 'eJ6O', pos, bj_UNIT_FACING.fromDeg())
    u.setTimedLife(6.2, 'BHwe')
    u.addAbility('AJ90')
    u.issueTargetOrder("magicleash", target)
    jfDestroyEffectLater(6.0, addEffect("Abilities\\Spells\\Items\\ClarityPotion\\ClarityTarget.mdl", source, "chest"))
    let n = (target.getMaxHP() * (0.3 / 12.0)).toInt()
    var n2 = 0
    doPeriodically(0.5) cb ->
        n2 = n2 + 1
        if n2 <= 12 and source.getHP() > 0.1
            source.setHP(source.getHP() + n.toReal())
        else
            destroy cb

// ============================================================
// Триггер Just Fight: 'AJ6C' — применяет способность
// ============================================================

@noinline
function jfCastAJ6C()
    let u = GetSpellTargetUnit()
    doAfter(5.3) ->
        jfAttackLane(u)

