// ============================================================
// Триггер Just Fight: Demon Hunter (способность 'AJ06') — применяет способность
// ============================================================

@noinline
function demonHunterCast2(unit caster)
    if caster.getTypeId() != 'uJ5T' and caster.getTypeId() != 'uJ5U'
        return
    if caster.getTypeId() == 'uJ5T'
        bountyGold = 1
    else
        bountyGold = 2
    var pos = caster.getPos()
    let g = unitsInRange(500.0, pos, Condition(function demonHunterCast2Filter))
    if g.size() >= 1
        for u in g
            if u.getAbilityLevel('AJ6A') <= 3
                pos = u.getPos()
                let u2 = createUnit(caster.getOwner(), 'uJ7H', pos, bj_UNIT_FACING.fromDeg())
                if g.size() == 1
                    u2.addAbility('AJ7Z')
                    u2.setTimedLife(23.0, 'BHwe')
                else if g.size() == 2
                    u2.addAbility('AJ80')
                    u2.setTimedLife(26.0, 'BHwe')
                else if g.size() == 3
                    u2.addAbility('AJ81')
                    u2.setTimedLife(29.0, 'BHwe')
                else
                    u2.addAbility('AJ82')
                    u2.setTimedLife(32.0, 'BHwe')
                flashEffect("Abilities\\Spells\\Undead\\RaiseSkeletonWarrior\\RaiseSkeleton.mdl", pos)
                u.incAbilityLevel('AJ6A')
    for i = 1 to bountyGold
        pos = caster.getPos()
        let u3 = createUnit(caster.getOwner(), 'uJ7H', pos, bj_UNIT_FACING.fromDeg())
        u3.setTimedLife(20.0, 'BHwe')
        if g.size() == 1
            u3.addAbility('AJ7Z')
            u3.setTimedLife(23.0, 'BHwe')
        else if g.size() == 2
            u3.addAbility('AJ80')
            u3.setTimedLife(26.0, 'BHwe')
        else if g.size() == 3
            u3.addAbility('AJ81')
            u3.setTimedLife(29.0, 'BHwe')
        else if g.size() == 4
            u3.addAbility('AJ82')
            u3.setTimedLife(32.0, 'BHwe')
        pos = u3.getPos()
        flashEffect("Abilities\\Spells\\Undead\\RaiseSkeletonWarrior\\RaiseSkeleton.mdl", pos)
    g.destr()

function demonHunterCast2Filter() returns bool
    return GetFilterUnit().isAllyOf(GetTriggerUnit().getOwner()) and GetFilterUnit().isType(UNIT_TYPE_GIANT) and GetFilterUnit().getTypeId() == 'uJ65' and not GetFilterUnit().isType(UNIT_TYPE_DEAD) and GetFilterUnit().getHP() > 0.405

// ============================================================
// Триггер Just Fight: Master Druid ('eJ0L') — наносит урон
// ============================================================

@noinline
function masterDruidDamage()
    let source = GetEventDamageSource()
    if source.getMana() != 60.0
        return
    let pos = source.getPos()
    var g = unitsInRange(600.0, pos, Condition(function masterDruidDamageFilter))
    if g.size() >= 1
        source.issueTargetOrder("rejuvination", g.getRandom())
    else
        g.destr()
        g = unitsInRange(600.0, pos, Condition(function masterDruidDamageFilter2))
        if g.size() >= 1
            source.issueTargetOrder("rejuvination", g.getRandom())
        else
            g = unitsInRange(600.0, pos, Condition(function masterDruidDamageFilter3))
            if g.size() >= 1
                source.issueTargetOrder("rejuvination", g.getRandom())
        g.destr()

function masterDruidDamageFilter() returns bool
    return GetFilterUnit().isAllyOf(GetEventDamageSource().getOwner()) and GetFilterUnit().isType(UNIT_TYPE_GIANT) and GetFilterUnit().isType(UNIT_TYPE_MELEE_ATTACKER) and GetFilterUnit().getMaxHP() >= 1000.0 and not GetFilterUnit().isType(UNIT_TYPE_DEAD) and GetFilterUnit().getHP() > 0.405 and GetFilterUnit().getHP() / GetFilterUnit().getMaxHP() <= 0.8 and not GetFilterUnit().hasAbility('Brej')

function masterDruidDamageFilter2() returns bool
    return GetFilterUnit().isAllyOf(GetEventDamageSource().getOwner()) and GetFilterUnit().isType(UNIT_TYPE_GIANT) and not GetFilterUnit().isType(UNIT_TYPE_DEAD) and GetFilterUnit().getHP() > 0.405 and GetFilterUnit().getHP() / GetFilterUnit().getMaxHP() <= 0.8 and not GetFilterUnit().hasAbility('Brej')

function masterDruidDamageFilter3() returns bool
    return GetFilterUnit().isAllyOf(GetEventDamageSource().getOwner()) and GetFilterUnit().isType(UNIT_TYPE_GIANT) and GetFilterUnit().isType(UNIT_TYPE_RANGED_ATTACKER) and not GetFilterUnit().isType(UNIT_TYPE_DEAD) and GetFilterUnit().getHP() > 0.405 and GetFilterUnit().getHP() / GetFilterUnit().getMaxHP() <= 0.8 and not GetFilterUnit().hasAbility('Brej')

// ============================================================
// Триггер Just Fight: Axe King (способность 'AJ5I') — атака
// ============================================================

@noinline
function axeKingAttack()
    let target = GetTriggerUnit()
    if target.getAbilityLevel('AJ5I') != 1
        return
    if GetRandomInt(1, 10) <= 1
        target.removeAbility('AJ5I')
        target.setAnimation("Spin")
        var pos = target.getPos()
        let g = unitsInRange(220.0, pos, Condition(function axeKingAttackFilter))
        for u in g
            target.damageTarget(u, 100.0, true, false, ATTACK_TYPE_MELEE, DAMAGE_TYPE_NORMAL, WEAPON_TYPE_WHOKNOWS)
            pos = u.getPos()
            flashEffect("Abilities\\Spells\\Other\\Stampede\\StampedeMissileDeath.mdl", pos)
        g.destr()
        doAfter(2.0) ->
            if target.getHP() > 1.0
                target.addAbility('AJ5I')

function axeKingAttackFilter() returns bool
    return (GetFilterUnit().isType(UNIT_TYPE_GIANT) or GetFilterUnit().isType(UNIT_TYPE_TAUREN)) and GetFilterUnit().isEnemyOf(GetTriggerUnit().getOwner()) and not GetFilterUnit().isType(UNIT_TYPE_DEAD) and GetFilterUnit().getHP() > 0.405

// ============================================================
// Триггер Just Fight: Axe King ('oJ5G') — его атакуют
// ============================================================

@noinline
function axeKingAttacked()
    let target = GetTriggerUnit()
    if target.getAbilityLevel('AJ5H') != 1 or target.getHP() <= 1.0
        return
    if target.getHP() / target.getMaxHP() <= 0.38
        target.issueImmediateOrder("roar")
        doAfter(3.0) ->
            if target.getHP() > 1.0
                target.removeAbility('AJ5H')

// ============================================================
// Триггер Just Fight: Unknown Undead ('nJ2Y'), Nameless Horror ('nJ1E') — его атакуют
// ============================================================

@noinline
function unknownUndeadAttacked()
    let target = GetTriggerUnit()
    if target.getHP() <= 1.0
        return
    if target.getHP() / target.getMaxHP() <= 0.5 and target.getAbilityLevel('AJ7L') != 1 and target.getAbilityLevel('AJ7M') != 1
        if target.getTypeId() == 'nJ2Y'
            target.addAbility('AJ7L')
            target.removeAbility('AJ32')
        else
            target.addAbility('AJ7M')
            target.removeAbility('AJ1L')
        let pos = target.getPos()
        flashEffect("Abilities\\Spells\\Orc\\FeralSpirit\\feralspirittarget.mdl", pos)

// ============================================================
// Триггер Just Fight: Unknown Undead ('nJ2Y'), Nameless Horror ('nJ1E') — атакует
// ============================================================

@noinline
function unknownUndeadAttack()
    let a = GetAttacker()
    let target = GetTriggerUnit()
    if target.getHP() <= 1.0
        return
    if a.getHP() / a.getMaxHP() > 0.5 and (a.getAbilityLevel('AJ7L') == 1 or a.getAbilityLevel('AJ7M') == 1)
        if a.getTypeId() == 'nJ2Y'
            a.removeAbility('AJ7L')
            a.addAbility('AJ32')
        else
            a.removeAbility('AJ7M')
            a.addAbility('AJ1L')

// ============================================================
// Триггер Just Fight: Voidwalker ('nJ1G'), Elder Voidwalker ('nJ1H') — наносит урон
// ============================================================

@noinline
function voidwalkerDamage()
    let source = GetEventDamageSource()
    let target = GetTriggerUnit()
    if source.getMana() != 60.0 or target.hasAbility('BJ1E')
        return
    source.issueImmediateOrder("waterelemental")

// ============================================================
// Триггер Just Fight: Voidwalker ('nJ1G'), Elder Voidwalker ('nJ1H') — начало применения
// ============================================================

@noinline
function voidwalkerCastStart()
    vec2 pos
    group g
    let caster = GetTriggerUnit()
    if caster.getTypeId() != 'nJ1G' and caster.getTypeId() != 'nJ1H'
        return
    if caster.getTypeId() == 'nJ1G'
        caster.addAbility('AJ7O')
        doAfter(2.0) ->
            caster.removeAbility('AJ7O')
        pos = caster.getPos()
        let u = jfDummy(caster.getOwner(), pos)
        u.jfDummyAbility('AJ7N')
        u.jfDummyLife(3.0)
        g = jfRandomSubGroup(1, unitsInRange(500.0, pos, Condition(function voidwalkerCastStartFilter)))
        for u2 in g
            u.issueTargetOrder("magicleash", u2)
        g.destr()
    else if caster.getTypeId() == 'nJ1H'
        caster.addAbility('AJ7Q')
        doAfter(4.0) ->
            caster.removeAbility('AJ7Q')
        pos = caster.getPos()
        let u3 = jfDummy(caster.getOwner(), pos)
        u3.jfDummyAbility('AJ7P')
        u3.jfDummyLife(5.0)
        g = jfRandomSubGroup(1, unitsInRange(500.0, pos, Condition(function voidwalkerCastStartFilter2)))
        for u4 in g
            u3.issueTargetOrder("magicleash", u4)
        g.destr()

function voidwalkerCastStartFilter() returns bool
    return GetFilterUnit().isEnemyOf(GetTriggerUnit().getOwner()) and GetFilterUnit().isAlive() and not GetFilterUnit().hasAbility('Bmlc')

function voidwalkerCastStartFilter2() returns bool
    return GetFilterUnit().isEnemyOf(GetTriggerUnit().getOwner()) and GetFilterUnit().isAlive() and not GetFilterUnit().hasAbility('Bmlc')

// ============================================================
// Триггер Just Fight: Great Voidwalker ('nJ1K') — атакует
// ============================================================

@noinline
function greatVoidwalkerAttack()
    unit u
    let a = GetAttacker()
    let target = GetTriggerUnit()
    let pos = target.getPos()
    let g = unitsInRange(300.0 * 1.0, pos, null)
    for u2 in g
        if u2.isType(UNIT_TYPE_SUMMONED) and not u2.isType(UNIT_TYPE_DEAD) and u2.getHP() > 0.405 and u2.getAbilityLevel('Avul') == 0 and u2.getAbilityLevel('AJ6I') == 0 and u2.isEnemyOf(a.getOwner()) and u2.getHP() < 600.0 and a.getMana() == 60.0
            a.setMana(0.0)
            flashEffect("Abilities\\Spells\\Human\\ControlMagic\\ControlMagicTarget.mdl", u2, "overhead")
            u2.setOwner(a.getOwner(), true)
            u = a
            jfAttackLane(u)
            u = u2
            jfAttackLane(u)
    g.destr()

// ============================================================
// Триггер Just Fight: Infernal Stone ('nJ2Z') — его атакуют
// ============================================================

@noinline
function infernalStoneAttacked()
    let target = GetTriggerUnit()
    if infernalStoneAttackedRunning
        return
    if target.getAbilityLevel('AJ6P') == 6
        return
    infernalStoneAttackedRunning = true
    if target.getAbilityLevel('AJ33') == 5
        target.setAbilityLevel('AJ33', 1)
        jfDestroyEffectLater(0.5, addEffect("Doodads\\Cinematic\\TownBurningFireEmitterBlue\\TownBurningFireEmitterBlue.mdl", target, "hand"))
        if target.getAbilityLevel('AJ6P') >= 1
            target.incAbilityLevel('AJ6P')
        else
            target.addAbility('AJ6P')
    else
        target.incAbilityLevel('AJ33')
    infernalStoneAttackedRunning = false

// ============================================================
// Триггер Just Fight: Night Stalker ('nJ31'), Balnazzar ('nJ47') — появляется
// ============================================================

@noinline
function nightStalkerEnter()
    let entering = GetTriggerUnit()
    if entering.getTypeId() != 'nJ31' and entering.getTypeId() != 'nJ47'
        return
    if entering.getAbilityLevel('AJ7R') == 0
        entering.addAbility('AJ7R')
        entering.addAbility('AJ98')
        doAfter(30.0) ->
            if entering.getHP() > 1.0
                entering.removeAbility('AJ7R')
                entering.removeAbility('AJ98')

// ============================================================
// Триггер Just Fight: Maiden of Pain ('nJ39'), Queen of Pain ('nJ32') — применяет способность
// ============================================================

@noinline
function maidenOfPainCast()
    let caster = GetTriggerUnit()
    if caster.getTypeId() != 'nJ39' and caster.getTypeId() != 'nJ32'
        return
    if caster.getTypeId() == 'nJ39'
        GetSpellTargetUnit().addAbility('AJ7S')
        GetSpellTargetUnit().addAbility('AJ99')
        let u = GetSpellTargetUnit()
        doAfter(6.0) ->
            if u.getHP() > 1.0
                u.removeAbility('AJ99')
                u.removeAbility('AJ7S')
    else
        GetSpellTargetUnit().addAbility('AJ7T')
        GetSpellTargetUnit().addAbility('AJ99')
        let u2 = GetSpellTargetUnit()
        doAfter(6.0) ->
            if u2.getHP() > 1.0
                u2.removeAbility('AJ99')
                u2.removeAbility('AJ7T')

// ============================================================
// Триггер Just Fight: Maiden of Pain ('nJ39'), Queen of Pain ('nJ32') — наносит урон
// ============================================================

@noinline
function maidenOfPainDamage()
    let source = GetEventDamageSource()
    if source.getMana() != 60.0
        return
    let pos = source.getPos()
    let g = unitsInRange(600.0, pos, Condition(function maidenOfPainDamageFilter))
    if g.size() >= 1
        source.issueTargetOrder("fingerofdeath", g.getRandom())
    g.destr()

function maidenOfPainDamageFilter() returns bool
    return GetFilterUnit().isAllyOf(GetEventDamageSource().getOwner()) and GetFilterUnit().isType(UNIT_TYPE_GIANT) and GetFilterUnit().isType(UNIT_TYPE_MELEE_ATTACKER) and not GetFilterUnit().isType(UNIT_TYPE_DEAD) and GetFilterUnit().getHP() > 0.405 and not GetFilterUnit().isIllusion() and not GetFilterUnit().hasAbility('BJ1F') and GetFilterUnit().getHP() >= 600.0

// ============================================================
// Триггер Just Fight: Frost Revenant ('nJ3A'), Death Revenant ('nJ3B') — наносит урон
// ============================================================

@noinline
function frostRevenantDamage()
    let source = GetEventDamageSource()
    let target = GetTriggerUnit()
    if target.isType(UNIT_TYPE_HERO) or source.getAbilityLevel('AJ7V') == 1
        return
    if GetRandomInt(1, 3) <= 1
        vec2 pos
        if source.getTypeId() == 'nJ3A'
            pos = target.getPos()
            flashEffect("Abilities\\Spells\\Undead\\FreezingBreath\\FreezingBreathTargetArt.mdl", pos)
            jfDestroyEffectLater(5.0, addEffect("Abilities\\Spells\\Items\\AIob\\AIobTarget.mdl", source, "weapon"))
            source.addAbility('AJ7V')
            if target.getAbilityLevel('AJ7U') != 1
                target.addAbility('AJ7U')
            doAfter(5.0) ->
                source.removeAbility('AJ7V')
                target.removeAbility('AJ7U')
        else
            pos = target.getPos()
            flashEffect("Abilities\\Spells\\Undead\\DeathandDecay\\DeathandDecayTarget.mdl", pos)
            jfDestroyEffectLater(5.0, addEffect("Abilities\\Spells\\Items\\AIob\\AIobTarget.mdl", source, "weapon"))
            source.addAbility('AJ7V')
            source.addAbility('AJ7A')
            if target.getAbilityLevel('AJ7U') != 1
                target.addAbility('AJ7U')
            if target.getAbilityLevel('AJ7W') != 1
                target.addAbility('AJ7W')
            doAfter(5.0) ->
                source.removeAbility('AJ7V')
                source.removeAbility('AJ7A')
                target.removeAbility('AJ7U')
                target.removeAbility('AJ7W')

// ============================================================
// Триггер Just Fight: Nether Dragon ('nJ3C'), Underworld Dragon ('nJ1L') — атакует
// ============================================================

@noinline
function netherDragonAttack()
    let a = GetAttacker()
    if a.getMana() != 60.0
        return
    a.issueImmediateOrder("berserk")

// ============================================================
// Триггер Just Fight: Nether Dragon (способность 'AJ3B'), Underworld Dragon (способность 'AJ1R') — применяет способность
// ============================================================

@noinline
function netherDragonCast(unit caster)
    if GetSpellAbilityId() == 'AJ1R'
        caster.addAbility('AJ7X')
        let u = caster
        doAfter(7.0) ->
            if u.getHP() > 1.0
                u.removeAbility('AJ7X')
    else
        caster.addAbility('AJ7Y')
        let u2 = caster
        doAfter(7.0) ->
            if u2.getHP() > 1.0
                u2.removeAbility('AJ7Y')

// ============================================================
// Триггер Just Fight: Underworld Black Dragon ('nJ3D') — наносит урон
// ============================================================

@noinline
function underworldBlackDragonDamage()
    let source = GetEventDamageSource()
    let target = GetTriggerUnit()
    if underworldBlackDragonDamageRunning
        return
    if target.isType(UNIT_TYPE_HERO) or target.getAbilityLevel('AJ9A') != 0
        return
    target.addAbility('AJ9A')
    jfDestroyEffectLater(5.0, addEffect("Abilities\\Spells\\Orc\\LiquidFire\\Liquidfire.mdl", target, "origin"))
    doAfter(5.0) ->
        if target.getHP() > 1.0
            source.damageTarget(target, 300.0, true, false, ATTACK_TYPE_MELEE, DAMAGE_TYPE_NORMAL, WEAPON_TYPE_WHOKNOWS)
            let pos = target.getPos()
            flashEffect("Abilities\\Spells\\Other\\Doom\\DoomDeath.mdl", pos)
            target.removeAbility('AJ9A')

// ============================================================
// Триггер Just Fight: Underworld Black Dragon ('nJ3D'), 'AJ9A' — смерть
// ============================================================

@noinline
function underworldBlackDragonDeath()
    let dying = GetDyingUnit()
    let killer = GetKillingUnit()
    if underworldBlackDragonDeathRunning
        return
    if dying.isType(UNIT_TYPE_HERO) or killer.getTypeId() != 'nJ3D' and dying.getAbilityLevel('AJ9A') != 1
        return
    underworldBlackDragonDeathRunning = true
    underworldBlackDragonDamageRunning = true
    let pos = dying.getPos()
    let g = unitsInRange(220.0, pos, Condition(function underworldBlackDragonDeathFilter))
    flashEffect("Abilities\\Spells\\Other\\Doom\\DoomDeath.mdl", pos)
    for u in g
        killer.damageTarget(u, 60.0, true, false, ATTACK_TYPE_MELEE, DAMAGE_TYPE_NORMAL, WEAPON_TYPE_WHOKNOWS)
    g.destr()
    underworldBlackDragonDamageRunning = false
    underworldBlackDragonDeathRunning = false

function underworldBlackDragonDeathFilter() returns bool
    return (not GetFilterUnit().isType(UNIT_TYPE_DEAD) and GetFilterUnit().getHP() > 0.405 or GetFilterUnit().getAbilityLevel('Avul') == 0) and GetFilterUnit().isEnemyOf(GetKillingUnit().getOwner())

// ============================================================
// Триггер Just Fight: 'AJ83', Centaur Khan (способность 'AJ3L') — атака
// ============================================================

@noinline
function jfAttackAJ83()
    let target = GetTriggerUnit()
    if target.getAbilityLevel('AJ83') != 1 and target.getAbilityLevel('AJ3L') != 1
        return
    let pos = target.getPos()
    let u = createUnit(target.getOwner(), 'eJ6O', pos, bj_UNIT_FACING.fromDeg())
    u.addAbility('AJ72')
    u.setTimedLife(1.0, 'BHwe')
    if target.getAbilityLevel('AJ83') == 1
        u.addItemById(0)
        target.removeAbility('AJ83')
    else
        u.addItemById(0)
        target.removeAbility('AJ3L')

// ============================================================
// Триггер Just Fight: 'AJ3N' — урон
// ============================================================

@noinline
function jfDamageAJ3N()
    let source = GetEventDamageSource()
    if source.getMana() < 60.0 or source.getAbilityLevel('AJ3N') != 1
        return
    let pos = source.getPos()
    let g = unitsInRange(500.0, pos, Condition(function jfDamageAJ3NFilter))
    for _u in g
        source.issueTargetOrder("thunderbolt", g.getRandom())
    g.destr()

function jfDamageAJ3NFilter() returns bool
    return not GetFilterUnit().isType(UNIT_TYPE_DEAD) and GetFilterUnit().getHP() > 0.405 and GetFilterUnit().isEnemyOf(GetEventDamageSource().getOwner()) and GetFilterUnit().getAbilityLevel('Avul') != 1

// ============================================================
// Триггер Just Fight: 'AJ3N' — применяет способность
// ============================================================

@noinline
function jfCastAJ3N(unit caster)
    var pos = GetSpellTargetUnit().getPos()
    flashEffect("Abilities\\Spells\\Other\\Incinerate\\FireLordDeathExplode.mdl", pos)
    caster.damageTarget(GetSpellTargetUnit(), 120.0, true, false, ATTACK_TYPE_MAGIC, DAMAGE_TYPE_NORMAL, WEAPON_TYPE_WHOKNOWS)
    if caster.hasAbility('BJ0S')
        bountyGold = GetRandomInt(1, 4)
        if bountyGold > 1
            pos = GetSpellTargetUnit().getPos()
            let tag = jfTextTag("x" + bountyGold, pos, 0, 13.0, 100, 0.0, 0.0, 0)
            tag.jfSetVelocity(60.0, 90)
            tag.setPermanent(false)
            tag.setLifespan(3.0)
            tag.setFadepoint(2.0)
            let u = GetSpellTargetUnit()
            let u2 = caster
            let pos2 = GetSpellTargetUnit().getPos()
            var n = bountyGold
            doPeriodically(0.3) cb ->
                n = n - 1
                if n > 0
                    u2.damageTarget(u, 120.0, true, false, ATTACK_TYPE_MAGIC, DAMAGE_TYPE_NORMAL, WEAPON_TYPE_WHOKNOWS)
                    flashEffect("Abilities\\Spells\\Other\\Incinerate\\FireLordDeathExplode.mdl", pos2)
                else
                    destroy cb

// ============================================================
// Триггер Just Fight: 'AJ3O' — атака
// ============================================================

@noinline
function jfAttackAJ3O()
    let a = GetAttacker()
    let target = GetTriggerUnit()
    if a.getAbilityLevel('AJ3O') > 6 or a.getAbilityLevel('AJ3O') < 1
        return
    if a.getAbilityLevel('AJ3O') == 6
        let pos = a.getPos()
        let u = jfDummy(a.getOwner(), pos)
        u.jfDummyLife(2.0)
        if a.getTypeId() == 'nJ3N'
            u.jfDummyAbility('AJ84')
        else
            u.jfDummyAbility('AJ85')
        u.issueTargetOrder("chainlightning", target)
        a.setAbilityLevel('AJ3O', 1)
    else
        a.incAbilityLevel('AJ3O')

// ============================================================
// Триггер Just Fight: Rexxar (способность 'AJ3Q'), Beastmaster (способность 'AJ3U') — атака
// ============================================================

@noinline
function rexxarAttack()
    let a = GetAttacker()
    if a.getAbilityLevel('AJ3Q') != 1 and a.getAbilityLevel('AJ3U') != 1 or a.getMana() < 60.0
        return
    a.issueImmediateOrder("waterelemental")

