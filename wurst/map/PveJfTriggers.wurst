// ============================================================
// Триггер Just Fight: Goblin Engineer ('nJ33'), Mad Bomber ('nJ34') — наносит урон
// ============================================================

@noinline
function goblinEngineerDamage()
    let source = GetEventDamageSource()
    let target = GetTriggerUnit()
    if goblinEngineerDamageRunning
        return
    goblinEngineerDamageRunning = true
    if GetRandomInt(1, 5) == 1
        let pos = target.getPos()
        flashEffect("Abilities\\Spells\\Other\\Volcano\\VolcanoDeath.mdl", pos)
        let g = unitsInRange(200.0, pos, Condition(function goblinEngineerDamageFilter))
        for u in g
            if source.getTypeId() == 'nJ33'
                UnitDamageTarget(source, u, 20.0, true, true, ATTACK_TYPE_SIEGE, DAMAGE_TYPE_NORMAL, WEAPON_TYPE_WHOKNOWS)
            else
                UnitDamageTarget(source, u, 30.0, true, true, ATTACK_TYPE_SIEGE, DAMAGE_TYPE_NORMAL, WEAPON_TYPE_WHOKNOWS)
        if source.getTypeId() == 'nJ33'
            UnitDamageTarget(source, target, 20.0, true, true, ATTACK_TYPE_SIEGE, DAMAGE_TYPE_NORMAL, WEAPON_TYPE_WHOKNOWS)
        else
            UnitDamageTarget(source, target, 30.0, true, true, ATTACK_TYPE_SIEGE, DAMAGE_TYPE_NORMAL, WEAPON_TYPE_WHOKNOWS)
        g.destr()
    goblinEngineerDamageRunning = false

function goblinEngineerDamageFilter() returns bool
    return GetFilterUnit().getAbilityLevel('Avul') == 0 and not GetFilterUnit().isType(UNIT_TYPE_DEAD) and GetFilterUnit().getHP() > 0.405 and GetFilterUnit().isEnemyOf(GetEventDamageSource().getOwner())

// ============================================================
// Триггер Just Fight: Clockwerk Goblin ('nJ2U'), Goblin Technician ('nJ2W') — атакует
// ============================================================

@noinline
function clockwerkGoblinAttack()
    let a = GetAttacker()
    if a.getAbilityLevel('AJ2Z') <= 0 or a.getHP() / a.getMaxHP() > 0.4 or a.getHP() < 1.0
        return
    a.removeAbility('AJ2Z')
    doPeriodically(0.6) cb ->
        if a.getHP() > 0.0 and a.getMaxHP() > 0.0
            if a.getHP() / a.getMaxHP() <= 0.4 and a.getHP() / a.getMaxHP() > 0.0
                a.setHP(a.getHP() + 22.0)
                let pos = a.getPos()
                flashEffect("Abilities\\Spells\\Human\\FlakCannons\\FlakTarget.mdl", pos)
            else
                a.addAbility('AJ2Z')
                destroy cb
        else
            destroy cb

// ============================================================
// Триггер Just Fight: 'hJ1S' — появляется
// ============================================================

@noinline
function jfEnterhJ1S()
    let entering = GetTriggerUnit()
    if entering.getTypeId() != 'hJ1S'
        return
    entering.getOwner().addGold(-8)
    let tag = jfTextTag("-8", entering, 0, 10, 100, 78.43, 0.0, 0)
    tag.jfSetVelocity(64.0, 90)
    tag.setVisibility(false)
    let players = forceOfPlayer(entering.getOwner())
    tag.jfShowForce(true, players)
    players.destr()
    tag.setPermanent(false)
    tag.setLifespan(2.0)
    tag.setFadepoint(1.0)

// ============================================================
// Триггер Just Fight: 'nJ40' — убивает
// ============================================================

@noinline
function jfKillnJ40()
    let dying = GetDyingUnit()
    let killer = GetKillingUnit()
    if dying.isType(UNIT_TYPE_TAUREN) or dying.isType(UNIT_TYPE_SUMMONED) or dying.isIllusion()
        return
    bountyUnitType = dying.getTypeId()
    bounty()
    if GetRandomInt(1, 2) == 1
        bountyGold = bountyGold * 2
    killer.getOwner().addLumber(bountyGold)
    if bountyGold > 0
        let tag = jfTextTag("+" + bountyGold, killer, 0, 10, 0.0, 78.4, 31.4, 0.0)
        tag.jfSetVelocity(64.0, 90)
        tag.setVisibility(false)
        let players = forceOfPlayer(killer.getOwner())
        tag.jfShowForce(true, players)
        players.destr()
        tag.setPermanent(false)
        tag.setLifespan(2.0)
        tag.setFadepoint(1.0)

// ============================================================
// Триггер Just Fight: Mortar Battalion ('hJ1N'), 'hJ1M' — убивает
// ============================================================

@noinline
function mortarBattalionKill()
    let killer = GetKillingUnit()
    if killer.getHP() < 1.0
        return
    if killer.getTypeId() == 'hJ1M' and killer.getAbilityLevel('AJ8Z') < 3
        if killer.getAbilityLevel('AJ8Z') == 0
            killer.addAbility('AJ8Z')
        else
            killer.incAbilityLevel('AJ8Z')
    if killer.getTypeId() == 'hJ1N' and killer.getAbilityLevel('AJ8Z') < 5
        if killer.getAbilityLevel('AJ8Z') == 0
            killer.addAbility('AJ8Z')
        else
            killer.incAbilityLevel('AJ8Z')

// ============================================================
// Триггер Just Fight: Alchemist ('hJ6V'), Master Alchemist ('hJ1U') — убивает
// ============================================================

@noinline
function alchemistKill()
    let dying = GetDyingUnit()
    let killer = GetKillingUnit()
    if dying.isType(UNIT_TYPE_TAUREN) or dying.isType(UNIT_TYPE_SUMMONED) or dying.isIllusion()
        return
    bountyUnitType = dying.getTypeId()
    bounty()
    let tag = jfTextTag("+" + bountyGold, killer, 0, 10, 100, 78.43, 0.0, 0)
    killer.getOwner().addGold(bountyGold)
    tag.jfSetVelocity(64.0, 90)
    tag.setVisibility(false)
    let players = forceOfPlayer(killer.getOwner())
    tag.jfShowForce(true, players)
    players.destr()
    tag.setPermanent(false)
    tag.setLifespan(2.0)
    tag.setFadepoint(1.0)
    flashEffect("Abilities\\Spells\\Items\\ResourceItems\\ResourceEffectTarget.mdl", killer, "chest")

// ============================================================
// Триггер Just Fight: Master Alchemist ('hJ1U') — атакует
// ============================================================

@noinline
function masterAlchemistAttack()
    let a = GetAttacker()
    let target = GetTriggerUnit()
    if a.getAbilityLevel('AJ7K') != 0
        return
    if target.getHP() / target.getMaxHP() <= 0.3
        a.addAbility('AJ7K')
        doAfter(3.0) ->
            a.removeAbility('AJ7K')

// ============================================================
// Триггер Just Fight: Skeleton General ('uJ62') — появляется
// ============================================================

@noinline
function skeletonGeneralEnter()
    let entering = GetTriggerUnit()
    if entering.getTypeId() != 'uJ62'
        return
    let pos = entering.getPos()
    let g = unitsInRange(400.0, pos, Condition(function skeletonGeneralEnterFilter))
    for u in g
        addEffect("Abilities\\Spells\\Human\\MagicSentry\\MagicSentryCaster.mdl", u, "overhead")
        if u.getAbilityLevel('AJ8O') == 0
            u.addAbility('AJ8O')
    g.destr()

function skeletonGeneralEnterFilter() returns bool
    return GetFilterUnit().getOwner() == GetTriggerUnit().getOwner() and (GetFilterUnit().getTypeId() == 'nJ2B' or GetFilterUnit().getTypeId() == 'nJ2C' or GetFilterUnit().getTypeId() == 'nJ2D')

