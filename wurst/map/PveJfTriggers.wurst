// Триггер Just Fight: Dark Bone Dragon ('uJ6A') — наносит урон
// ============================================================

@noinline
function darkBoneDragonDamage()
    let target = GetTriggerUnit()
    if target.isType(UNIT_TYPE_DEAD) or target.getAbilityLevel('AJ9B') != 0 or target.getTypeId() == 'uJ6A' or target.isType(UNIT_TYPE_HERO) or target.isType(UNIT_TYPE_STRUCTURE)
        return
    target.addAbility('AJ9B')

// ============================================================
// Триггер Just Fight: 'AJ9B' — смерть
// ============================================================

@noinline
function jfDeathAJ9B()
    let dying = GetDyingUnit()
    if dying.getAbilityLevel('AJ9B') != 1
        return
    let pos = dying.getPos()
    let g = unitsInRange(600.0, pos, Condition(function jfDeathAJ9BFilter))
    if g.size() > 0
        let u = g.getRandom()
        if u.getAbilityLevel('AJ8V') == 0
            u.addAbility('AJ8V')
        else
            u.incAbilityLevel('AJ8V')
        jfDestroyEffectLater(2, addEffect("Abilities\\Spells\\Undead\\ReplenishMana\\ReplenishManaCaster.mdl", u, "chest"))
    g.destr()

function jfDeathAJ9BFilter() returns bool
    return GetFilterUnit().getTypeId() == 'uJ6A' and GetFilterUnit().getHP() >= 1.0 and GetFilterUnit().getAbilityLevel('AJ8V') < 8

// ============================================================
// Триггер Just Fight: Raging Element ('nJ48') — применяет способность
// ============================================================

@noinline
function ragingElementCast()
    let caster = GetTriggerUnit()
    if caster.getTypeId() != 'nJ48' or GetSpellAbilityId() != 'AJ4B'
        return
    let pos = caster.getPos()
    let u = createUnit(caster.getOwner(), caster.getTypeId(), pos, GetUnitFacing(caster).fromDeg())
    u.setHP(caster.getHP())
    caster.removeAbility('AJ4C')

// ============================================================
// Триггер Just Fight: Raging Element ('nJ48') — наносит урон
// ============================================================

@noinline
function ragingElementDamage()
    let source = GetEventDamageSource()
    if source.getAbilityLevel('AJ4C') <= 0
        return
    if source.getAbilityLevel('AJ4C') <= 7
        if source.getHP() > 1.0
            source.incAbilityLevel('AJ4C')
    else
        source.issueImmediateOrder("waterelemental")

// ============================================================
// Триггер Just Fight: Devil s Daughter ('nJ4E') — атакует
// ============================================================

@noinline
function devilSDaughterAttack()
    let a = GetAttacker()
    if a.getMana() < 60.0
        return
    a.issueImmediateOrder("waterelemental")

// ============================================================
// Триггер Just Fight: Devil s Daughter ('nJ4E') — применяет способность
// ============================================================

@noinline
function devilSDaughterCast()
    let caster = GetTriggerUnit()
    if caster.getTypeId() != 'nJ4E' or GetSpellAbilityId() != 'AJ4G'
        return
    caster.addAbility('AJ8Y')
    doAfter(3.5) ->
        if caster.getHP() > 1.0
            caster.removeAbility('AJ8Y')

// ============================================================
// Триггер Just Fight: Shadow Spirit (способность 'AJ0P') — урон
// ============================================================

@noinline
function shadowSpiritDamage()
    let target = GetTriggerUnit()
    if target.getAbilityLevel('AJ0P') != 1 or GetEventDamage() > 1800.0
        return
    target.removeAbility('AJ0P')
    target.addAbility('Avul')
    flashEffect("Abilities\\Spells\\NightElf\\FaerieDragonInvis\\FaerieDragon_Invis.mdl", target, "chest")
    doAfter(0.2) ->
        target.removeAbility('Avul')
    doAfter(6.5) ->
        target.addAbility('AJ0P')

// ============================================================
// Триггер Just Fight: Nanorobot ('nJ4F') — появляется
// ============================================================

@noinline
function nanorobotEnter()
    let entering = GetTriggerUnit()
    if entering.getTypeId() != 'nJ4F'
        return
    entering.setAbilityLevel('AJ4H', 20)

// ============================================================
// Триггер Just Fight: Nanorobot (способность 'AJ4H') — урон
// ============================================================

@noinline
function nanorobotDamage()
    let target = GetTriggerUnit()
    if target.getAbilityLevel('AJ4H') <= 0 or target.isType(UNIT_TYPE_DEAD)
        return
    if target.getAbilityLevel('AJ4H') == 1
        target.removeAbility('AJ4H')
    else if GetEventDamage() >= 10
        target.decAbilityLevel('AJ4H')
    if not target.isType(UNIT_TYPE_DEAD) and target.getHP() > 0.405
        doAfter(0.01) ->
            if not target.isType(UNIT_TYPE_DEAD) and target.getHP() > 0.405
                target.setHP(target.getMaxHP())

// ============================================================
// Триггер Just Fight: Nine headed Demon Snake ('nJ4G') — смерть
// ============================================================

@noinline
function nineHeadedDemonSnakeDeath()
    force players
    let dying = GetDyingUnit()
    let killer = GetKillingUnit()
    if dying.getMana() == 60.0
        var pos = dying.getPos()
        let g = unitsInRange(500.0, pos, Condition(function nineHeadedDemonSnakeDeathFilter))
        if g.size() > 0
            let u = g.getRandom()
            bountyUnitType = u.getTypeId()
            pos = dying.getPos()
            let u2 = createUnit(dying.getOwner(), dying.getTypeId(), pos, GetUnitFacing(dying).fromDeg())
            addEffect("Abilities\\Spells\\Demon\\ReviveDemon\\ReviveDemon.mdl", pos)
            u2.setHP(u.getHP())
            u2.setMana(0)
            bounty()
            dying.getOwner().addGold(bountyGold)
            let tag = jfTextTag("+" + bountyGold, u, 0, 10, 100, 78.43, 0.0, 0)
            tag.jfSetVelocity(64.0, 90)
            tag.setVisibility(false)
            players = forceOfPlayer(dying.getOwner())
            tag.jfShowForce(true, players)
            players.destr()
            tag.setPermanent(false)
            tag.setLifespan(2.0)
            tag.setFadepoint(1.0)
            pos = u.getPos()
            addEffect("Objects\\Spawnmodels\\Undead\\UndeadLargeDeathExplode\\UndeadLargeDeathExplode.mdl", pos)
            u.remove()
        else if killer.getTypeId() != 'HJ6J' or killer.getTypeId() != 'HJ6K'
            bountyGold = 10
            killer.getOwner().addGold(bountyGold)
            let tag2 = jfTextTag("+" + bountyGold, dying, 0, 10, 100, 78.43, 0.0, 0)
            tag2.jfSetVelocity(64.0, 90)
            tag2.setVisibility(false)
            players = forceOfPlayer(killer.getOwner())
            tag2.jfShowForce(true, players)
            players.destr()
            tag2.setPermanent(false)
            tag2.setLifespan(2.0)
            tag2.setFadepoint(1.0)
        g.destr()
    else if killer.getTypeId() != 'HJ6J' or killer.getTypeId() != 'HJ6K'
        bountyGold = 10
        killer.getOwner().addGold(bountyGold)
        let tag3 = jfTextTag("+" + bountyGold, dying, 0, 10, 100, 78.43, 0.0, 0)
        tag3.jfSetVelocity(64.0, 90)
        tag3.setVisibility(false)
        players = forceOfPlayer(killer.getOwner())
        tag3.jfShowForce(true, players)
        players.destr()
        tag3.setPermanent(false)
        tag3.setLifespan(2.0)
        tag3.setFadepoint(1.0)

function nineHeadedDemonSnakeDeathFilter() returns bool
    return not GetFilterUnit().isType(UNIT_TYPE_DEAD) and GetFilterUnit().getHP() > 0.405 and GetFilterUnit().isEnemyOf(GetTriggerUnit().getOwner()) and GetFilterUnit().getAbilityLevel('Avul') != 1 and GetFilterUnit().getHP() < 500.0 and not GetFilterUnit().isType(UNIT_TYPE_HERO) and not GetFilterUnit().isType(UNIT_TYPE_STRUCTURE)

// ============================================================
// Триггер Just Fight: 'BJ11' — атака
// ============================================================

@noinline
function jfAttackBJ11()
    let a = GetAttacker()
    if a.hasAbility('BJ1G') or not a.hasAbility('BJ11')
        return
    if a.getHP() <= 440.0 and a.getHP() > 1.0
        a.addAbility('AJ93')

// ============================================================
// Триггер Just Fight: 'BJ1G' — атака
// ============================================================

@noinline
function jfAttackBJ1G()
    let a = GetAttacker()
    if not a.hasAbility('BJ1G')
        return
    if a.getHP() > 440.0
        a.removeAbility('AJ93')

// ============================================================
// Триггер Just Fight: Exploding Bloatbat ('nJ4J') — наносит урон
// ============================================================

@noinline
function explodingBloatbatDamage()
    let source = GetEventDamageSource()
    let target = GetTriggerUnit()
    if explodingBloatbatDamageRunning
        return
    explodingBloatbatDamageRunning = true
    let pos = target.getPos()
    let g = unitsInRange(500.0, pos, Condition(function explodingBloatbatDamageFilter))
    if g.size() > 0
        let u = g.getRandom()
        source.issueTargetOrder("unstableconcoction", u)
    g.destr()
    explodingBloatbatDamageRunning = false

function explodingBloatbatDamageFilter() returns bool
    return GetFilterUnit().isEnemyOf(GetEventDamageSource().getOwner()) and GetFilterUnit().isType(UNIT_TYPE_GIANT) and GetFilterUnit().isAlive() and GetFilterUnit().getAbilityLevel('A00W') == 1

// ============================================================
// Триггер Just Fight: Exploding Bloatbat (способность 'AJ4L') — применяет способность
// ============================================================

@noinline
function explodingBloatbatCast(unit caster)
    let value = caster.getHP()
    var n = 0
    let u = caster
    let u2 = GetSpellTargetUnit()
    let u3 = caster
    doPeriodically(0.1) cb ->
        n = n + 1
        if not u.isAlive()
            u3.damageTarget(u2, value, true, false, ATTACK_TYPE_CHAOS, DAMAGE_TYPE_NORMAL, WEAPON_TYPE_WHOKNOWS)
            destroy cb
        else if n >= 20
            destroy cb

// ============================================================
// Триггер Just Fight: Nine headed Demon Snake ('nJ4G') — наносит урон
// ============================================================

@noinline
function nineHeadedDemonSnakeDamage()
    let source = GetEventDamageSource()
    bountyGold = 20
    source.setMana(source.getMana() + bountyGold.toReal())

// ============================================================
// Триггер Just Fight: Self Exploding Goblin (способность 'AJ4M') — урон
// ============================================================

@noinline
function selfExplodingGoblinDamage()
    let source = GetEventDamageSource()
    let target = GetTriggerUnit()
    if source.getAbilityLevel('AJ4M') <= 0 or source.getHP() < 1.0
        return
    source.issueTargetOrder("selfdestruct", target)

// ============================================================
// Триггер Just Fight: Goblin Experimental Boat ('nJ4L') — наносит урон
// ============================================================

@noinline
function goblinExperimentalBoatDamage()
    let source = GetEventDamageSource()
    let target = GetTriggerUnit()
    if source.getMana() < 1.0
        return
    let n = source.getMana().toInt() * 6
    source.setMana(0)
    playerHero[source.getOwner().getId() + 1].damageTarget(target, n.toReal(), true, false, ATTACK_TYPE_NORMAL, DAMAGE_TYPE_ENHANCED, WEAPON_TYPE_WHOKNOWS)
    let tag = jfTextTag("+" + n + "！", source, 0, 10, 50.0, 100.0, 0.0, 0)
    tag.jfSetVelocity(60.0, 90)
    tag.setPermanent(false)
    tag.setLifespan(3.0)
    tag.setFadepoint(2.0)

// ============================================================
// Триггер Just Fight: Gnoll Guard (способность 'AJ4N') — урон
// ============================================================

@noinline
function gnollGuardDamage()
    let source = GetEventDamageSource()
    if source.getAbilityLevel('AJ4N') != 1
        return
    source.setAbilityLevel('AJ4N', 2)

// ============================================================
// Триггер Just Fight: Gnoll Guard (способность 'AJ4N') — урон
// ============================================================

@noinline
function gnollGuardDamage2()
    let target = GetTriggerUnit()
    if target.getAbilityLevel('AJ4N') <= 1
        return
    if target.getAbilityLevel('AJ4N') < 10
        target.incAbilityLevel('AJ4N')
    else
        target.setAbilityLevel('AJ4N', 1)

// ============================================================
// Триггер Just Fight: Gnoll Leader (способность 'AJ4P') — атака
// ============================================================

@noinline
function gnollLeaderAttack()
    let a = GetAttacker()
    if a.getAbilityLevel('AJ4P') != 1
        return
    a.issueImmediateOrder("roar")

// ============================================================
// Триггер Just Fight: Gnoll Leader (способность 'AJ4Q') — применяет способность
// ============================================================

@noinline
function gnollLeaderCast(unit caster)
    if not caster.isType(UNIT_TYPE_DEAD) and caster.getHP() > 0.405
        caster.setAbilityLevel('AJ4P', 2)
    let u = caster
    doAfter(5.0) ->
        if not u.isType(UNIT_TYPE_DEAD) and u.getHP() > 0.405
            u.setAbilityLevel('AJ4P', 1)

// ============================================================
// Триггер Just Fight: Gnoll Soul Walker ('eJ0R') — смерть
// ============================================================

@noinline
function gnollSoulWalkerDeath()
    let dying = GetDyingUnit()
    let killer = GetKillingUnit()
    if not killer.isType(UNIT_TYPE_GIANT) and not killer.isType(UNIT_TYPE_TAUREN)
        return
    let pos = dying.getPos()
    let u = createUnit(dying.getOwner(), jfCopyType(killer), pos, GetUnitFacing(dying).fromDeg())
    u.setTimedLife(30.0, 'BHwe')
    u.setHP(killer.getHP())
    jfDestroyEffectLater(2, addEffect("Abilities\\Spells\\Orc\\Purge\\PurgeBuffTarget.mdl", u, "chest"))
    if killer.getTypeId() == 'nJ4R'
        doAfter(30.0) ->
            u.remove()

// ============================================================
// Триггер Just Fight: Panda (способность 'AJ4S'), Pandaren Brewmaster (способность 'AJ4U') — урон
// ============================================================

@noinline
function pandaDamage()
    let source = GetEventDamageSource()
    let target = GetTriggerUnit()
    if source.getAbilityLevel('AJ4S') < 1 and source.getAbilityLevel('AJ4U') < 1 or source.getMana() < 60.0
        return
    let pos = target.getPos()
    source.issuePointOrder("breathoffire", pos)

// ============================================================
// Триггер Just Fight: Pandaren Brewmaster (способность 'AJ4V') — урон
// ============================================================

@noinline
function pandarenBrewmasterDamage()
    let target = GetTriggerUnit()
    if target.getAbilityLevel('AJ4V') < 1
        return
    if target.getHP() < 100.0
        doAfter(3.5) ->
            if not target.isType(UNIT_TYPE_DEAD) and target.getHP() > 0.405
                jfAttackLane(target)

// ============================================================
// Триггер Just Fight: Dragon Spawn Warrior (способность 'AJ4W'), Dragon Spawn Guardian (способность 'AJ4X') — урон
// ============================================================

@noinline
function dragonSpawnWarriorDamage()
    let target = GetTriggerUnit()
    if target.getAbilityLevel('AJ4W') < 1 and target.getAbilityLevel('AJ4X') < 1
        return
    if target.getAbilityLevel('AJ4W') >= 1 and target.getAbilityLevel('AJ4W') <= 10
        if jfLLllI[target.getOwner().getId() + 1] >= 1
            if target.getAbilityLevel('AJ4W') <= 3
                target.incAbilityLevel('AJ4W')
        else
            target.incAbilityLevel('AJ4W')
    if target.getAbilityLevel('AJ4X') >= 1 and target.getAbilityLevel('AJ4X') <= 10
        if jfLLllI[target.getOwner().getId() + 1] >= 1
            if target.getAbilityLevel('AJ4X') <= 5
                target.incAbilityLevel('AJ4X')
        else
            target.incAbilityLevel('AJ4X')

// ============================================================
// Триггер Just Fight: Broodmother ('nJ4X') — наносит урон
// ============================================================

@noinline
function broodmotherDamage()
    let source = GetEventDamageSource()
    let target = GetTriggerUnit()
    if target.isType(UNIT_TYPE_SUMMONED)
        return
    if not target.hasAbility('BNpa') and not target.hasAbility('BNpm')
        source.issueTargetOrder("parasite", target)

// ============================================================
// Триггер Just Fight: Harpy Queen (способность 'AJ0U') — урон
// ============================================================

@noinline
function harpyQueenDamage()
    let source = GetEventDamageSource()
    if source.getAbilityLevel('AJ0U') <= 0 or source.getMana() != 60.0
        return
    let pos = source.getPos()
    let g = unitsInRange(700.0, pos, Condition(function harpyQueenDamageFilter))
    if g.size() >= 1
        source.issueTargetOrder("healingwave", FirstOfGroup(g))
    g.destr()

function harpyQueenDamageFilter() returns bool
    return GetFilterUnit().isAllyOf(GetEventDamageSource().getOwner()) and not GetFilterUnit().isType(UNIT_TYPE_DEAD) and GetFilterUnit().getHP() > 0.405 and GetFilterUnit().getMaxHP() - GetFilterUnit().getHP() >= 130.0

// ============================================================
// Триггер Just Fight: 'AJ0Y' — атака
// ============================================================

@noinline
function jfAttackAJ0Y()
    let a = GetAttacker()
    if a.getAbilityLevel('AJ0Y') != 1
        return
    a.setAbilityLevel('AJ0Y', 2)
    doAfter(3.0) ->
        a.setAbilityLevel('AJ0Y', 1)

// ============================================================
// Триггер Just Fight: Windows 8 (способность 'AJ9O') — появляется
// ============================================================

@noinline
function windows8Enter()
    let entering = GetTriggerUnit()
    if entering.getAbilityLevel('AJ9O') <= 0
        return
    if jfPveLevel() == 4
        entering.setAbilityLevel('AJ9O', 2)
    if jfPveLevel() == 5
        entering.setAbilityLevel('AJ9O', 3)
    if jfPveLevel() == 6
        entering.setAbilityLevel('AJ9O', 4)

function bounty()
    if bountyUnitType == 'nJ6I'
        bountyGold = 1
    else if bountyUnitType == 'nJ78' or bountyUnitType == 'nJ79' or GetUnitPointValueByType(bountyUnitType) == 309 or GetUnitPointValueByType(bountyUnitType) == 171
        bountyGold = 2
    else if IsUnitIdType(bountyUnitType, UNIT_TYPE_GIANT) and unitGoldCost(bountyUnitType) == 0 and unitWoodCost(bountyUnitType) == 0 and GetFoodUsed(bountyUnitType) == 0 and GetUnitPointValueByType(bountyUnitType) != 100
        bountyGold = GetFoodUsed(unitTypeByPointValue[GetUnitPointValueByType(bountyUnitType)])
        bountyGold = bountyGold * 2
    else
        bountyGold = 0

function unitGoldCost(int n) returns int
    if IsHeroUnitId(n)
        return 425
    return GetUnitGoldCost(n)

function bountyOfTarget()
    bountyUnitType = GetSpellTargetUnit().getTypeId()
    if unitWoodCost(bountyUnitType) > 0
        bountyGold = unitWoodCost(bountyUnitType)
        bountyGold = bountyGold div 20
    else
        bountyGold = 0

/** Подписка триггеров Just Fight — при старте режима с копиями (PvE, PvEvP): в PvP их нет вовсе */
public function jfRegisterTriggers()
    onDamageBy('oJ5K') ->
        kingKongDamage()
    onKillBy('oJ5K') ->
        kingKongKill()
    onDamageBy('hJ26') ->
        paladinDamage()
    onDamaged('hJ26') ->
        paladinDamaged()
    onAttackBy('uJ69') ->
        soulEaterBansheeAttack()
    EventListener.onCast('AJ6E') (caster) ->
        soulEaterBansheeCast(caster)
    EventListener.onCast('AJ8C') (_caster) ->
        jfCastAJ8C()
    onDamageBy('eJ0K') ->
        priestessOfTheMoonDamage()
    onUnitEnter(function shrimpQueenEnter)
    onUnitEnter(function naishaTheHuntressEnter)
    onUnitEnter(function livingPuppetEnter)
    onUnitEnter(function eliteRaiderEnter)
    onUnitEnter(function jfEnternJ3E)
    onUnitEnter(function chimeraElectricityEnter)
    onUnitEnter(function seaElementalEnter)
    onAttackBy('oJ51', 'oJ52') ->
        trollBerserkerAttack()
    onDamageBy('oJ51', 'oJ52') ->
        trollBerserkerDamage()
    onUnitEnter(function jfEnteruJ5R)
    onDamageBy('hJ1J') ->
        sorceressDamage()
    EventListener.onCast('AJ1P') (caster) ->
        sorceressCast(caster)
    onDamageBy('hJ1I') ->
        cavalrymanDamage()
    onAttackBy('oJ59', 'oJ5A') ->
        jfAttackoJ59()
    onAttacked('oJ5A') ->
        taurenChieftainAttacked()
    onAttackBy('oJ4Z') ->
        orcBruteAttack()
    EventListener.onCast('AJ52') (caster) ->
        orcBruteCast(caster)
    onDamageBy('oJ4Z') ->
        orcBruteDamage()
    onAttackBy('hJ19') ->
        frostArcherAttack()
    onDamageBy('hJ19') ->
        frostArcherDamage()
    onAttackBy('eJ0A', 'eJ0B') ->
        jfAttackeJ0A()
    onDamageBy('eJ0A', 'eJ0B') ->
        jfDamageeJ0A()
    onDeathOf('nJ2E') ->
        murlocHunterDeath()
    onDeathOf('nJ75') ->
        murlocGuardDeath()
    onAttackBy('oJ53', 'oJ54') ->
        jfAttackoJ53()
    onAttackBy('uJ60', 'uJ5Z', 'uJ7L', 'uJ7K') ->
        lordOfHellAttack()
    onAttackBy('uJ7O') ->
        lordOfHellAttack()
    EventListener.onCast('AJ62') (caster) ->
        deathKnightCast(caster)
    onAttackBy('hJ1B') ->
        firePhoenixAttack()
    EventListener.onCast('AJ1F') (caster) ->
        firePhoenixCast(caster)
    onDamageBy('hJ12', 'hJ1C', 'hJ72') ->
        mountainKingDamage()
    onDamageBy('oJ5D', 'oJ5E', 'oJ7G') ->
        shadowHunterDamage()
    onUnitEnter(function marauderEnter)
    onDeathOf('oJ5F') ->
        marauderDeath()
    onUnitEnter(function scorchingArcherEnter)
    onDamageBy('uJ5W') ->
        calamityDamage()
    EventListener.onCast('AJ5W') (caster) ->
        calamityCast(caster)
    onAttackBy('eJ0F') ->
        furionAttack()
    onAttackBy('eJ07') ->
        jfAttackeJ07()
    onDeathOf('hJ6W', 'hJ6X', 'hJ70', 'hJ71') ->
        iceElementalDeath()
    EventListener.onCast('AJ2D') (caster) ->
        jainaCast(caster)
    EventListener.onCast('AJ2F') (caster) ->
        jainaCast(caster)
    onDamaged('HJ6J') ->
        warGodDamaged()
    onDamaged('HJ6J') ->
        warGodDamaged2()
    onDeathOf('uJ68') ->
        jfDeathuJ68()
    onUnitEnter(function avatarEnter)
    onAttackBy('eJ0J', 'eJ05', 'eJ6R', 'eJ6S') ->
        greatDevilAttack()
    onAttackBy('eJ6T') ->
        greatDevilAttack()
    EventListener.onCast('AJ06') (caster) ->
        demonHunterCast(caster)
    onAttackBy('eJ08', 'eJ0E') ->
        jfAttackeJ08()
    onDamageBy('nJ2E') ->
        murlocHunterDamage()
    EventListener.add(EVENT_PLAYER_UNIT_SPELL_FINISH) ->
        sorceressCastEnd()
    onDamaged('uJ5O') ->
        ghoulPoltergeistDamaged()
    EventListener.onCast('AJ5Q') (caster) ->
        ghoulPoltergeistCast(caster)
    onDeathOf('uJ5Q') ->
        hugeAbominationDeath()
    onDeathOf('uJ5Q') ->
        hugeAbominationDeath2()
    onDeathOf('uJ67') ->
        plagueCarrierDeath()
    onDamageBy('nJ2M') ->
        jfDamagenJ2M()
    onKillBy('uJ61') ->
        darkCasterKill()
    onAttacked('eJ0D') ->
        jfAttackedeJ0D()
    onUnitEnter(function ancientMedusaEnter)
    onUnitEnter(function medusaEnter)
    onAttackBy('nJ2X') ->
        jfAttacknJ2X()
    onDamageBy('nJ2G', 'nJ2H') ->
        snapDragonGreenDamage()
    onAttackBy('nJ2I', 'nJ2J') ->
        nagaMyrmidonAttack()
    onDamageBy('nJ76', 'nJ2M') ->
        nagaBansheeDamage()
    EventListener.onCast('AJ6R') (_caster) ->
        nagaBansheeCast()
    EventListener.onCast('AJ2V') (_caster) ->
        nagaBansheeCast()
    onAttackBy('nJ2N') ->
        hydraAttack()
    onAttackBy('nJ2O') ->
        nineHeadedHydraAttack()
    onDamageBy('nJ2P', 'nJ2Q') ->
        jfDamagenJ2P()
    onAttackBy('nJ2R', 'nJ2S', 'nJ7E') ->
        medusaAttack()
    onAttackBy('nJ2R', 'nJ2S') ->
        medusaAttack2()
    EventListener.onCast('AJ06') (caster) ->
        demonHunterCast2(caster)
    onDamageBy('eJ0L') ->
        masterDruidDamage()
    onAttacked('oJ5G') ->
        axeKingAttacked()
    onAttacked('nJ2Y', 'nJ1E') ->
        unknownUndeadAttacked()
    onAttackBy('nJ2Y', 'nJ1E') ->
        unknownUndeadAttack()
    onDamageBy('nJ1G', 'nJ1H') ->
        voidwalkerDamage()
    EventListener.add(EVENT_PLAYER_UNIT_SPELL_CAST) ->
        voidwalkerCastStart()
    onAttackBy('nJ1K') ->
        greatVoidwalkerAttack()
    onAttacked('nJ2Z') ->
        infernalStoneAttacked()
    onUnitEnter(function nightStalkerEnter)
    EventListener.add(EVENT_PLAYER_UNIT_SPELL_EFFECT) ->
        maidenOfPainCast()
    onDamageBy('nJ39', 'nJ32') ->
        maidenOfPainDamage()
    onDamageBy('nJ3A', 'nJ3B') ->
        frostRevenantDamage()
    onAttackBy('nJ3C', 'nJ1L') ->
        netherDragonAttack()
