// ============================================================
// Триггер Just Fight: Centaur Khan (способность 'AJ3K') — атака
// ============================================================

@noinline
function centaurKhanAttack()
    let a = GetAttacker()
    if a.getAbilityLevel('AJ3K') != 1 or a.getMana() < 60.0
        return
    a.issueImmediateOrder("stomp")

// ============================================================
// Триггер Just Fight: Maiev ('nJ3T') — его атакуют
// ============================================================

@noinline
function maievAttacked()
    let target = GetTriggerUnit()
    if target.getHP() / target.getMaxHP() > 0.8 or target.getAbilityLevel('AJ3V') != 1
        return
    target.addAbility('AJ94')
    target.removeAbility('AJ3V')
    target.addAbility('AJ78')
    target.issueImmediateOrder("stop")
    var n = 0
    doPeriodically(0.1) cb ->
        n = n + 1
        if n <= 20
            if target.getHP() >= 1.0
                target.setHP(target.getHP() + 10.0)
            else
                destroy cb
        else
            target.removeAbility('AJ94')
            jfAttackLane(target)
            target.removeAbility('AJ78')
            destroy cb
    doAfter(14.0) ->
        if target.getHP() > 1.0
            target.addAbility('AJ3V')

// ============================================================
// Триггер Just Fight: Dragon Hawk Rider ('hJ1P') — атакует
// ============================================================

@noinline
function dragonHawkRiderAttack()
    let a = GetAttacker()
    if a.getMana() != 60.0
        return
    let pos = a.getPos()
    let g = jfRandomSubGroup(1, unitsInRange(880.0, pos, Condition(function dragonHawkRiderAttackFilter)))
    if g.size() == 1
        a.issueImmediateOrder("waterelemental")
    g.destr()

function dragonHawkRiderAttackFilter() returns bool
    return GetFilterUnit().isEnemyOf(GetAttacker().getOwner()) and GetFilterUnit().isAlive() and not GetFilterUnit().hasAbility('Bmlt') and GetFilterUnit().getAbilityLevel('A00W') == 1

// ============================================================
// Триггер Just Fight: Dragon Hawk Rider (способность 'AJ1T') — применяет способность
// ============================================================

@noinline
function dragonHawkRiderCast(unit caster)
    let pos = caster.getPos()
    let u = createUnit(caster.getOwner(), 'eJ6L', pos, bj_UNIT_FACING.fromDeg())
    u.addAbility('AJ71')
    u.setTimedLife(6.0, 'BHwe')
    let g = jfRandomSubGroup(1, unitsInRange(880.0, pos, Condition(function dragonHawkRiderCastFilter)))
    if g.size() == 1
        u.issueTargetOrder("magicleash", FirstOfGroup(g))
    g.destr()

function dragonHawkRiderCastFilter() returns bool
    return GetFilterUnit().isEnemyOf(GetTriggerUnit().getOwner()) and GetFilterUnit().isAlive() and not GetFilterUnit().hasAbility('Bmlt') and GetFilterUnit().getAbilityLevel('A00W') == 1

// ============================================================
// Триггер Just Fight: Kodo Beast ('oJ5H') — атакует
// ============================================================

@noinline
function kodoBeastAttack()
    let a = GetAttacker()
    let target = GetTriggerUnit()
    if a.getAbilityLevel('AJ5J') != 1 or target.getHP() >= 500.0 or target.getMaxHP() > 1500.0
        return
    a.setAnimation("Spell Slam")
    doAfter(1.0) ->
        if a.isAlive() and target.isAlive()
            force players
            if unitWoodCost(target.getTypeId()) >= 20
                bountyUnitType = target.getTypeId()
                bountyOfTarget()
                if bountyGold != 0
                    a.getOwner().addGold(bountyGold)
                    let tag = jfTextTag("+" + bountyGold, target, 0, 10, 100, 78.43, 0.0, 0)
                    tag.jfSetVelocity(64.0, 90)
                    tag.setVisibility(false)
                    players = forceOfPlayer(a.getOwner())
                    tag.jfShowForce(true, players)
                    players.destr()
                    tag.setPermanent(false)
                    tag.setLifespan(2.0)
                    tag.setFadepoint(1.0)
            if not target.isType(UNIT_TYPE_SUMMONED)
                bountyUnitType = target.getTypeId()
                bounty()
                a.getOwner().addGold(bountyGold)
                if bountyGold != 0
                    let tag2 = jfTextTag("+" + bountyGold, target, 0, 10, 100, 78.43, 0.0, 0)
                    tag2.jfSetVelocity(64.0, 90)
                    tag2.setVisibility(false)
                    players = forceOfPlayer(a.getOwner())
                    tag2.jfShowForce(true, players)
                    players.destr()
                    tag2.setPermanent(false)
                    tag2.setLifespan(2.0)
                    tag2.setFadepoint(1.0)
            doAfter(target.getHP() / 30.0) ->
                a.addAbility('AJ5J')
            a.setHP(a.getHP() + target.getHP())
            a.removeAbility('AJ5J')
            target.remove()
            doAfter(0.1) ->
                jfAttackLane(a)

