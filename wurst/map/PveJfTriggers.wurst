// ============================================================
// Триггер Just Fight: 'AJ8W' — смерть
// ============================================================

@noinline
function jfDeathAJ8W()
    let dying = GetDyingUnit()
    if dying.getAbilityLevel('AJ8W') != 1
        return
    let pos = dying.getPos()
    let u = createUnit(dying.getOwner(), 'uJ7H', pos, bj_UNIT_FACING.fromDeg())
    u.setTimedLife(20.0, 'BHwe')

// ============================================================
// Триггер Just Fight: Black Rock Swordsman (способность 'AJ42') — атака
// ============================================================

@noinline
function blackRockSwordsmanAttack()
    let a = GetAttacker()
    if a.getAbilityLevel('AJ42') != 1 or a.getMana() < 60.0
        return
    a.setMana(0.0)
    let pos = a.getPos()
    let u = createUnit(a.getOwner(), a.getTypeId(), pos, GetUnitFacing(a).fromDeg())
    u.setTimedLife(60.0, 'BHwe')
    u.removeAbility('AJ42')
    u.addAbility('Aloc')
    addEffect("models\\Portal.mdx", u, "origin")
    u.setVertexColor((0.0 * 2.55).toInt(), (0.0 * 2.55).toInt(), (0.0 * 2.55).toInt(), 255 - (50.0 * 2.55).toInt())
    doAfter(3.0) ->
        u.remove()

