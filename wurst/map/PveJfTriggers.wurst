// ============================================================
// Триггер Just Fight: Shadow Hunter ('oJ5D'), Shadow Killer ('oJ5E'), Alienated Shadow Killer ('oJ7G') — наносит урон
// ============================================================

@noinline
function shadowHunterDamage()
    let source = GetEventDamageSource()
    if source.getMana() != 60.0
        return
    let pos = source.getPos()
    let g = unitsInRange(700.0, pos, Condition(function shadowHunterDamageFilter))
    if g.size() >= 1
        source.issueTargetOrder("healingwave", FirstOfGroup(g))
    g.destr()

function shadowHunterDamageFilter() returns bool
    return GetFilterUnit().isAllyOf(GetEventDamageSource().getOwner()) and not GetFilterUnit().isType(UNIT_TYPE_DEAD) and GetFilterUnit().getHP() > 0.405 and GetFilterUnit().getHP() / GetFilterUnit().getMaxHP() <= 0.6

// ============================================================
// Триггер Just Fight: Captain (способность 'AJ14') — атака
// ============================================================

@noinline
function captainAttack()
    vec2 pos
    let a = GetAttacker()
    if a.getAbilityLevel('AJ14') != 1
        return
    a.removeAbility('AJ14')
    if a.getTypeId() == 'hJ13'
        for i = 1 to 3
            pos = a.getPos()
            let u = createUnit(a.getOwner(), 'hJ6U', pos, bj_UNIT_FACING.fromDeg())
            u.setTimedLife(360.0, 'BHwe')
            pos = u.getPos()
            flashEffect("Abilities\\Spells\\Human\\MassTeleport\\MassTeleportCaster.mdl", pos)
    else if a.getTypeId() == 'hJ14'
        for j = 1 to 3
            pos = a.getPos()
            let u2 = createUnit(a.getOwner(), 'hJ0V', pos, bj_UNIT_FACING.fromDeg())
            u2.setTimedLife(360.0, 'BHwe')
            pos = u2.getPos()
            flashEffect("Abilities\\Spells\\Human\\MassTeleport\\MassTeleportCaster.mdl", pos)

