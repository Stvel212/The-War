// Триггер Just Fight: Ice Elemental ('hJ6W'), Ice Elemental ('hJ6X'), Ice Elemental ('hJ70'), Ice Elemental ('hJ71') — смерть
// ============================================================

@noinline
function iceElementalDeath()
    let dying = GetDyingUnit()
    let killer = GetKillingUnit()
    if not killer.isType(UNIT_TYPE_GIANT) and not killer.isType(UNIT_TYPE_TAUREN)
        return
    let pos = killer.getPos()
    let u = createUnit(dying.getOwner(), 'eJ6O', pos, bj_UNIT_FACING.fromDeg())
    u.setTimedLife(6.0, 'BHwe')
    if dying.getTypeId() == 'hJ6W'
        u.addAbility('AJ2D')
    else
        u.addAbility('AJ2F')
    u.issueTargetOrder("thunderbolt", killer)

// ============================================================
// Триггер Just Fight: Jaina (способность 'AJ2D'), Master Jaina (способность 'AJ2F') — применяет способность
// ============================================================

@noinline
function jainaCast(unit caster)
    let u = GetSpellTargetUnit()
    let n = GetSpellAbilityId()
    let u2 = caster
    var n2 = 0
    doPeriodically(1.0) cb ->
        n2 = n2 + 1
        if n2 <= 5
            if n == 'AJ2D'
                u2.damageTarget(u, 80.0, true, false, ATTACK_TYPE_NORMAL, DAMAGE_TYPE_FIRE, WEAPON_TYPE_WHOKNOWS)
            else
                u2.damageTarget(u, 180.0, true, false, ATTACK_TYPE_NORMAL, DAMAGE_TYPE_FIRE, WEAPON_TYPE_WHOKNOWS)
        else
            destroy cb
    let pos = caster.getPos()
    if caster.getAbilityLevel('AJ2B') == 1
        if GetSpellAbilityId() == 'AJ2D'
            if caster.getTypeId() == 'hJ6Y'
                createUnit(caster.getOwner(), 'hJ70', pos, GetUnitFacing(caster).fromDeg())
            else
                createUnit(caster.getOwner(), 'hJ6W', pos, GetUnitFacing(caster).fromDeg())
        else if caster.getTypeId() == 'hJ6Z'
            createUnit(caster.getOwner(), 'hJ71', pos, GetUnitFacing(caster).fromDeg())
        else
            createUnit(caster.getOwner(), 'hJ6X', pos, GetUnitFacing(caster).fromDeg())
        caster.setAbilityLevel('AJ2B', 3)
    else
        caster.decAbilityLevel('AJ2B')

