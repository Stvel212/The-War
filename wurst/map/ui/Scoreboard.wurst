package Scoreboard
import Initialization
import MapGlobals
import ClosureEvents
import ClosureTimers
import Profile
import GameMode

// ============================================================
// Триггер: LeaveGame — вышедший отдаёт контроль команде и переходит в «выбывшие»
// ============================================================

@noinline
function leaveGame()
    let p = GetTriggerPlayer()
    if p.getId() > 7
        return
    playerL[p.getId()] = true
    let left = forceG[1].containsPlayer(p)
    let team = left ? forceG[1] : forceG[2]
    for a = 0 to 7
        if team.containsPlayer(players[a])
            p.setPlayerAlliance(players[a], ALLIANCE_SHARED_CONTROL, true)
            p.setPlayerAlliance(players[a], ALLIANCE_SHARED_ADVANCED_CONTROL, true)
            p.setPlayerAlliance(players[a], ALLIANCE_SHARED_SPELLS, true)
    board.display(true)
    forceG[5].removePlayer(p)
    countPlayer[left ? 1 : 2] -= 1
    team.removePlayer(p)
    forceG[left ? 3 : 4].addPlayer(p)

// ============================================================
// Триггер: Multiboard2 — раз в 0.5 с обновляет таблицу, текст ресурсов и юниты-маркеры «силы»
// ============================================================

/** Пороги «силы» и юниты-маркеры (открывают доступ к покупкам), по возрастанию */
constant MARKER_TIERS = 11
int array markerForce
int array markerType
/** Маркеры [tier * 16 + player] */
unit array forceMarker

/** Пустой предмет 'I000' в слоте slot у юнита u убирается, когда выполнено условие */
function unit.freeSlot(int slot)
    if this.itemInSlot(slot).getTypeId() == 'I000'
        this.itemInSlot(slot).remove()

function multiboardItem(int row, int col, string value)
    board.getItem(row, col)
        ..setValue(value)
        ..release()

function multiboardIcon(int row, int col, string icon)
    board.getItem(row, col)
        ..setIcon(icon)
        ..release()

/*
    Всё, что показывается, кешируется: ячейки и текст переписываются только когда значение изменилось. Иначе каждые
    0.5 с для 8 игроков склеивались бы новые строки — в JASS строки интернируются и не освобождаются, таблица строк
    росла бы всю игру; а слоты/маркеры силы пересчитываются только при изменении power. */
int array lastForce
string array lastAvatar
int array lastGrades
int array lastIncome
int array lastForceItem
int array lastWisp
int array lastR000
int array lastR001
int array lastR002
int array lastGold
int array lastLumber
int array lastFoodUsed
int array lastFoodCap
bool array lastBoom
bool array lastRock
int array lastKingHP
int array lastHeal
int array lastAgi
int array lastInt
int array lastStr
/** PvE: здоровье генератора игрока, % (-1 — разрушен) и номер волны в строке Злого Бога */
int array lastGenerator
int lastWave = -1

/** Сила изменилась: освобождаются слоты строителя и обновляются юниты-маркеры */
function onForceChanged(int a, int value)
    let p = players[a]
    if value > 799
        builders[a].freeSlot(0)
    if value > 3999
        builders[a].freeSlot(1)
    if value > 5999
        builders[a].freeSlot(2)
    if value > 7999
        builders[a].freeSlot(3)
    if value > 9999
        builders[a].freeSlot(4)
    if value > 11999
        builders[a].freeSlot(5)
    // юниты-маркеры силы: есть, пока сила не ниже порога
    for tier = 0 to MARKER_TIERS - 1
        let i = tier * 16 + a
        if value >= markerForce[tier] and forceMarker[i] == null
            forceMarker[i] = createUnit(p, markerType[tier], vec2(0.0, 0.0))
        else if value < markerForce[tier] and forceMarker[i] != null
            forceMarker[i].remove()
            forceMarker[i] = null

function updatePlayerRow(int a)
    let p = players[a]
    let row = multiboardId[a + 1]
    let cur = power[a]
    let forceChanged = cur != lastForce[a]
    if forceChanged
        lastForce[a] = cur
        onForceChanged(a, cur)
    let grades = GetPlayerTechCount(p, 'R003', true)
    if grades != lastGrades[a]
        lastGrades[a] = grades
        if grades == 3
            arthas[a].freeSlot(0)
        if grades == 4
            arthas[a].freeSlot(1)
    if cur > 1000
        if income[a] != lastIncome[a]
            lastIncome[a] = income[a]
            multiboardItem(row, 1, "|cff33FF33+" + income[a] + "|r")
        if forceChanged or powerItem[a] != lastForceItem[a]
            lastForceItem[a] = powerItem[a]
            multiboardItem(row, 2, cur + "/|cffF00080" + powerItem[a] + "|r")
        let r000 = GetPlayerTechCount(p, 'R000', false)
        if wispCount[a] != lastWisp[a] or r000 != lastR000[a]
            lastWisp[a] = wispCount[a]
            lastR000[a] = r000
            multiboardItem(row, 3, "|cff00FFFF" + wispCount[a] + "|r/|cffFFA500" + r000 + "|r")
    let r001 = GetPlayerTechCount(p, 'R001', false)
    let r002 = GetPlayerTechCount(p, 'R002', false)
    if r001 != lastR001[a] or r002 != lastR002[a]
        lastR001[a] = r001
        lastR002[a] = r002
        multiboardItem(row, 4, "|cffFFA500" + r002 + "|r/|cff00FF00" + r001 + "|r")

function updateResourceText(int a)
    let p = players[a]
    let gold = p.getGold()
    let lumber = p.getLumber()
    let foodUsed = p.getState(PLAYER_STATE_RESOURCE_FOOD_USED)
    let foodCap = p.getState(PLAYER_STATE_RESOURCE_FOOD_CAP)
    if gold == lastGold[a] and lumber == lastLumber[a] and foodUsed == lastFoodUsed[a] and foodCap == lastFoodCap[a]
        return
    lastGold[a] = gold
    lastLumber[a] = lumber
    lastFoodUsed[a] = foodUsed
    lastFoodCap[a] = foodCap
    textR[a].setText("|cffFFFF00 Gold: " + gold + "|r|n|cff00FF00 Lumber: " + lumber
        + "|r|n|cffD2691E Food: " + foodUsed + "/" + foodCap + "|r", 10)

/** PvE: здоровье генератора игрока a в столбце «Generator» (бывший «Stone»: камня в PvE нет) */
function updateGenerator(int a, int row)
    let gen = generators[a]
    // 1..100: живой генератор не показывает 0%, а округление вверх давало 101% (HP чуть больше максимума)
    let pct = generatorAlive[a] and gen != null ? min(100, max(1, (100. * gen.getHP() / gen.getMaxHP()).round())) : -1
    if row != 0 and pct != lastGenerator[a]
        lastGenerator[a] = pct
        let color = pct > 50 ? "|cff00ff00" : (pct > 20 ? "|cffffcc00" : "|cffff4040")
        multiboardItem(row, 6, pct < 0 ? "|cffff4040destroyed|r" : color + pct + "%|r")

/** PvE: строка Злого Бога — здоровье и номер волны (лечений и улучшений у него нет) */
function updateEvilGod()
    let god = kings[2]
    let hp = god != null and god.isAlive() ? god.getHP().toInt() : 0
    if hp != lastKingHP[2]
        lastKingHP[2] = hp
        multiboardItem(kingS[2], 1, "|c0000FF00Health: " + hp + "|r")
    let wave = max(0, round - 1)
    if wave != lastWave
        lastWave = wave
        multiboardItem(kingS[4], 1, "|cffffcc00" + wave + "|r")

@noinline
function multiboardUpdate()
    for a = 0 to 7
        let row = multiboardId[a + 1]
        if row != 0
            updatePlayerRow(a)
            // аватарка профиля у ника (Profile): меняется после загрузки профиля и при выборе
            let avatar = players[a].avatarIcon()
            if avatar != lastAvatar[a]
                lastAvatar[a] = avatar
                board.getItem(row, 0)
                    ..setStyle(true, true)
                    ..setIcon(avatar)
                    ..release()
            if boom[a] != lastBoom[a]
                lastBoom[a] = boom[a]
                multiboardIcon(row, 5, boom[a] ? "icons\\BTNY.blp" : "ReplaceableTextures\\CommandButtons\\BTNCancel.blp")
            if isPve()
                updateGenerator(a, row)
            else if rock[a] != lastRock[a]
                lastRock[a] = rock[a]
                multiboardIcon(row, 6, rock[a] ? "icons\\BTNY.blp" : "ReplaceableTextures\\CommandButtons\\BTNCancel.blp")
        updateResourceText(a)
    if isPve()
        updateEvilGod()
    for a = 1 to (isPve() ? 1 : 2)
        let king = kings[a]
        let hp = king.getHP().toInt()
        if hp != lastKingHP[a]
            lastKingHP[a] = hp
            multiboardItem(kingS[a], 1, "|c0000FF00Health: " + hp + "|r")
        if heals[a] != lastHeal[a]
            lastHeal[a] = heals[a]
            multiboardItem(kingS[a], 2, "|cffFFff00Heals: " + heals[a] + "|r")
        let agi = (king.getAgi(true) - 60) div 10
        if agi != lastAgi[a]
            lastAgi[a] = agi
            multiboardItem(kingS[a + 2], 2, "|cffFF0000" + agi + "|r")
        let intel = (king.getInt(true) - 60) div 10
        if intel != lastInt[a]
            lastInt[a] = intel
            multiboardItem(kingS[a + 2], 4, "|cff00FF00" + intel + "|r")
        let str = (king.getStr(true) - 60) div 10
        if str != lastStr[a]
            lastStr[a] = str
            multiboardItem(kingS[a + 2], 6, "|cff0000FF" + str + "|r")

// ============================================================
// Триггер: MultiboardClassic — через секунду после старта строит таблицу и включает обновление
// ============================================================

function headerCell(int col, string value, real width)
    board.getItem(0, col)
        ..setValue(value)
        ..setStyle(true, false)
        ..setWidth(width)
        ..release()

function textCell(int row, int col, string value, real width)
    board.getItem(row, col)
        ..setStyle(true, false)
        ..setValue(value)
        ..setWidth(width)
        ..release()

function iconCell(int row, int col, string icon, real width)
    board.getItem(row, col)
        ..setStyle(false, true)
        ..setIcon(icon)
        ..setWidth(width)
        ..release()

/** Строки таблицы. PvP/PvEvP: игроки 1-4, король 1 + его улучшения, игроки 5-8, король 2 + его улучшения.
    PvE — одна команда: Бог Войны + улучшения, все игроки, Злой Бог + номер волны. Возвращает число строк */
function layoutRows() returns int
    var b = 1
    if isPve()
        kingS[1] = b
        kingS[3] = b + 1
        b += 2
    for a = 1 to 8
        multiboardId[a] = 0
        if a == 5 and not isPve()
            kingS[1] = b
            kingS[3] = b + 1
            b += 2
        if isInGame(players[a - 1])
            multiboardId[a] = b
            multiboardIdR[b] = a
            b++
    kingS[2] = b
    kingS[4] = b + 1
    return b + 2

/** Построить таблицу заново (при старте и в PvE после выбора режима) */
function buildBoard()
    if board != null
        board.display(false)
        board.destr()
    let rows = layoutRows()
    board = CreateMultiboard()
        ..setRowCount(rows)
        ..setColumnCount(7)
        ..setTitle("The War Reborn " + modeString)
    headerCell(0, "Player", 0.10)
    headerCell(1, "Income", 0.05)
    headerCell(2, "Power", 0.05)
    headerCell(3, "Grades", 0.05)
    headerCell(4, "Mid Up", 0.05)
    headerCell(5, "Blast", 0.04)
    // PvE: камня нет — вместо него здоровье генератора энергии игрока
    headerCell(6, isPve() ? "Generator" : "Stone", isPve() ? 0.065 : 0.04)
    for a = 1 to 8
        let row = multiboardId[a]
        if row != 0
            let p = players[a - 1]
            textCell(row, 0, "|c00" + colorCode[a - 1] + p.getName() + "|r", 0.10)
            textCell(row, 1, "|cff33FF33+" + income[a - 1] + "|r", 0.05)
            textCell(row, 2, power[a - 1] + "/" + powerItem[a - 1], 0.05)
            textCell(row, 3, wispCount[a - 1] + "/" + GetPlayerTechCount(players[a], 'R000', false), 0.05)
            textCell(row, 4, "", 0.05)
            iconCell(row, 5, boom[a] ? "" : "ReplaceableTextures\\CommandButtons\\BTNCancel.blp", 0.04)
            if isPve()
                textCell(row, 6, "", 0.065)
            else
                iconCell(row, 6, rock[a] ? "" : "ReplaceableTextures\\CommandButtons\\BTNCancel.blp", 0.04)
    for a = 1 to 2
        let evilGod = isPve() and a == 2
        let name = isPve() ? (evilGod ? "|cffff0000Evil God|r" : "|cffFFD700War God|r") : "|cffFFD700King " + a + " |r"
        textCell(kingS[a], 0, name, 0.11)
        textCell(kingS[a], 1, "|c0000FF00Health: " + (kings[a] != null ? kings[a].getHP().toInt() : 0) + "|r", 0.08)
        textCell(kingS[a], 2, evilGod ? "" : "|cffFFff00Heals:" + heals[a] + "|r", 0.06)
        for col = 3 to 6
            textCell(kingS[a], col, "", 0.02)
        if evilGod
            // у Злого Бога нет лечений и улучшений — номер волны
            textCell(kingS[4], 0, "|cffFFA500Wave:|r", 0.09)
            for col = 1 to 6
                textCell(kingS[4], col, "", col == 1 ? 0.04 : 0.02)
        else
            textCell(kingS[a + 2], 0, "|cffFFA500Upgrades: |r", 0.09)
            iconCell(kingS[a + 2], 1, "ReplaceableTextures\\CommandButtons\\BTNAttack.blp", 0.02)
            textCell(kingS[a + 2], 2, "0", 0.03)
            iconCell(kingS[a + 2], 3, "ReplaceableTextures\\CommandButtons\\BTNAnimalWarTraining.blp", 0.02)
            textCell(kingS[a + 2], 4, "0", 0.03)
            iconCell(kingS[a + 2], 5, "ReplaceableTextures\\CommandButtons\\BTNHealOff.blp", 0.02)
            textCell(kingS[a + 2], 6, "0", 0.03)
    board.display(false)
    board.display(true)
    board.minimize()
    board.maximize()
    // кеш «последних показанных значений» сбрасывается, чтобы первое обновление записало всё
    for a = 0 to 7
        lastForce[a] = -1
        lastAvatar[a] = ""
        lastGrades[a] = -1
        lastIncome[a] = -1
        lastForceItem[a] = -1
        lastWisp[a] = -1
        lastR000[a] = -1
        lastR001[a] = -1
        lastR002[a] = -1
        lastGold[a] = -1
        lastBoom[a] = not boom[a]
        lastRock[a] = not rock[a]
        lastGenerator[a] = -2
    for a = 1 to 2
        lastKingHP[a] = -1
        lastHeal[a] = -1
        lastAgi[a] = -1
        lastInt[a] = -1
        lastStr[a] = -1
    lastWave = -1

@noinline
function multiboardCreate()
    for a = 1 to 8
        if isInGame(players[a - 1])
            let p = players[a - 1]
            wDammiHP(kings[1], 1050)
            wDammiHP(kings[2], 1050)
            forceG[5].addPlayer(p)
            let team = a <= 4 ? 1 : 2
            heals[team] += 1
            countPlayer[team] += 1
    teamSize = max(countPlayer[1], countPlayer[2])
    buildBoard()
    doPeriodically(0.5) cb ->
        multiboardUpdate()


init
    markerForce[0] = 600
    markerType[0] = 'e005'
    markerForce[1] = 1000
    markerType[1] = 'e100'
    markerForce[2] = 1500
    markerType[2] = 'e01C'
    markerForce[3] = 2000
    markerType[3] = 'e00Z'
    markerForce[4] = 4000
    markerType[4] = 'e010'
    markerForce[5] = 5000
    markerType[5] = 'e101'
    markerForce[6] = 6000
    markerType[6] = 'e011'
    markerForce[7] = 8000
    markerType[7] = 'e018'
    markerForce[8] = 10000
    markerType[8] = 'e019'
    markerForce[9] = 12000
    markerType[9] = 'e01A'
    markerForce[10] = 14000
    markerType[10] = 'e01B'
    EventListener.add(EVENT_PLAYER_LEAVE) ->
        leaveGame()
    onRound() r ->
        // PvE — одна команда: таблица строится заново (при старте режим ещё не выбран)
        if r == 1 and isPve() and board != null
            buildBoard()
    doAfter(1.0) ->
        multiboardCreate()
