package Scoreboard
import Initialization
import MapGlobals
import ClosureEvents
import ClosureTimers

// ============================================================
// Триггер: LeaveGame — вышедший отдаёт контроль команде и переходит в «выбывшие»
// ============================================================

@noinline
function leaveGame()
    let p = GetTriggerPlayer()
    if p.getId() > 7
        return
    PlayerL[p.getId()] = true
    let left = ForceG[1].containsPlayer(p)
    let team = left ? ForceG[1] : ForceG[2]
    for a = 0 to 7
        if team.containsPlayer(players[a])
            p.setPlayerAlliance(players[a], ALLIANCE_SHARED_CONTROL, true)
            p.setPlayerAlliance(players[a], ALLIANCE_SHARED_ADVANCED_CONTROL, true)
            p.setPlayerAlliance(players[a], ALLIANCE_SHARED_SPELLS, true)
    udg_Board.display(true)
    ForceG[5].removePlayer(p)
    CountPlayer[left ? 1 : 2] -= 1
    team.removePlayer(p)
    ForceG[left ? 3 : 4].addPlayer(p)

// ============================================================
// Триггер: Multiboard2 — раз в 0.5 с обновляет таблицу, текст ресурсов и юниты-маркеры «силы»
// ============================================================

/** Пороги «силы» и юниты-маркеры (открывают доступ к покупкам), по возрастанию */
constant MARKER_TIERS = 11
int array markerForce
int array markerType
/** Маркеры [tier * 16 + player] */
unit array forceMarker

/** Пустой предмет 'I000' в слоте slot у юнита u убирается, когда выполнено условие */
function unit.freeSlot(int slot)
    if this.itemInSlot(slot).getTypeId() == 'I000'
        this.itemInSlot(slot).remove()

function multiboardItem(int row, int col, string value)
    udg_Board.getItem(row, col)
        ..setValue(value)
        ..release()

function multiboardIcon(int row, int col, string icon)
    udg_Board.getItem(row, col)
        ..setIcon(icon)
        ..release()

/*
    Всё, что показывается, кешируется: ячейки и текст переписываются только когда значение изменилось. Иначе каждые
    0.5 с для 8 игроков склеивались бы новые строки — в JASS строки интернируются и не освобождаются, таблица строк
    росла бы всю игру; а слоты/маркеры силы пересчитываются только при изменении Force. */
int array lastForce
int array lastGrades
int array lastIncome
int array lastForceItem
int array lastWisp
int array lastR000
int array lastR001
int array lastR002
int array lastGold
int array lastLumber
int array lastFoodUsed
int array lastFoodCap
bool array lastBoom
bool array lastRock
int array lastKingHP
int array lastHeal
int array lastAgi
int array lastInt
int array lastStr

/** Сила изменилась: освобождаются слоты строителя и обновляются юниты-маркеры */
function onForceChanged(int a, int power)
    let p = players[a]
    if power > 799
        Builder[a].freeSlot(0)
    if power > 3999
        Builder[a].freeSlot(1)
    if power > 5999
        Builder[a].freeSlot(2)
    if power > 7999
        Builder[a].freeSlot(3)
    if power > 9999
        Builder[a].freeSlot(4)
    if power > 11999
        Builder[a].freeSlot(5)
    // юниты-маркеры силы: есть, пока сила не ниже порога
    for tier = 0 to MARKER_TIERS - 1
        let i = tier * 16 + a
        if power >= markerForce[tier] and forceMarker[i] == null
            forceMarker[i] = CreateUnit(p, markerType[tier], 0.0, 0.0, 0.0)
        else if power < markerForce[tier] and forceMarker[i] != null
            forceMarker[i].remove()
            forceMarker[i] = null

function updatePlayerRow(int a)
    let p = players[a]
    let row = multiboardId[a + 1]
    let power = Force[a]
    let forceChanged = power != lastForce[a]
    if forceChanged
        lastForce[a] = power
        onForceChanged(a, power)
    let grades = GetPlayerTechCount(p, 'R003', true)
    if grades != lastGrades[a]
        lastGrades[a] = grades
        if grades == 3
            Arthas[a].freeSlot(0)
        if grades == 4
            Arthas[a].freeSlot(1)
    if power > 1000
        if Income[a] != lastIncome[a]
            lastIncome[a] = Income[a]
            multiboardItem(row, 1, "|cff33FF33+" + Income[a].toString() + "|r")
        if forceChanged or ForceItem[a] != lastForceItem[a]
            lastForceItem[a] = ForceItem[a]
            multiboardItem(row, 2, power.toString() + "/|cffF00080" + ForceItem[a].toString() + "|r")
        let r000 = GetPlayerTechCount(p, 'R000', false)
        if Wisp[a] != lastWisp[a] or r000 != lastR000[a]
            lastWisp[a] = Wisp[a]
            lastR000[a] = r000
            multiboardItem(row, 3, "|cff00FFFF" + Wisp[a].toString() + "|r/|cffFFA500" + r000.toString() + "|r")
    let r001 = GetPlayerTechCount(p, 'R001', false)
    let r002 = GetPlayerTechCount(p, 'R002', false)
    if r001 != lastR001[a] or r002 != lastR002[a]
        lastR001[a] = r001
        lastR002[a] = r002
        multiboardItem(row, 4, "|cffFFA500" + r002.toString() + "|r/|cff00FF00" + r001.toString() + "|r")

function updateResourceText(int a)
    let p = players[a]
    let gold = p.getGold()
    let lumber = p.getLumber()
    let foodUsed = p.getState(PLAYER_STATE_RESOURCE_FOOD_USED)
    let foodCap = p.getState(PLAYER_STATE_RESOURCE_FOOD_CAP)
    if gold == lastGold[a] and lumber == lastLumber[a] and foodUsed == lastFoodUsed[a] and foodCap == lastFoodCap[a]
        return
    lastGold[a] = gold
    lastLumber[a] = lumber
    lastFoodUsed[a] = foodUsed
    lastFoodCap[a] = foodCap
    TextR[a].setText("|cffFFFF00 Gold: " + gold.toString() + "|r|n|cff00FF00 Lumber: " + lumber.toString()
        + "|r|n|cffD2691E Food: " + foodUsed.toString() + "/" + foodCap.toString() + "|r", 10)

@noinline
function multiboardUpdate()
    for a = 0 to 7
        let row = multiboardId[a + 1]
        if row != 0
            updatePlayerRow(a)
        if Boom[a] != lastBoom[a]
            lastBoom[a] = Boom[a]
            multiboardIcon(row, 5, Boom[a] ? "icons\\BTNY.blp" : "ReplaceableTextures\\CommandButtons\\BTNCancel.blp")
        if Rock[a] != lastRock[a]
            lastRock[a] = Rock[a]
            multiboardIcon(row, 6, Rock[a] ? "icons\\BTNY.blp" : "ReplaceableTextures\\CommandButtons\\BTNCancel.blp")
        updateResourceText(a)
    for a = 1 to 2
        let king = King[a]
        let hp = king.getHP().toInt()
        if hp != lastKingHP[a]
            lastKingHP[a] = hp
            multiboardItem(KingS[a], 1, "|c0000FF00Health: " + hp.toString() + "|r")
        if Heal[a] != lastHeal[a]
            lastHeal[a] = Heal[a]
            multiboardItem(KingS[a], 2, "|cffFFff00Heals: " + Heal[a].toString() + "|r")
        let agi = (king.getAgi(true) - 60) div 10
        if agi != lastAgi[a]
            lastAgi[a] = agi
            multiboardItem(KingS[a + 2], 2, "|cffFF0000" + agi.toString() + "|r")
        let intel = (king.getInt(true) - 60) div 10
        if intel != lastInt[a]
            lastInt[a] = intel
            multiboardItem(KingS[a + 2], 4, "|cff00FF00" + intel.toString() + "|r")
        let str = (king.getStr(true) - 60) div 10
        if str != lastStr[a]
            lastStr[a] = str
            multiboardItem(KingS[a + 2], 6, "|cff0000FF" + str.toString() + "|r")

// ============================================================
// Триггер: MultiboardClassic — через секунду после старта строит таблицу и включает обновление
// ============================================================

function headerCell(int col, string value, real width)
    udg_Board.getItem(0, col)
        ..setValue(value)
        ..setStyle(true, false)
        ..setWidth(width)
        ..release()

function textCell(int row, int col, string value, real width)
    udg_Board.getItem(row, col)
        ..setStyle(true, false)
        ..setValue(value)
        ..setWidth(width)
        ..release()

function iconCell(int row, int col, string icon, real width)
    udg_Board.getItem(row, col)
        ..setStyle(false, true)
        ..setIcon(icon)
        ..setWidth(width)
        ..release()

@noinline
function multiboardCreate()
    // строки: игроки 1-4, король 1 + его улучшения, игроки 5-8, король 2 + его улучшения
    var b = 1
    for a = 1 to 8
        if a == 5
            KingS[1] = b
            KingS[3] = b + 1
            b += 2
        if isInGame(players[a - 1])
            multiboardId[a] = b
            multiboardIdR[b] = a
            b++
        if a == 8
            KingS[2] = b
            KingS[4] = b + 1
            b += 2
    udg_Board = CreateMultiboard()
        ..setRowCount(b)
        ..setColumnCount(7)
        ..setTitle("The War Reborn " + ModeString)
    bj_lastCreatedMultiboard = CreateMultiboard()
    headerCell(0, "Player", 0.07)
    headerCell(1, "Income", 0.05)
    headerCell(2, "Power", 0.05)
    headerCell(3, "Grades", 0.05)
    headerCell(4, "Mid Up", 0.04)
    headerCell(5, "Blast", 0.03)
    headerCell(6, "Stone", 0.04)
    for a = 1 to 8
        let row = multiboardId[a]
        if row != 0
            let p = players[a - 1]
            wDammiHP(King[1], 1050)
            wDammiHP(King[2], 1050)
            ForceG[5].addPlayer(p)
            let team = a <= 4 ? 1 : 2
            Heal[team] += 1
            CountPlayer[team] += 1
            textCell(row, 0, "|c00" + Color[a - 1] + p.getName() + "|r", 0.07)
            textCell(row, 1, "|cff33FF33+" + Income[a - 1].toString() + "|r", 0.05)
            textCell(row, 2, Force[a - 1].toString() + "/" + ForceItem[a - 1].toString(), 0.05)
            textCell(row, 3, Wisp[a - 1].toString() + "/" + GetPlayerTechCount(players[a], 'R000', false).toString(), 0.05)
            textCell(row, 4, "", 0.04)
            iconCell(row, 5, Boom[a] ? "" : "ReplaceableTextures\\CommandButtons\\BTNCancel.blp", 0.04)
            iconCell(row, 6, Rock[a] ? "" : "ReplaceableTextures\\CommandButtons\\BTNCancel.blp", 0.04)
    for a = 1 to 2
        textCell(KingS[a], 0, "|cffFFD700King " + a.toString() + " |r", 0.08)
        textCell(KingS[a], 1, "|c0000FF00Health: " + King[a].getHP().toInt().toString() + "|r", 0.08)
        textCell(KingS[a], 2, "|cffFFff00Heals:" + Heal[a].toString() + "|r", 0.06)
        for col = 3 to 6
            textCell(KingS[a], col, "", 0.02)
        textCell(KingS[a + 2], 0, "|cffFFA500Upgrades: |r", 0.06)
        iconCell(KingS[a + 2], 1, "ReplaceableTextures\\CommandButtons\\BTNAttack.blp", 0.02)
        textCell(KingS[a + 2], 2, "0", 0.03)
        iconCell(KingS[a + 2], 3, "ReplaceableTextures\\CommandButtons\\BTNAnimalWarTraining.blp", 0.02)
        textCell(KingS[a + 2], 4, "0", 0.03)
        iconCell(KingS[a + 2], 5, "ReplaceableTextures\\CommandButtons\\BTNHealOff.blp", 0.02)
        textCell(KingS[a + 2], 6, "0", 0.03)
    udg_Board.display(false)
    udg_Board.display(true)
    MultiboardMinimize(udg_Board, true)
    MultiboardMinimize(udg_Board, false)
    // кеш «последних показанных значений» сбрасывается, чтобы первое обновление записало всё
    for a = 0 to 7
        lastForce[a] = -1
        lastGrades[a] = -1
        lastIncome[a] = -1
        lastForceItem[a] = -1
        lastWisp[a] = -1
        lastR000[a] = -1
        lastR001[a] = -1
        lastR002[a] = -1
        lastGold[a] = -1
        lastBoom[a] = not Boom[a]
        lastRock[a] = not Rock[a]
    for a = 1 to 2
        lastKingHP[a] = -1
        lastHeal[a] = -1
        lastAgi[a] = -1
        lastInt[a] = -1
        lastStr[a] = -1
    doPeriodically(0.5) cb ->
        multiboardUpdate()

init
    markerForce[0] = 600
    markerType[0] = 'e005'
    markerForce[1] = 1000
    markerType[1] = 'e100'
    markerForce[2] = 1500
    markerType[2] = 'e01C'
    markerForce[3] = 2000
    markerType[3] = 'e00Z'
    markerForce[4] = 4000
    markerType[4] = 'e010'
    markerForce[5] = 5000
    markerType[5] = 'e101'
    markerForce[6] = 6000
    markerType[6] = 'e011'
    markerForce[7] = 8000
    markerType[7] = 'e018'
    markerForce[8] = 10000
    markerType[8] = 'e019'
    markerForce[9] = 12000
    markerType[9] = 'e01A'
    markerForce[10] = 14000
    markerType[10] = 'e01B'
    EventListener.add(EVENT_PLAYER_LEAVE) ->
        leaveGame()
    doAfter(1.0) ->
        multiboardCreate()
