package Initialization
import MMD
import MapGlobals
import UnitEvents
import ClosureTimers
import ClosureForGroups

// ============================================================
// Общие помощники (используются всеми пакетами карты)
// ============================================================

/** Юниты некроманта, которым нельзя давать баффы «на всех» */
public function zapret_Necr(unit u) returns bool
    let t = u.getTypeId()
    return t == 'u00P' or t == 'u00C' or t == 'u005' or t == 'u00X' or t == 'u00W' or t == 'u00V' or t == 'u00S' or t == 'u00Y' or t == 'n014' or t == 'n017' or t == 'n015' or t == 'n013'

/** Игрок в игре и им управляет человек */
public function isInGame(player p) returns bool
    return p.getSlotState() == PLAYER_SLOT_STATE_PLAYING and p.getController() == MAP_CONTROL_USER

/** Левая команда: игроки 0-3 и их король (8); остальные (4-7, 9) — правая */
public function player.isLeftTeam() returns bool
    return this.getId() < 4 or this.getId() == 8

/** Приказ идти в атаку по своей линии на высоте y: левая команда — вправо (x = 2750), правая — влево (x = -3300) */
public function unit.attackLane(real y)
    this.issuePointOrder("attack", vec2(this.getOwner().isLeftTeam() ? 2750.0 : -3300.0, y))

/** Приказ идти в атаку по своей линии (по своей высоте) */
public function unit.attackLane()
    this.attackLane(this.getY())

/** Лимит построек типа t */
public function player.limit(int n, int t)
    SetPlayerTechMaxAllowed(this, t, n)

public function addManaToUnits(unit u, real amount)
    u.setMana(u.getMana() + amount)

/** Всплывающий текст над юнитом c: size — размер, time — время жизни; z: 128 — уходит вправо-вверх, 127 — влево-вверх, иначе высота */
public function text(unit c, string s, real size, real time, real z)
    var height = z
    var tilt = 0
    if z == 128
        height = 50.0
        tilt = 30
    else if z == 127
        height = 50.0
        tilt = -30
    let tt = CreateTextTag()
    SetTextTagPosUnit(tt, c, height)
    tt..setText(s, size)   // размер в пунктах: stdlib сам умножает на 0.0023
        ..setColor(100, 100, 100, 255)
        ..setVelocity(0.0666 * Cos((90.00 + tilt) * 0.01745), 0.0666 * Sin((90.00 + tilt) * 0.01745))
        ..setPermanent(false)
        ..setLifespan(time)
        ..setFadepoint(time * 0.66)

/** Всплывающее «+N» золота над юнитом, видное только игроку p (у остальных пустой текст, как в оригинале) */
public function goldText(unit at, player p, int gold)
    text(at, localPlayer == p ? "|cffFFFF00+" + gold.toString() + "|r" : "", 10.0, 3.50, 50.0)

/** Цена юнита в «еде» ×2 (по базовому типу из EFFECT_TYPE_TARGET), а если нет — из таблицы getUnitFood по типу t */
public function unitGold(unit u, int t) returns int
    let food = 2 * GetFoodUsed(UnitId(GetAbilityEffectById(u.getTypeId(), EFFECT_TYPE_TARGET, 0)))
    return food == 0 ? getUnitFood(t) : food

/** +hp к максимуму здоровья (и к текущему, как давала бывшая способность-бонус 'A1ZV') */
public function wDammiHP(unit c, int hp)
    c.setMaxHP(c.getIntMaxHP() + hp)
    c.setHP(c.getHP() + hp)

/** +mp к максимуму маны (и к текущей, как давала бывшая способность-бонус 'A1ZT') */
public function wDammiMP(unit c, int mp)
    c.setMaxMana(c.getIntMaxMana() + mp)
    c.setMana(c.getMana() + mp)

/** +amount к базовому урону (раньше — через предметы-бонусы 'I1ZA'..'I1ZD') */
public function wDammiAtt(unit u, int amount)
    if amount > 0
        u.setBaseDamage(u.getBaseDamage(0) + amount, 0)

/** «Еда» юнита по типу для тех, у кого её нет в объекте (награда за убийство/продажу) */
public function getUnitFood(int t) returns int
    if t == 'h01L' or t == 'n03J' or t == 'u00S' or t == 'h007' or t == 'h00L' or t == 'n03W' or t == 'ucs1'
        return 1
    else if t == 'n03H' or t == 'u00N' or t == 'n047' or t == 'u00Y'
        return 2
    else if t == 'n03F' or t == 'n015' or t == 'n016' or t == 'n046' or t == 'n03Y'
        return 4
    else if t == 'n03E' or t == 'npn1' or t == 'npn2' or t == 'npn3'
        return 6
    else if t == 'h01O' or t == 'h01N' or t == 'o00V' or t == 'o00U' or t == 'h01P' or t == 'h01Q' or t == 'n004' or t == 'n005'
        return 6
    else if t == 'n03L' or t == 'n03D'
        return 7
    else if t == 'n03K'
        return 8
    else if t == 'n03S' or t == 'n03R'
        return 10
    else if t == 'n03M'
        return 12
    else if t == 'n03T'
        return 15
    else if t == 'n03C'
        return 22
    else if t == 'n03G'
        return 30
    else if t == 'n03A'
        return 40
    return 0

// ============================================================
// Случайный набор зданий (репик): по одному зданию из каждого «тира»
// ============================================================

/** Сколько вариантов в тире 1..10 */
function tierSize(int tier) returns int
    if tier == 1 or tier == 6 or tier == 8 or tier == 9
        return 9
    else if tier == 3 or tier == 5 or tier == 7
        return 10
    return 8

/** Тип здания № i тира tier */
function tierType(int tier, int i) returns int
    if tier == 1
        return OneTear[i]
    else if tier == 2
        return TwoTear[i]
    else if tier == 3
        return ThreeTear[i]
    else if tier == 4
        return FourTear[i]
    else if tier == 5
        return FiveTear[i]
    else if tier == 6
        return SixTear[i]
    else if tier == 7
        return SevenTear[i]
    else if tier == 8
        return EightTear[i]
    else if tier == 9
        return NineTear[i]
    return TenTear[i]

/** Случайный вариант тира, не совпадающий с прошлым (Repick), разрешается игроку с лимитом limit */
function pickTier(player p, int tier, int limit)
    let size = tierSize(tier)
    let last = Repick[tier + 10 * p.getId()]
    var r = GetRandomInt(1, size)
    if r == last
        r = r == size ? size - 1 : r + 1
    Repick[tier + 10 * p.getId()] = r
    SetPlayerTechMaxAllowed(p, tierType(tier, r), limit)

/** Замена набора зданий игрока: всё запретить, потом по одному случайному из каждого тира (герои 8-9 — если героя ещё нет) */
public function random(player p)
    DisplayTextToPlayer(p, 0.0, 0.0, "|c0000FF80Replacement complete!|r")
    for i = 1 to 95
        SetPlayerTechMaxAllowed(p, AllTear[i], 0)
    for tier = 1 to 7
        pickTier(p, tier, 999)
    if not Hero[p.getId()]
        pickTier(p, 8, 1)
        pickTier(p, 9, 1)
    pickTier(p, 10, 999)

