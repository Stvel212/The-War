    // дохода (за игру 1 монета в минуту до 60 + 30 за победу) и силы прибавки: только вид — как обычный скин Артаса (80),
    // небольшая прибавка всегда — 120, сильная в PvE — 180, урон ×2 в PvE — 300
    skin(FAMILY_ARTHAS, 'hAF1', "Mini Storm War God", 120)
    skin(FAMILY_ARTHAS, 'hAF2', "Mini War God of Earth", 120)
    skin(FAMILY_ARTHAS, 'hAF3', "Mini Fire War God", 120)
    skin(FAMILY_ARTHAS, 'Eevi', "Mini Lil'idan (Evil God)", 300)
