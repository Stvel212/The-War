    skin(FAMILY_ARTHAS, 'Nalc', "Alchemist", 180)
    skin(FAMILY_ARTHAS, 'Nbrn', "Dark Ranger", 180)
    onEnter(function onUnitEnter)
    // профиль загружен — разобрать скины и надеть на то, что уже стоит
    onProfileChange() p ->
        if profileReady[p.getId()] and not parsed[p.getId()]
            parsed[p.getId()] = true
            readProfile(p)
            applyAll(p, -1)
