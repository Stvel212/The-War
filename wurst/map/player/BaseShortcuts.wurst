package BaseShortcuts
import TableUi
import ClosureKeyPresses
import ClosureTimers
import GameTimer
import PreplacedBuildings
import MapGlobals

/*
    Быстрый выбор зданий базы (как в Legion TD): столбец иконок слева под панелью героев и клавиши F2..F4, F6..F8
    (F1 — строитель, это панель героев игры). Иконка/клавиша выделяет здание, повторное нажатие в течение
    DOUBLE_PRESS с — ещё и наводит камеру. Порядок: Главное здание (baza, его тип зависит от скина),
    затем baseBuildingTypes — Алтарь Короля, Алтарь Вызова, два Дома Странника, Флаг.
    Раньше это были невидимые герои-ярлыки на панели героев, но плашку уровня/здоровья героя не спрятать
    (Aloc запрещает выбор, высота полёта всё равно попадает в кадр) — поэтому своя панель.
    Клики и клавиши — синхронные события; локально только выделение и камера. */

/** Размер иконки — как у кнопки героя на панели героев */
constant ICON = 0.038
constant GAP = 0.004
/** Отступ столбца от низа кнопки первого героя (строителя) */
constant BELOW_HERO = 0.012
constant DOUBLE_PRESS = 0.4
/** Кнопок в столбце: главное здание + здания baseBuildingTypes */
constant SHORTCUTS = BASE_BUILDINGS + 1

/** Время последнего выбора здания k игроком a: lastPress[a * SHORTCUTS + k] */
real array lastPress

function iconOf(int k) returns string
    switch k
        case 0
            return "ReplaceableTextures\\CommandButtons\\BTN3M3.blp"
        case 1
            return "ReplaceableTextures\\CommandButtons\\BTNAltarOfKings.blp"
        case 2
            return "ReplaceableTextures\\CommandButtons\\BTNArthas.blp"
        case 5
            return "ReplaceableTextures\\CommandButtons\\BTNHumanCaptureFlag.blp"
        default
            return "ReplaceableTextures\\CommandButtons\\BTNHornOfCenarius.blp"

function nameOf(int k) returns string
    switch k
        case 0
            return "Main Building"
        case 1
            return "Altar of the King"
        case 2
            return "Altar of Summoning"
        case 5
            return "Flag"
        default
            return "Wanderer's House"

/** Номер F-клавиши кнопки k: F2..F4, F6..F8 — F5 пропущена, это «Быстрое сохранение» игры
    (его хоткей картой не перехватить, нажатие сохраняло бы игру) */
function keyNumber(int k) returns int
    return k < 3 ? k + 2 : k + 3

function keyOf(int k) returns oskeytype
    switch keyNumber(k)
        case 2
            return OSKEY_F2
        case 3
            return OSKEY_F3
        case 4
            return OSKEY_F4
        case 6
            return OSKEY_F6
        case 7
            return OSKEY_F7
        default
            return OSKEY_F8

/** Здание k столбца игрока a: 0 — главное здание (пересоздаётся при смене скина, поэтому берётся каждый раз) */
function buildingOf(int a, int k) returns unit
    return k == 0 ? baza[a] : baseBuildings[a * BASE_BUILDINGS + k - 1]


/** Игрок p выбрал здание k своей базы: выделить его; повторно за DOUBLE_PRESS с — навести камеру */
function pick(player p, int k)
    let a = p.getId()
    if a >= 8
        return
    let i = a * SHORTCUTS + k
    let b = buildingOf(a, k)
    if b == null
        return
    let now = getElapsedGameTime()
    let twice = now - lastPress[i] < DOUBLE_PRESS
    lastPress[i] = now
    if localPlayer == p
        ClearSelection()
        SelectUnit(b, true)
        if twice
            PanCameraToTimed(b.getX(), b.getY(), 0.)

/** Где показывать подсказку: правый нижний угол над командной карточкой, как подсказки самой игры */
public constant TOOLTIP_CORNER = vec2(0.79, 0.172)

/** Подсказка кнопки — в углу над командной карточкой, а не над кнопкой: подсказка wurst-table-layout
    (boxedTooltip) — фон, натянутый на текст (его первый дочерний фрейм), а текст привязан к кнопке;
    перепривязываем текст к углу экрана, фон едет вместе с ним */
public function framehandle.cornerTooltip(string text) returns framehandle
    return this.cornerTooltip(text, 0.18)

public function framehandle.cornerTooltip(string text, real width) returns framehandle
    let box = boxedTooltip(this, text, width)
    box.getChild(0)
        ..clearAllPoints()
        ..setAbsPoint(FRAMEPOINT_BOTTOMRIGHT, TOOLTIP_CORNER)
    return this


/** Столбец иконок игрока owner (строится у всех клиентов, виден только ему; у наблюдателей базы нет) */
function buildColumn(player owner) returns framehandle
    if owner.getId() >= 8
        return null
    // родитель ConsoleUIBackdrop: столбец стоит за краем области 4:3 (под кнопкой героя), а обычные фреймы
    // (родитель GAME_UI) за 4:3 не рисуются — так велит WC3_FRAMEHANDLE_GUIDE библиотеки wurst-table-layout
    let root = container(BlzGetFrameByName("ConsoleUIBackdrop", 0), ICON, SHORTCUTS * ICON + (SHORTCUTS - 1) * GAP)
    for k = 0 to SHORTCUTS - 1
        let index = k
        iconButton(root, iconOf(k), ICON)
            ..setPoint(FRAMEPOINT_TOPLEFT, root, FRAMEPOINT_TOPLEFT, 0., -k * (ICON + GAP))
            ..cornerTooltip(nameOf(k) + " (F" + keyNumber(k) + ")")
            ..onClick(() -> pick(owner, index))
    // прямо под кнопкой первого героя (строителя): она за краем области 4:3, поэтому привязка к самой кнопке,
    // а не к координатам — так столбец стоит под ней при любом соотношении сторон экрана
    root.setPoint(FRAMEPOINT_TOPLEFT, BlzGetOriginFrame(ORIGIN_FRAME_HERO_BUTTON, 0), FRAMEPOINT_BOTTOMLEFT, 0., -BELOW_HERO)
    return root

/** Свой герой у игрока один — строитель (кнопка 0). Кнопки 1+ появляются только у взявшего под контроль короля
    (King.kingControl меняет владельца) — их прячем после смены владельца. Только видимость: панель героев целиком
    прятать нельзя — игра падала, добавляя героя на спрятанную панель (особый строитель по нику в 1-м раунде) */
public function hideExtraHeroButtons()
    for i = 1 to 6
        BlzFrameSetVisible(BlzGetOriginFrame(ORIGIN_FRAME_HERO_BUTTON, i), false)
        BlzFrameSetVisible(BlzGetOriginFrame(ORIGIN_FRAME_HERO_HP_BAR, i), false)
        BlzFrameSetVisible(BlzGetOriginFrame(ORIGIN_FRAME_HERO_MANA_BAR, i), false)
        BlzFrameSetVisible(BlzGetOriginFrame(ORIGIN_FRAME_HERO_BUTTON_INDICATOR, i), false)

init
    for a = 0 to 7
        for k = 0 to SHORTCUTS - 1
            let index = k
            onKeyPress(players[a], keyOf(k)) ->
                pick(GetTriggerPlayer(), index)
    // UI — после блокирующего init (так требует TableLayout)
    doAfter(0.0) ->
        perPlayerFrames(owner -> buildColumn(owner)).showEach()
