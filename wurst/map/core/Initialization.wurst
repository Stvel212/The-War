/** Обязательное открытое задание в списке F9 */
function addQuest(string title, string description, string icon)
    CreateQuest()
        ..setTitle(title)
        ..setDescription(description)
        ..setIcon(icon)
        ..setRequired(true)
        ..discovered(true)

