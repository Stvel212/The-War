public function initGame()
    for i = 1 to 5
        forceG[i] = CreateForce()
    LOL = CreateSound("sounds\\LOLfb.mp3", false, false, false, 10, 10, "")
        ..setDuration(3579)
        ..setChannel(0)
        ..setVolume(127)
        ..setPitch(1.0)
    knightNoGold = CreateSound("Sound\\Interface\\Warning\\Human\\KnightNoGold1.wav", false, false, false, 10, 10, "")
    knightNoGold.setSoundParamsFromLabel("NoGoldHuman")
    knightNoGold.setDuration(1486)
    colorCode[0] = "FF0000"
    colorCode[1] = "0000FF"
    colorCode[2] = "00FFFF"
    colorCode[3] = "800080"
    colorCode[4] = "FFFF00"
    colorCode[5] = "FFA500"
    colorCode[6] = "00FF00"
    colorCode[7] = "FF00FF"
    for a = 0 to 7
        limitArt[a] = 2
    kings[1] = createUnit(players[8], 'H003', vec2(-3070.0, 250.0))
    kings[2] = createUnit(players[9], 'H003', vec2(2550.0, 250.0), 180.0 .fromDeg())
    for a = 1 to 2
        kings[a]..issuePointOrder("root", kings[a].getPos())
            ..removeAbility('A0BQ')
    // базы: левые у x = -3070 (здание базы -3672), правые у x = 2550 (3138); по 4 высоты
    for a = 0 to 7
        let left = a < 4
        let lane = a mod 4
        let y = lane == 0 ? -4990.0 : (lane == 1 ? -2400.0 : (lane == 2 ? 3050.0 : 5620.0))
        let x = left ? -3070.0 : 2550.0
        let facing = left ? 180.0 : 270.0
        arthas[a] = createUnit(players[a], 'h02T', vec2(x, y), facing.fromDeg())
        builders[a] = createUnit(players[a], 'H01Y', vec2(x, y), facing.fromDeg())
        baza[a] = createUnit(players[a], 'h000', vec2(left ? -3672.0 : 3138.0, y), 270.0 .fromDeg())
        forceG[left ? 1 : 2].addPlayer(players[a])
        players[a].setCameraField(CAMERA_FIELD_TARGET_DISTANCE, 2400.0, 0.0)
        // обзор своей половины сразу, а не с первым раундом: иначе пока хост выбирает режим, карта под туманом
        let vision = left ? rct_Vision1 : rct_Vision2
        createFogModifier(players[a], FOG_OF_WAR_VISIBLE, vision, true, false).start()
        SetFogStateRect(players[a], FOG_OF_WAR_VISIBLE, vision, true)
    // первый раунд запускает выбор режима (ModeSelect), когда хост выберет режим
    fillTiers()

// ============================================================
// Триггер: Int2 — первый раунд: особые «скины» баз по никам, рабочие, надписи
// ============================================================

/** Заменить строителя/базу/Артаса игрока a на особые типы и выдать рабочего wispId; вернуть рабочего */
function applySkin(int a, int wispId, int builderId, int bazaId, int arthasId) returns unit
    let p = players[a]
    let wisp = createUnit(p, wispId, builders[a].getPos())
    wisp.setPathing(true)
    let builder = createUnit(p, builderId, builders[a].getPos())
    builders[a].remove()
    builders[a] = builder
    let bazaPos = baza[a].getPos()
    baza[a].remove()
    baza[a] = createUnit(p, bazaId, bazaPos, 270.0 .fromDeg())
    let u = createUnit(p, arthasId, arthas[a].getPos())
    arthas[a].remove()
    arthas[a] = u
    return wisp

/** Вокруг базы игрока a деревья 'LTlt' заменяются на treeId, а земля 'Yhdg' перед базой — на terrainId */
function decorateBase(int a, int treeId, int terrainId)
    let base = baza[a].getPos()
    let d = a < 4 ? 1 : -1
    let r = Rect(base.x - 1000, base.y - 1000, base.x + 1000, base.y + 1000)
    forDestructablesInRect(r) dest ->
        if dest.getTypeId() == 'LTlt'
            let pos = dest.getPos()
            dest.remove()
            createDestructable(treeId, pos, angle(0), 1.0, 1)
    r.remove()
    for b = 0 to 7
        for c = 0 to 9
            let x = base.x + (80 + c * 133) * d
            let y = base.y - 400 + b * 133
            if vec2(x, y).getTerrainType() == 'Yhdg'
                vec2(x, y).setTerrainType(terrainId, -1, 1, 1)

/** Особый скин игрока a + украшение базы (treeId == 0 — без украшения); вернуть рабочего */
function skin(int a, int wispId, int builderId, int bazaId, int arthasId, int treeId, int terrainId) returns unit
    nickSkin[a] = true
    let w = applySkin(a, wispId, builderId, bazaId, arthasId)
    if treeId != 0
        decorateBase(a, treeId, terrainId)
    return w

/** Рабочий игрока a по нику (особые скины у постоянных игроков) */
function createWorker(int a) returns unit
    let name = players[a].getName()
    if name == "Stvel#2381"
        return skin(a, 'e01Y', 'H08M', 'h08N', 'h08O', 'JTct', 'Zgrs')
    else if name == "The_War"
        return skin(a, 'e01S', 'H08P', 'h08R', 'h08S', 0, 0)
    else if name == "HELLRISER" or name == "Delovet" or name == "SorryIllKillYou" or name == "BuriTos" or name == "The_Asakura_War"
        return skin(a, 'e01T', 'H08V', 'h08T', 'h08U', 'DTsh', 'Kdtr')
    else if name == "LordofKodoes#2670"
        return skin(a, 'e01Y', 'H09F', 'h08N', 'h09G', 'GTsh', 'Cpos')
    else if name == "dEDaRTEM"
        return skin(a, 'e01D', 'H0AJ', 'h0AK', 'h0AL', 'B002', 'Gdkr')
    else if name == "Pentium4" or name == "OZ-Robert"
        return skin(a, 'e01R', 'H08W', 'h08X', 'h08Y', 'FTtw', 'Fgrd')
    else if name == "PLEVA_KOZLA" or name == "MyNameIsIra" or name == "Djanbo1djan-_-" or name == "Bodyrest" or name == "1st_PVL" or name == "TacticalSurv"
        return skin(a, 'e01U', 'H08Z', 'h091', 'h090', 'ZTtw', 'Zgrs')
    else if name == "XxRiKxX123"
        return skin(a, 'e01R', 'H09B', 'h09C', 'h09D', 'FTtw', 'Fgrd')
    else if name == "IIoBapeHoK"
        return skin(a, 'e01X', 'H09L', 'h09N', 'h09M', 0, 0)
    else if name == "SnOoL1337" or name == "NeverLookBack"
        return skin(a, 'e01T', 'H08W', 'h08T', 'h08Y', 'FTtw', 'Fgrd')
    else if name == ".Epicfail."
        return skin(a, 'e01E', 'H0AO', 'h0AN', 'h0AM', 'WTst', 'Idki')
    else if name == "raknakrabe" or name == "Fear"
        return skin(a, 'e01Z', 'H09T', 'h09U', 'h09Q', 'FTtw', 'Fgrd')
    let w = createUnit(players[a], 'e003', builders[a].getPos())
    w.setPathing(true)
    return w

/** Подпись над магазином (по типу здания) */
public function shopLabel(unit u)
    let id = u.getTypeId()
    string s = null
    var dx = -15.0
    if id == 'n012'
        s = "Damage"
    else if id == 'n02H'
        s = "Regeneration"
    else if id == 'n030'
        s = "Auras"
    else if id == 'n031'
        s = "Command Auras"
    else if id == 'n032'
        s = "Stuns"
        dx = 0.0
    else if id == 'n033'
        s = "Summons"
    else if id == 'n03N' or id == 'n03O'
        s = "Misc"
    else if id == 'n03P'
        s = "Sold"
    if s != null
        CreateTextTag()
            ..setText("|cffFF0000" + s + "|r", 10)
            ..setPos(u.getX() + dx, u.getY(), 0.0)

/** Дальность добычи светлячка ('A00T') — он не ходит, рубит с места */
constant HARVEST_RANGE = 1100.

/** Рабочий — на ближайшее живое дерево в досягаемости (раньше брал последнее из квадрата 2000×2000: оно могло
    быть дальше дальности добычи или не деревом — тогда приказа не было вовсе). Приказ проходит только на деревья */
public function unit.harvestNearestTree()
    let u = this
    let pos = u.getPos()
    let r = Rect(pos.x - HARVEST_RANGE, pos.y - HARVEST_RANGE, pos.x + HARVEST_RANGE, pos.y + HARVEST_RANGE)
    let trees = new ArrayList<destructable>()
    forDestructablesInRect(r) d ->
        if d.getLife() > 0 and d.getPos().distanceTo(pos) <= HARVEST_RANGE
            trees.add(d)
    r.remove()
    trees.sortWith((a, b) -> (a.getPos().distanceToSq(pos) - b.getPos().distanceToSq(pos)).toInt())
    for i = 0 to trees.size() - 1
        if u.issueTargetOrder("harvest", trees.get(i))
            break
    destroy trees

@noinline
function initPlayers()
    for a = 0 to 7
        let wisp = createWorker(a)
        baza[a].setVertexColor(255, 255, 255, 180)
        // текст ресурсов над базой — виден только своей команде
        textR[a] = CreateTextTag()
            ..setText("", 10)
            ..setPos(baza[a].getX() - 50, baza[a].getY(), 0.0)
        if (forceG[1].containsPlayer(localPlayer) and a > 3) or (forceG[2].containsPlayer(localPlayer) and a < 4)
            textR[a].setVisibility(false)
        // рабочий сразу рубит ближайшее дерево
        wisp.harvestNearestTree()
    // объявление о турнире 2x2 (два постоянных текстага у воды) убрано по просьбе

// ============================================================
// Триггер: Wave — раунд: юниты со всех построек, награда, наёмники в бой
// ============================================================

/** Случайные (25%) улучшения от исследований строителя владельца */
function applyBuilderUpgrades(unit s)
    let b = builders[s.getOwner().getId()]
    if b.getAbilityLevel('B02S') >= 1 and GetRandomInt(1, 100) <= 25
        s.addAbility('A0BI')
        addEffect("Abilities\\Weapons\\AvengerMissile\\AvengerMissile.mdl", s, "chest")
    if b.getAbilityLevel('B02Q') >= 1 and GetRandomInt(1, 100) <= 25
        s.addAbility('A0BF')
        addEffect("Abilities\\Spells\\Undead\\ReplenishMana\\ReplenishManaCasterOverhead.mdl", s, "overhead").destr()
    if b.getAbilityLevel('B02R') >= 1 and s.isType(UNIT_TYPE_MELEE_ATTACKER) and GetRandomInt(1, 100) <= 25
        s.addAbility('A06V')
        addEffect("Abilities\\Spells\\Other\\ANrm\\ANrmTarget.mdl", s, "origin")
    if b.getAbilityLevel('B02T') >= 1 and GetRandomInt(1, 100) <= 25
        s..addAbility('A0BG')..addAbility('S00P')
    if b.getAbilityLevel('B02P') >= 1 and GetRandomInt(1, 100) <= 25
        s..addAbility('A051')..addAbility('S00Q')
    if b.getAbilityLevel('B02F') >= 1 and GetRandomInt(1, 100) <= 25
        s..addAbility('A0BH')..addAbility('S00R')
    if b.getAbilityLevel('B02Z') >= 1 and GetRandomInt(1, 100) <= 25
        s.addAbility('A0CT')
    if b.getAbilityLevel('B03K') >= 1 and GetRandomInt(1, 100) <= 25 and not zapret_Necr(s)
        s.addAbility('A0F2')
        addEffect("models\\Armor Stimulus Orange.mdx", s, "overhead")
    if b.getAbilityLevel('B03F') >= 1 and s.getMaxMana() == 60 and GetRandomInt(1, 100) <= 25
        s.addAbility('A0ES')
        addEffect("Abilities\\Spells\\Other\\ANrl\\ANrlTarget.mdl", s, "origin")
    if b.getAbilityLevel('B03M') >= 1 and s.getMaxMana() == 60 and GetRandomInt(1, 100) <= 25 and not zapret_Necr(s)
        s.addAbility('A0FB')
        addEffect("models\\Magic_Aura_02.mdl", s, "origin")
    if b.getAbilityLevel('B02O') >= 1
        wDammiHP(s, 205)
        s.addAbility('S00S')

/** Бонусы от синергий зданий владельца */
function applySynergies(unit s)
    let id = s.getOwner().getId()
    let t = s.getTypeId()
    let flying = s.getAbilityLevel('A00W') == 1
    if sinergia3[id] >= 5 and t == 'e00M'
        s..addAbility('A02I')..addAbility('A04U')
        wDammiAtt(s, 15)
    if sinergia[id] >= 3 and t == 'o006'
        s..addAbility('A02I')..addAbility('A02J')
        wDammiAtt(s, 3)
    if sinergia1[id] >= 1 and flying
        s..addAbility('A02I')..addAbility('A03S')
    if sinergia4[id] >= 1 and flying
        s.addAbility('A064')
    if sinergia8[id] >= 1 and flying
        s.addAbility('A07D')
    if t == 'n02L'
        if sinergia6[id] == 1
            s..addAbility('A06V')..addAbility('A03Z')..setVertexColor(255, 0, 0, 255)
        else
            s..addAbility('A04U')..addAbility('A00J')..setVertexColor(0, 255, 0, 255)
    if t == 'n026'
        addEffect("Abilities\\Spells\\Undead\\AbsorbMana\\AbsorbManaBirthMissile.mdl", s, "weapon,left")
        let lvl = min(5, sinergia5[id])
        wDammiHP(s, 50 * lvl)
        s..setAbilityLevel('A0DA', lvl)..setAbilityLevel('A06G', lvl)..setAbilityLevel('A06H', lvl)
        wDammiAtt(s, 2 * lvl)
    if t == 'n02R'
        wDammiHP(s, 216 * min(5, sinergia7[id]))
    if sinergia9[id] >= 3 and t == 'n035'
        s..addAbility('A06M')..addAbility('A02I')
        addEffect("Units\\NightElf\\Owl\\Owl.mdl", s, "origin")
    if sinergia10[id] >= 1 and t == 'n022'
        s..addAbility('A02I')..addAbility('A0DD')
    if (sinergia11[id] >= 1 and t == 'u00P') or t == 'u00C' or t == 'u005' or t == 'u00X' or t == 'u00W' or t == 'u00V'
        wDammiHP(s, sinergia11[id] < 4 ? 25 * sinergia11[id] : 100)
    if sinergia12[id] >= 3 and t == 'n00O'
        s..addAbility('A0GQ')..addAbility('A0CP')
    if sinergiaDE2[id] >= 1
        wDammiHP(s, 125)
        if t == 'n014' or t == 'n013' or t == 'n017' or t == 'u00H' or t == 'n015' or t == 'u00S' or t == 'u00Y'
            s.addAbility('A0DL')
        if t == 'u00P' or t == 'u00C' or t == 'u005' or t == 'u00X' or t == 'u00W' or t == 'u00V' or t == 'u00E'
            s.addAbility('A0DG')
    if sinergiaDE[id] == 1
        s.addAbility('A0DH')
    if sinergiaDE1[id] >= 1
        s.addAbility('A0DK')
        addEffect("models\\CircleOutBuff.mdl", s, "origin")
    if sinergiaDE3[id] >= 1
        addEffect("models\\Portal.mdl", s, "origin")
        s.addAbility('A0DJ')
    if sinergiaDE5[id] >= 1
        s.addAbility('A0DJ')
    if sinergiaDE6[id] >= 1
        s.addAbility('A0F1')

/** Синергии элементалей (H1..H8): у лордов 'n04R'/'n04S' — до двух умений (актив + пассив), у 'n04S' ещё и комбо */
function applyElementalSynergies(unit s)
    let id = s.getOwner().getId()
    let t = s.getTypeId()
    let h1 = sinergiaH1[id] >= 1
    let h2 = sinergiaH2[id] >= 1
    let h3 = sinergiaH3[id] >= 1
    let h4 = sinergiaH4[id] >= 1
    let h5 = sinergiaH5[id] >= 1
    let h6 = sinergiaH6[id] >= 1
    let h7 = sinergiaH7[id] >= 1
    let h8 = sinergiaH8[id] >= 1
    var combo = 0
    var active = 0
    var passive = 0
    if t == 'n04R'
        if (h1 or h2) and combo != 2 and active != 1
            s..addAbility('A0G5')..setVertexColor(255, 0, 0, 255)
            combo++
            active++
        if (h3 or h4) and combo != 2 and passive != 1
            s..addAbility('A0G7')..addAbility('A0GD')
            combo++
            passive++
            addEffect("models\\Windwalk Necro Soul.mdl", s, "chest")
        if (h5 or h6) and combo != 2 and active != 1
            s..addAbility('A0G4')..setVertexColor(0, 0, 255, 255)
            combo++
        if (h7 or h8) and combo != 2 and passive != 1
            s..addAbility('A0G8')..addAbility('A0GC')
            addEffect("models\\Windwalk.mdl", s, "chest")
    else if t == 'n04S'
        if h1 and h2 and combo != 2 and active != 1
            s..addAbility('A0GB')..setVertexColor(255, 0, 0, 255)
            combo++
            active++
        if h3 and h4 and combo != 2 and passive != 1
            s..addAbility('A0G7')..setAbilityLevel('A0G7', 2)..addAbility('A0GD')..setAbilityLevel('A0GD', 2)
            combo++
            passive++
            addEffect("models\\Windwalk Necro Soul.mdl", s, "chest")
        if h5 and h6 and combo != 2 and active != 1
            s..addAbility('A0G4')..setAbilityLevel('A0G4', 2)..setVertexColor(0, 0, 255, 255)
            combo++
        if h7 and h8 and combo != 2 and passive != 1
            s..addAbility('A0G8')..setAbilityLevel('A0G8', 2)..addAbility('A0GC')..setAbilityLevel('A0GC', 2)
            combo++
            addEffect("models\\Windwalk.mdl", s, "chest")
        if ((h1 and h2) or (h5 and h6)) and combo != 3
            s.addAbility('A0G9')
            combo++
        else if ((h3 and h4) or (h7 and h8)) and combo != 3
            s.addAbility('S012')
            combo++
        if h1 and h2 and h3 and h4 and combo != 4
            s.addAbility('A0GR')
        else if h5 and h6 and h7 and h8 and combo != 4
            s.addAbility('A0GS')
    if h7 and h5 and (t == 'n04E' or t == 'n04M')
        wDammiHP(s, 100)
        wDammiAtt(s, 15)
    if h1 and h2 and (t == 'n04A' or t == 'n04I')
        s..addAbility('A06L')..addAbility('A02I')..addAbility('A0GJ')
    if h6 and h4 and (t == 'n04O' or t == 'n04G')
        s..addAbility('A0GI')..addAbility('A0GK')
    if h3 and h8 and (t == 'n04K' or t == 'n04D')
        s..addAbility('A064')..addAbility('A040')

/** Юниты с постройки u на раунд: по одному (3 у 'h04A', 2 у 'h04N'/'h09Z'), с бонусами владельца */
@noinline
public function spawnFrom(unit u)
    let p = u.getOwner()
    let t = u.getTypeId()
    if u.getAbilityLevel('A006') == 1
        u.setAbilityLevel('A006', 2)
    var count = 1
    if t == 'h04A'
        count = 3
    else if t == 'h04N' or t == 'h09Z'
        count = 2
    if t == 'h080'
        p.setGold(p.getGold() - 8)
        text(u, "|cffFFFF00-8|r", 8.0, 3.50, 50.0)
    for i = 1 to count
        let s = createUnit(p, t.baseType(), u.getPos(), 90.0 .fromDeg())
        s.setPathing(true)
        let sid = s.getTypeId()
        if sid == 'h03R'
            P.add(s)
        if sid != 'e003' and sid != 'e002' and not s.isType(UNIT_TYPE_STRUCTURE) and not s.isType(UNIT_TYPE_HERO)
            applyBuilderUpgrades(s)
        applySynergies(s)
        applyElementalSynergies(s)
        if round > 60
            s.setPathing(false)
        s.attackLane()
        if sid == 'n01J' or sid == 'n01F'
            s.addAbility('A04U')
            doAfter(30.0) ->
                s.removeAbility('A04U')

/** Наёмник выходит на линию; 'n03T' даёт 'A04G' союзным гигантам рядом */
@noinline
function naimAttack(unit u)
    let p = u.getOwner()
    naimGroup.remove(u)
    u.setPathing(true)
    if isPvevp()
        u.becomeSend()
        return
    u.setPos(u.getX() + (u.getX() < 0 ? 900 : -900), u.getY() + 700)
    u.attackLane()
    if u.getTypeId() == 'n03T'
        forUnitsInRange(u.getPos(), 1100.0) s ->
            if s.isAllyOf(p) and s.isAlive() and s.isType(UNIT_TYPE_GIANT)
                s.addAbility('A04G')
                addEffect("models\\CircleOutBuff.mdl", s, "origin")

/** Стража короля a на раунд: 10 пехотинцев с бонусами от характеристик короля */
function kingGuards(int a)
    let king = kings[a]
    let dmg = (king.getAgi(false) - 60) div 10 + (king.getStr(false) - 60) div 20
    let hp = ((king.getInt(false) - 60) * 3.5 + (king.getStr(false) - 60) * 1.5).toInt()
    for i = 0 to 9
        let u = createUnit(players[a == 1 ? 8 : 9], 'h01L', vec2(a == 1 ? -3400.0 : 2800.0, (-250 + 100 * i).toReal()), (a == 1 ? 180.0 : 270.0).fromDeg())
        wDammiAtt(u, dmg)
        wDammiHP(u, hp)
        u.attackLane()

/** Первый раунд: подписи магазинов, стартовое золото, лимиты построек, случайный набор зданий, пустые слоты */
@noinline
function firstRound()
    initPlayers()
    let world = GetWorldBounds()
    forUnitsInRect(world) u ->
        if u.isType(UNIT_TYPE_STRUCTURE)
            shopLabel(u)
    world.remove()
    for a = 0 to 7
        let p = players[a]
        for slot = 1 to 8
            elemLeft[elemLimit(slot, a)] = 2
        p.setGold(700)
        // лимиты построек: рабочие и особые здания
        // защитный камень h02Q — только в PvP (в PvE и PvEvP через порталы никто не ходит)
        p..limit(8, 'e003')..limit(8, 'e01S')..limit(8, 'e01R')..limit(8, 'e01T')..limit(8, 'e01X')..limit(8, 'e01U')
            ..limit(8, 'e01Z')..limit(8, 'e01Y')..limit(8, 'e01E')..limit(8, 'e01D')..limit(8, 'h07J')
            ..limit(6, 'h05N')..limit(6, 'h012')..limit(6, 'h06E')..limit(6, 'h06T')
            ..limit(5, 'h054')..limit(5, 'h00W')..limit(5, 'h047')..limit(5, 'h015')
            ..limit(1, 'h06U')..limit(gameMode == GameModeKind.PVP ? 1 : 0, 'h02Q')..limit(1, 'h017')..limit(1, 'h04D')..limit(1, 'h055')
            ..limit(1, 'h05X')..limit(1, 'h06L')..limit(1, 'h08E')..limit(1, 'h09Z')
        random(p)
        for i = 1 to 6
            builders[a].addItemHandle(createItem('I000', builders[a].getPos()))
        for i = 1 to 4
            arthas[a].addItemHandle(createItem('I000', arthas[a].getPos()))

@noinline
function wave()
    timerD.destr()
    round++
    if round >= 105
        zamedlo = 12
    else if round >= 90
        zamedlo = 10
    else if round >= 75
        zamedlo = 8
    else if round >= 60
        zamedlo = 6
    else if round >= 45
        zamedlo = 4
    else if round >= 30
        zamedlo = 2
    if not manualRounds
        // PvP: раунд удлиняется с 30-го; PvE — всегда ROUND_TIME
        roundTimer.start(gameMode == GameModeKind.PVP ? (ROUND_TIME + zamedlo).toReal() : ROUND_TIME.toReal(), null)
        timerD = roundTimer.createTimerDialog()
            ..setTitle("Round " + round)
            ..display(true)
    if round == 1
        firstRound()
        fireRoundHooks(round)
        return
    kingGuards(1)
    // PvE: правого короля нет — на его месте Злой Бог
    if not isPve()
        kingGuards(2)
    for a = 0 to 7
        incomeR[a] += 3
        // PvEvP: награду за раунд даёт конец волны (Pvevp.waveReward), здесь — только инком
        let reward = isPvevp() ? 0 : 100 + incomeR[a]
        players[a].setGold(players[a].getGold() + income[a] + reward)
        wDammiAtt(arthas[a], 1)
        players[a].message("|cffFFD700Round " + round + "|r\nRound reward: |cffffff00" + reward + " gold!|r \nYour income: |cffffff00" + income[a] + " gold!|r")
    buildUnits.forEachIn() u ->
        spawnFrom(u)
    // наёмники — через 1 с (PvEvP: через 2.5 с после начала волны, как в Just Fight)
    doAfter(isPvevp() ? 2.5 : 1.0) ->
        naimGroup.forEachIn() u ->
            naimAttack(u)
    fireRoundHooks(round)

// ============================================================
// Триггер: Win — смерть короля: через 3 с победа/поражение командам
// ============================================================

@noinline
function win()
    let d = GetDyingUnit()
    // в PvE оба короля — свои: поражение всем объявляет Pve
    if (d != kings[1] and d != kings[2]) or isPve()
        return
    setCameraPosition(d.getPos())
    let losers = d == kings[1] ? 0 : 4
    let winners = d == kings[1] ? 4 : 0
    doAfter(3.0) ->
        for i = 0 to 3
            MMD.flagPlayer(players[winners + i], PlayerFlag.Winner)
            MMD.flagPlayer(players[losers + i], PlayerFlag.Loser)
            CustomVictoryBJ(players[winners + i], true, true)
            CustomDefeatBJ(players[losers + i], "Defeat!")

init
    for i = 0 to JF_BOUNTIES - 1
        jfBounties.put(jfBountyType[i], jfBounty[i])
    CreateTrigger()
        ..registerTimerExpireEvent(roundTimer)
        ..addAction(function wave)
    onDeathOf('H003') ->
        win()
