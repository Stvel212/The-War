// бывший InitGlobals: оставлены только присваивания не-значений-по-умолчанию (handles, числа != 0) для используемых переменных

public function initGlobals()
    buildUnits = CreateGroup()
    naimGroup = CreateGroup()
    P = CreateGroup()
    roundTimer = CreateTimer()
    for i = 0 to 9
        boom[i] = true
        wispCount[i] = 1
    for i = 0 to 1
        forceG[i] = CreateForce()

init
    initGlobals()
