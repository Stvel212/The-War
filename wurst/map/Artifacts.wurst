function artWyhrA(unit caster)
    let u = CreateUnit(caster.getOwner(), 'e01L', GetSpellTargetX(), GetSpellTargetY(), 0.0)
    u.setTimedLife(5.0, 'BHwe')
    u.issueImmediateOrder("whirlwind")

// ============================================================
// Артефакт: MpColdA — способность 'A0BS'
// ============================================================

function artMpColdA(unit _caster)
    addEffect("Abilities\\Spells\\Items\\AIma\\AImaTarget.mdl", GetSpellTargetUnit().getPos()).destr()
    UnitResetCooldown(GetSpellTargetUnit())
    GetSpellTargetUnit().setMana(GetSpellTargetUnit().getMaxMana())

// ============================================================
// Артефакт: BombaA — способность 'A0BE'
// ============================================================

function artBombaA(unit caster)
    let u = CreateUnit(caster.getOwner(), 'e01M', caster.getX(), caster.getY(), 0.0)
    let charges = Artifact.charges(caster, 'I01C')
    if charges > 0
        u.setTimedLife((charges * 2).toReal(), 'BHwe')
    u.issuePointOrder("attackground", vec2(GetSpellTargetX(), GetSpellTargetY()))

// ============================================================
// Артефакт: TrainA — способность 'A0BT'
// ============================================================

/** Носитель предмета itemId в точке каста на life секунд (предмет-аура действует, пока носитель жив) */
function itemHolder(player owner, int itemId, real life)
    let u = CreateUnit(owner, 'e00Y', GetSpellTargetX(), GetSpellTargetY(), 0.0)
    u.addItemHandle(CreateItem(itemId, u.getX(), u.getY()))
    u.setTimedLife(life, 'BHwe')

function artTrainA(unit caster)
    itemHolder(caster.getOwner(), 'I01S', 2.0)

// ============================================================
// Артефакт: Teleport1A — способность 'A0AD'
// ============================================================

function artTeleport1A(unit caster)
    let t = GetSpellTargetUnit()
    if IsUnitPaused(t) or t.getAbilityLevel('A0C4') != 0 or t.getAbilityLevel('A0GP') != 0
        return
    // цель на 6 с неуязвима, обездвижена и помечена 'A0BX' (её заберёт Teleport2A); игроку выделяется маяк
    t..addAbility('Avul')..addAbility('A0BX')..setMoveSpeed(1.0)
    let beacon = CreateUnit(caster.getOwner(), 'e01N', t.getX(), t.getY(), 0.0)
    if localPlayer == caster.getOwner()
        ClearSelection()
        SelectUnit(beacon, true)
    beacon.setTimedLife(6.0, 'BHwe')
    doAfter(6.0) ->
        if t.getAbilityLevel('Avul') == 1
            t..removeAbility('Avul')..removeAbility('A0BX')..setMoveSpeed(t.getDefaultMovespeed())

// ============================================================
// Артефакт: Teleport2A — способность 'A0BY'
// ============================================================

function artTeleport2A(unit caster)
    let p = caster.getOwner()
    let target = vec2(GetSpellTargetX(), GetSpellTargetY())
    // сначала собираем группу, потом переносим — не двигаем юнитов прямо во время перебора
    let g = unitsInRange(caster.getPos(), 200.0, (u) -> u.getAbilityLevel('A0BX') == 1 and u.isAllyOf(p))
    addEffect("Abilities\\Spells\\Human\\MassTeleport\\MassTeleportCaster.mdl", caster.getPos()).destr()
    g.forEachFrom() u ->
        addEffect("Abilities\\Spells\\Human\\MassTeleport\\MassTeleportCaster.mdl", target).destr()
        SetUnitPosition(u, target.x, target.y)
        u..removeAbility('Avul')..setMoveSpeed(u.getDefaultMovespeed())..addAbility('A0F6')
        u.attackLane()
        // HP падает до 1%, потом 5 секунд по 0.5 с возвращается долями от прежнего процента
        let percent = u.getHP() / u.getMaxHP() * 10
        u.setHP(u.getMaxHP() * 0.01)
        let fx = addEffect("Abilities\\Spells\\Items\\StaffOfSanctuary\\Staff_Sanctuary_Target.mdl", u, "chest")
        doPeriodicallyCounted(0.5, 10) cb ->
            if u.isAlive()
                u.setHP(u.getHP() + u.getMaxHP() * percent * 0.01)
            else
                cb.stop()
            if cb.isLast() or not u.isAlive()
                fx.destr()
    g.release()
    caster.remove()

// ============================================================
// Артефакт: HealPA — способность 'A0BR'
// ============================================================

function artHealPA(unit caster)
    let charges = Artifact.charges(caster, 'I00K')
    itemHolder(caster.getOwner(), charges == 1 ? 'I01T' : (charges == 2 ? 'I01U' : 'I01V'), 1.0)

// ============================================================
// Артефакт: DopHPPA — способность 'A0C2'
// ============================================================

function artDopHPPA(unit caster)
    let p = caster.getOwner()
    forUnitsInRange(vec2(GetSpellTargetX(), GetSpellTargetY()), 300.0) u ->
        if u.isAllyOf(p) and u.isAlive() and (u.isType(UNIT_TYPE_TAUREN) or u.isType(UNIT_TYPE_GIANT)) and not u.isType(UNIT_TYPE_HERO)
            u.addAbility('A0D0')
            addEffect("Abilities\\Spells\\Undead\\DeathPact\\DeathPactTarget.mdl", u, "chest").destr()

// ============================================================
// Артефакт: HPRegA — способность 'A0C3'
// ============================================================

function artHPRegA(unit caster)
    let u = caster
    let t = GetSpellTargetUnit()
    if t.getAbilityLevel('A0AM') == 0
        t.addAbility('A0C4')
        if u.getAbilityLevel('A0C3') == 1
            t.addAbility('A0D1')
        else if u.getAbilityLevel('A0C3') == 2
            t.addAbility('A0D2')
        else
            t.addAbility('A0D3')
    else
        DisplayTextToPlayer(u.getOwner(), 0.0, 0.0, "Not allowed! Anti-abuse")

// ============================================================
// Артефакт: SpeedA — способность 'A0CK'
// ============================================================

function artSpeedA(unit caster)
    let charges = Artifact.charges(caster, 'I012')
    itemHolder(caster.getOwner(), charges == 1 ? 'I01W' : (charges == 2 ? 'I01X' : 'I01Q'), 1.0)

// ============================================================
// Артефакт: VzryvA — EVENT_PLAYER_UNIT_DEATH
// ============================================================

/** У строителя или Артаса игрока лежит 'I01A' */
function hasBombArtifact(int id) returns bool
    var found = false
    for c = 0 to 5
        if builders[id].itemInSlot(c).getTypeId() == 'I01A' or arthas[id].itemInSlot(c).getTypeId() == 'I01A'
            found = true
    return found

@noinline
function artVzryvA()
    if not hasBombArtifact(GetTriggerUnit().getOwner().getId())
        return
    if GetKillingUnit().isType(UNIT_TYPE_HERO) == false
        GetTriggerUnit().damageTarget(GetKillingUnit(), 84.0, true, false, ATTACK_TYPE_NORMAL, DAMAGE_TYPE_ENHANCED, WEAPON_TYPE_WHOKNOWS)
        addEffect("Abilities\\Spells\\Demon\\DemonBoltImpact\\DemonBoltImpact.mdl", GetKillingUnit().getPos()).destr()

// ============================================================
// Артефакт: GorelkaA — способность 'A0CA'
// ============================================================

function artGorelkaA(unit caster)
    let charges = Artifact.charges(caster, 'I01D')
    CreateUnit(caster.getOwner(), 'e01P', GetSpellTargetX(), GetSpellTargetY(), bj_UNIT_FACING).setTimedLife((5 + charges * 5).toReal(), 'BHwe')

// ============================================================
// Артефакт: DamageA — способность 'A0CC'
// ============================================================

function artDamageA(unit caster)
    InstantDummyCaster.castImmediate(caster.getOwner(), 'A0CD', 1, OrderIds.creepthunderclap, vec2(GetSpellTargetX(), GetSpellTargetY()))

// ============================================================
// Артефакт: AttackSpeedA — способность 'A0CE'
// ============================================================

function artAttackSpeedA(unit caster)
    let p = caster.getOwner()
    forUnitsInRange(vec2(GetSpellTargetX(), GetSpellTargetY()), 300.0) u ->
        if u.isAllyOf(p) and u.isAlive() and u.isType(UNIT_TYPE_GIANT)
            u.addAbility('A06X')
            addEffect("Abilities\\Spells\\Other\\Incinerate\\FireLordDeathExplode.mdl", u.getPos()).destr()

// ============================================================
// Артефакт: DamageHPA — способность 'A0CF'
// ============================================================

function artDamageHPA(unit caster)
    let p = caster.getOwner()
    let lvl = Artifact.charges(caster, 'I01H')
    forUnitsInRange(vec2(GetSpellTargetX(), GetSpellTargetY()), 300.0) u ->
        if not u.isAllyOf(p) and u.isAlive()
            Artifact.dummy(p, u.getPos(), 30.0)
                ..castTarget('A0CG', lvl, OrderIds.drain, u)

// ============================================================
// Артефакт: RacetuA — способность 'A0CH'
// ============================================================

function artRacetuA(unit caster)
    let lvl = caster.getAbilityLevel('A0CH')
    var abil = 'A0HP'
    if lvl == 1
        abil = 'A0CI'
    else if lvl == 2
        abil = 'A0HO'
    auraDummy(caster.getOwner(), vec2(GetSpellTargetX(), GetSpellTargetY()), abil, 0, 7.0).setScale(0.1)

// ============================================================
// Артефакт: NeyazA — способность 'A0CJ'
// ============================================================

function artNeyazA(unit caster)
    let t = GetSpellTargetUnit()
    if t.isType(UNIT_TYPE_HERO)
        return
    // неуязвимость на 5 / 9 / 13 секунд по зарядам
    let charges = Artifact.charges(caster, 'I01K')
    let seconds = charges == 1 ? 5.0 : (charges == 2 ? 9.0 : 13.0)
    t.addAbility('Avul')
    let fx = addEffect("Abilities\\Spells\\Human\\DivineShield\\DivineShieldTarget.mdl", t, "chest")
    doAfter(seconds) ->
        t.removeAbility('Avul')
        fx.destr()

// ============================================================
// Артефакт: SpheraA — способность 'A029'
// ============================================================

function artSpheraA(unit caster)
    let target = GetSpellTargetUnit()
    let a = Artifact.charges(caster, 'I020')
    let targetBase = UnitId(GetAbilityEffectById(target.getTypeId(), EFFECT_TYPE_TARGET, 0))
    forUnitsOfPlayer(target.getOwner()) u ->
        if u.getAbilityLevel('Avul') == 0 and u.getAbilityLevel('A0DI') == 0 and UnitId(GetAbilityEffectById(u.getTypeId(), EFFECT_TYPE_TARGET, 0)) == targetBase and not u.isType(UNIT_TYPE_STRUCTURE) and not u.isType(UNIT_TYPE_HERO) and u.getTypeId() != 'e000'
            u.addAbility('A0DI')
            u.setAbilityLevel('A0DI', a)
            let fx2 = addEffect("Abilities\\Spells\\Orc\\LightningShield\\LightningShieldTarget.mdl", u, "origin")
            doAfter(10.0) ->
                u.removeAbility('A0DI')
                fx2.destr()

// ============================================================
// Артефакт: LassoA — способность 'A08Y'
// ============================================================

function artLassoA(unit caster)
    let p = caster.getOwner()
    let lvl = Artifact.charges(caster, 'I021')
    forUnitsInRange(vec2(GetSpellTargetX(), GetSpellTargetY()), 300.0) u ->
        if (u.isType(UNIT_TYPE_TAUREN) or u.isType(UNIT_TYPE_GIANT)) and u.isEnemyOf(p) and not u.isType(UNIT_TYPE_HERO) and u.isAlive() and not u.isType(UNIT_TYPE_SAPPER)
            Artifact.dummy(p, u.getPos(), 5.0)
                ..castTarget('A0CU', lvl, OrderIds.magicleash, u)

// ============================================================
// Артефакт: KillA — способность 'A0EN'
// ============================================================

function artKillA(unit _caster)
    if GetSpellTargetUnit().getTypeId() != 'n03G' or GetSpellTargetUnit().getTypeId() != 'n03A'
        GetSpellTargetUnit().remove()
        GetSpellTargetUnit().kill()

// ============================================================
// Артефакт: DamageRezA — способность 'A0EP'
// ============================================================

function artDamageRezA(unit caster)
    let p = caster.getOwner()
    let g = unitsInRange(vec2(GetSpellTargetX(), GetSpellTargetY()), 600.0, (u) -> u.isAllyOf(p) and u.isAlive() and u.getAbilityLevel('Avul') == 0 and u.getAbilityLevel('A0EQ') == 0 and not u.isType(UNIT_TYPE_HERO) and not zapret_Necr(u))
    var count = 16
    if caster.getAbilityLevel('A0EP') == 1
        count = 8
    else if caster.getAbilityLevel('A0EP') == 2
        count = 12
    let g1 = GetRandomSubGroup(count, g)
    g1.forEachFrom() u ->
        u.addAbility('A0EQ')
        addEffect("models\\Armor Stimulus Orange.mdx", u, "overhead")
    g.release()
    g1.destr()

// ============================================================
// Артефакт: GolemA — EVENT_PLAYER_UNIT_SUMMON
// ============================================================

@noinline
function artGolemA()
    if not (GetSummonedUnit().getTypeId() == 'n03G')
        return
    GetSummonedUnit().addAbility('A0F6')

// ============================================================
// Артефакт: DarkBuy — EVENT_PLAYER_UNIT_SELL_ITEM
// ============================================================

@noinline
function artDarkBuy()
    let i = GetSoldItem()
    if i.getTypeId() == 'I02A'
        darkItem[GetBuyingUnit().getOwner().getId()] = true

// ============================================================
// Артефакт: DarkSell — EVENT_PLAYER_UNIT_DROP_ITEM
// ============================================================

@noinline
function artDarkSell()
    let i = GetManipulatedItem()
    if i.getTypeId() == 'I02A'
        darkItem[GetTriggerUnit().getOwner().getId()] = false

// ============================================================
// Артефакт: DarkA — EVENT_PLAYER_UNIT_DEATH
// ============================================================

@noinline
function artDarkA()
    let k = GetKillingUnit()
    if not (k.getAbilityLevel('B03O') == 1 or k.getAbilityLevel('B03Q') == 1 or k.getAbilityLevel('B03P') == 1)
        return
    let d = GetTriggerUnit()
    let id = d.getOwner().getId()
    if not darkItem[id]
        return
    // каждый третий убитый встаёт тенью на 4 / 7 / 10 секунд (по баффу убитого)
    dark[id] += 1
    if dark[id] < 3
        return
    dark[id] = 0
    addEffect("Abilities\\Spells\\Undead\\AnimateDead\\AnimateDeadTarget.mdl", d, "origin").destr()
    let u = CreateUnit(d.getOwner(), d.getTypeId(), d.getX(), d.getY(), 0.0)
        ..addAbility('Aloc')
        ..setVertexColor(55, 55, 55, 150)
    u.attackLane()
    let life = d.getAbilityLevel('B03O') == 1 ? 4.0 : (d.getAbilityLevel('B03Q') == 1 ? 7.0 : 10.0)
    doAfter(life) ->
        u.remove()

