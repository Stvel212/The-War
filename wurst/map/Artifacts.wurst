// Артефакт: ZaradkaA — способность 'A058'
// ============================================================

function artZaradkaA(unit _caster)
    if GetSpellTargetUnit().getAbilityLevel('A059') == 0
        GetSpellTargetUnit().addAbility('A059')
        addEffect("Abilities\\Spells\\Undead\\UnholyFrenzy\\UnholyFrenzyTarget.mdl", GetSpellTargetUnit(), "overhead")

// ============================================================
// Артефакт: StarfollA — способность 'A09V'
// ============================================================

function artStarfollA(unit caster)
    Artifact.dummy(caster.getOwner(), vec2(GetSpellTargetX(), GetSpellTargetY()), 15.0)
        ..castImmediate('A09W', 1, OrderIds.starfall)

// ============================================================
// Артефакт: StanA — способность 'A09X'
// ============================================================

function artStanA(unit caster)
    let x = GetSpellTargetX()
    let y = GetSpellTargetY()
    for a = 1 to 8
        Artifact.dummy(caster.getOwner(), vec2(x, y), 2.0)
            ..castPoint('A09Y', 1, OrderIds.impale, vec2(x + 256 * Cos(a * 0.785385), y + 256 * Sin(a * 0.785385)))

// ============================================================
// Артефакт: TranqvilaA — способность 'A09Z'
// ============================================================

function artTranqvilaA(unit caster)
    Artifact.dummy(caster.getOwner(), vec2(GetSpellTargetX(), GetSpellTargetY()), 16.0)
        ..castImmediate('A0A0', 1, OrderIds.tranquility)

// ============================================================
// Артефакт: IceDamageA — способность 'A0A1'
// ============================================================

function artIceDamageA(unit caster)
    let t = GetSpellTargetUnit()
    let seconds = Artifact.charges(caster, 'I00D') + 1
    // цель заморожена на seconds секунд; врагу за это время по 150 урона в секунду
    t.pause()
    let fx = addEffect("Abilities\\Spells\\Undead\\FreezingBreath\\FreezingBreathTargetArt.mdl", t, "chest")
    doAfter(seconds.toReal()) ->
        t.unpause()
        fx.destr()
    if not t.isAllyOf(caster.getOwner())
        doPeriodicallyCounted(1.0, seconds) cb ->
            if t.getHP() > 0
                caster.damageTarget(t, 150.0, true, false, ATTACK_TYPE_NORMAL, DAMAGE_TYPE_ENHANCED, WEAPON_TYPE_WHOKNOWS)
            else
                cb.stop()

// ============================================================
// Артефакт: ProkachkaA — способность 'A0A4'
// ============================================================

function artProkachkaA(unit caster)
    if not (GetSpellTargetUnit().isType(UNIT_TYPE_HERO) == false)
        return
    let c = Artifact.charges(caster, 'I00I')
    if GetSpellTargetUnit().getAbilityLevel('A0AE') < 1
        addEffect("Abilities\\Spells\\Items\\AIsp\\SpeedTarget.mdl", GetSpellTargetUnit(), "overhead")
        GetSpellTargetUnit().addAbility('A0AE')
        GetSpellTargetUnit().setAbilityLevel('A0AE', c)

// ============================================================
// Артефакт: StanMolotA — способность 'A0AB'
// ============================================================

function artStanMolotA(unit caster)
    let p = caster.getOwner()
    let lvl = Artifact.charges(caster, 'I00E')
    forUnitsInRange(vec2(GetSpellTargetX(), GetSpellTargetY()), 225.0) u ->
        if u.isEnemyOf(p) and u.isAlive()
            Artifact.dummy(p, caster.getPos(), 1.0)
                ..castTarget('A0AC', lvl, OrderIds.thunderbolt, u)

// ============================================================
// Артефакт: Hp DamageA — способность 'A0AG'
// ============================================================

function artHp_DamageA(unit caster)
    let t = GetSpellTargetUnit()
    let ally = t.isAllyOf(caster.getOwner())
    // союзнику 8 секунд по +80 HP, врагу — по 80 урона; на это время метка 'A0GP'
    let fx = addEffect(ally ? "Abilities\\Spells\\Items\\StaffOfSanctuary\\Staff_Sanctuary_Target.mdl" : "Abilities\\Spells\\Orc\\Voodoo\\VoodooAuraTarget.mdl", t, "chest")
    t.addAbility('A0GP')
    doPeriodicallyCounted(1.0, 8) cb ->
        if ally
            t.setHP(t.getHP() + 80)
        else
            caster.damageTarget(t, 80.0, true, false, ATTACK_TYPE_NORMAL, DAMAGE_TYPE_FIRE, WEAPON_TYPE_WHOKNOWS)
        if cb.isLast()
            t.removeAbility('A0GP')
            fx.destr()

// ============================================================
// Артефакт: TotemHA — способность 'A0AI'
// ============================================================

function artTotemHA(unit caster)
    CreateUnit(caster.getOwner(), 'o00K', GetSpellTargetX(), GetSpellTargetY(), 0.0).setTimedLife(10.0, 'BHwe')
    let t = GetSpellTargetUnit()
    t.addAbility('A0AJ')
    let charges = Artifact.charges(caster, 'I00R')
    if charges > 0
        t.setAbilityLevel('A0AJ', charges)

// ============================================================
// Артефакт: ArmorMinusA — способность 'A0AN'
// ============================================================

function artArmorMinusA(unit caster)
    let a = Artifact.charges(caster, 'I00U')
    addEffect("Abilities\\Spells\\Other\\HowlOfTerror\\HowlCaster.mdl", caster.getPos())
    auraDummy(caster.getOwner(), caster.getPos(), 'A0AO', a, 10.0)

// ============================================================
// Артефакт: IronSkinA — способность 'A0AL'
// ============================================================

function artIronSkinA(unit caster)
    let u = caster
    let t = GetSpellTargetUnit()
    if t.getAbilityLevel('A0C4') == 0
        t.addAbility('A0AM')
        t.addAbility('S00T')
        addEffect("Abilities\\Spells\\NightElf\\Taunt\\TauntCaster.mdl", t, "overhead").destr()
        if u.getAbilityLevel('A0AL') == 2
            t.setAbilityLevel('A0AM', 2)
    else
        DisplayTextToPlayer(u.getOwner(), 0.0, 0.0, "Not allowed! Anti-abuse")

// ============================================================
// Артефакт: StopAllA — способность 'A0AQ'
// ============================================================

function artStopAllA(unit _caster)
    forUnitsInRange(vec2(GetSpellTargetX(), GetSpellTargetY()), 300.0) u ->
        if (u.isType(UNIT_TYPE_TAUREN) or u.isType(UNIT_TYPE_GIANT)) and not u.isType(UNIT_TYPE_HERO) and u.isAlive() and u.getAbilityLevel('A0AR') < 1
            u.addAbility('A0AR')
            u.setMoveSpeed(0.0)
            let fx2 = addEffect("Abilities\\Spells\\Other\\TalkToMe\\TalkToMe.mdl", u, "overhead")
            let fx3 = addEffect("Abilities\\Spells\\Other\\Silence\\SilenceAreaBirth.mdl", u, "chest")
            doAfter(2.5) ->
                u.removeAbility('A0AR')
                u.setMoveSpeed(u.getDefaultMovespeed())
                fx2.destr()
                fx3.destr()

// ============================================================
// Артефакт: MinaA — способность 'A0AW'
// ============================================================

function artMinaA(unit caster)
    let target = vec2(GetSpellTargetX(), GetSpellTargetY())
    InstantDummyCaster.castImmediate(caster.getOwner(), 'A0AX', 1, OrderIds.stomp, target)
    addEffect("Units\\NightElf\\Wisp\\WispExplode.mdl", target).destr()

// ============================================================
// Артефакт: StompA — способность 'A0AZ'
// ============================================================

function artStompA(unit caster)
    let x = GetSpellTargetX()
    let y = GetSpellTargetY()
    let lvl = Artifact.charges(caster, 'I017')
    for b = 1 to 8
        Artifact.dummy(caster.getOwner(), vec2(x, y), 2.0)
            ..castPoint('A0B0', lvl, OrderIds.shockwave, vec2(x + 256 * Cos(b * 0.785385), y + 256 * Sin(b * 0.785385)))

// ============================================================
// Артефакт: ArtDopGoldaA — способность 'A0B3'
// ============================================================

function artArtDopGoldaA(unit caster)
    let t = GetSpellTargetUnit()
    let p = caster.getOwner()
    // продажа юнита: 4 цены, если у него <= 500 HP (тогда он исчезает), иначе 2 цены
    let gold = unitGold(t, caster.getTypeId()) * (t.getHP() <= 500 ? 4 : 2)
    addEffect("Abilities\\Spells\\Other\\Transmute\\PileofGold.mdl", t.getPos()).destr()
    p.setGold(p.getGold() + gold)
    if t.getHP() <= 500
        t.remove()
    text(t, "|cffFFFF00+" + gold + "|r", 10.0, 3.50, 50.0)

// ============================================================
// Артефакт: DopHealA — способность 'A0B4'
// ============================================================

function artDopHealA(unit caster)
    let p = caster.getOwner()
    let c = Artifact.charges(caster, 'I01M')
    var a = 200
    if c == 3
        a = 520
    else if c == 2
        a = 360
    forUnitsInRange(vec2(GetSpellTargetX(), GetSpellTargetY()), 600.0) u ->
        if u.isAllyOf(p) and u.isAlive() and (u.isType(UNIT_TYPE_TAUREN) or u.isType(UNIT_TYPE_GIANT))
            addEffect("Abilities\\Spells\\Human\\Heal\\HealTarget.mdl", u, "origin").destr()
            u.setHP(u.getHP() + a)

// ============================================================
// Артефакт: FullSellA — способность 'A0B6'
// ============================================================

function artFullSellA(unit caster)
    let p = caster.getOwner()
    prodajaUnit = 0
    // сначала собираем группу, потом удаляем — не удаляем юнитов прямо во время перебора
    let g = unitsInRange(vec2(GetSpellTargetX(), GetSpellTargetY()), 250.0, (u) -> u.getOwner() == p and u.isAlive() and (u.isType(UNIT_TYPE_TAUREN) or u.isType(UNIT_TYPE_GIANT)) and not u.isType(UNIT_TYPE_HERO))
    g.forEachFrom() u ->
        var a = 2 * GetFoodUsed(UnitId(GetAbilityEffectById(u.getTypeId(), EFFECT_TYPE_TARGET, 0)))
        if a == 0
            a = getUnitFood(caster.getTypeId())
        prodajaUnit = prodajaUnit + 1
        if prodajaUnit < 15
            addEffect("Abilities\\Spells\\Other\\Transmute\\PileofGold.mdl", u.getPos()).destr()
            p.setGold(p.getGold() + a)
            text(u, "|cffFFFF00+" + a + "|r", 10.0, 3.50, 50.0)
            u.remove()
    g.release()

// ============================================================
// Артефакт: DoomA — способность 'A0B8'
// ============================================================

function artDoomA(unit caster)
    let u = CreateUnit(caster.getOwner(), 'n03A', GetSpellTargetX(), GetSpellTargetY(), 0.0)
    addEffect("Abilities\\Spells\\Other\\Doom\\DoomDeath.mdl", vec2(GetSpellTargetX(), GetSpellTargetY())).destr()
    u.setTimedLife(60.0, 'BHwe')
    u.addAbility('A0F6')

// ============================================================
// Артефакт: FenixA — способность 'A0BB'
// ============================================================

function artFenixA(unit caster)
    let p = caster.getOwner()
    let charges = Artifact.charges(caster, 'I013')
    forUnitsInRange(vec2(GetSpellTargetX(), GetSpellTargetY()), 300.0) u ->
        if u.isEnemyOf(p) and u.isAlive() and u.getAbilityLevel('Avul') == 0
            let fenix = CreateUnit(p, 'e01K', caster.getX(), caster.getY(), 0.0)
            if charges > 0
                fenix.setTimedLife(charges.toReal() * 1.10, 'BHwe')
            fenix.issueTargetOrder("attack", u)

// ============================================================
// Артефакт: WyhrA — способность 'A0BC'
