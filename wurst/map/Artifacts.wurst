import ClosureTimers
import ClosureEvents
import ClosureForGroups
import HashMap
import DummyCaster
import InstantDummyCaster
import Orders
import Dummies
import UnitSearch
import GroupUtils

/*
    Артефакт — предмет героя. Улучшается способностью «Улучшить артефакт» ('A007'): каждое улучшение даёт
    предмету заряд и поднимает уровень его пассивной способности (бывший 680-строчный ArtefactUp).
    Эффекты самих артефактов регистрируются через Artifact.onCast(abilId). */
public class Artifact
    static constant byItem = new HashMap<int, Artifact>()
    int itemId
    int abilId      // пассивка, уровень которой растёт с каждым улучшением (0 — нет)
    int maxCharges
    int gold        // сколько золота нужно для улучшения
    int lifeMult    // 0 — списывается gold; иначе списывается (жизнь предмета * lifeMult), а userData предмета += udStep
    int udStep

    construct(int itemId, int abilId, int maxCharges, int gold)
        this.itemId = itemId
        this.abilId = abilId
        this.maxCharges = maxCharges
        this.gold = gold
        byItem.put(itemId, this)

    construct(int itemId, int abilId, int maxCharges, int gold, int lifeMult, int udStep)
        this.itemId = itemId
        this.abilId = abilId
        this.maxCharges = maxCharges
        this.gold = gold
        this.lifeMult = lifeMult
        this.udStep = udStep
        byItem.put(itemId, this)

    /** Улучшение предмета i, лежащего у героя u */
    function upgrade(unit u, item i)
        let p = u.getOwner()
        if i.getCharges() >= maxCharges
            DisplayTextToPlayer(p, 0.0, 0.0, "Fully upgraded")
            return
        if p.getGold() < gold
            DisplayTextToPlayer(p, 0.0, 0.0, "Not enough gold")
            return
        var paid = gold
        var value = i.getLife().toInt()
        if lifeMult > 0
            let same = u.itemInSlot(slotOf(u, itemId))
            same.setUserData(same.getUserData() + udStep)
            artG = (i.getLife() * lifeMult).toInt() // глобал: читается в ArtefactUp-совместимых местах
            paid = artG
            value = artG
        p.setGold(p.getGold() - paid)
        i.setCharges(i.getCharges() + 1)
        if abilId != 0
            u.incAbilityLevel(abilId)
        addEffect("Abilities\\Spells\\Items\\AIsm\\AIsmTarget.mdl", u.getPos()).destr()
        powerItem[p.getId()] = powerItem[p.getId()] + value

    /** Улучшение по предмету: если предмет — артефакт из таблицы */
    static function upgradeItem(unit u, item i)
        let art = byItem.get(i.getTypeId())
        if art != null
            art.upgrade(u, i)

    /** Эффект артефакта: срабатывает, когда любой юнит применяет способность abilId */
    static function onCast(int abilId, OnCastListener listener)
        EventListener.onCast(abilId, listener)

    /** Реакция на событие любого юнита (общий триггер stdlib) */
    static function onEvent(playerunitevent e, code handler)
        registerPlayerUnitEvent(e, handler)

    /** Заряды предмета данного типа в инвентаре (0, если предмета нет; при дублях — последний слот) */
    static function charges(unit u, int itemId) returns int
        var n = 0
        for slot = 0 to 5
            let itm = u.itemInSlot(slot)
            if itm != null and itm.getTypeId() == itemId
                n = itm.getCharges()
        return n

    /** Первый слот с предметом данного типа (7, если нет — как в оригинале) */
    static function slotOf(unit u, int itemId) returns int
        var slot = 0
        while not (u.itemInSlot(slot).getTypeId() == itemId or slot == 7)
            slot++
        return slot

    /** Даммик-кастер stdlib за игрока owner на pos, живёт life секунд (для снарядов, каналов и отложенного урона;
        мгновенные способности — через InstantDummyCaster). Уровень способности передаётся в castX (0 → 1) */
    static function dummy(player owner, vec2 pos, real life) returns DummyCaster
        return new DummyCaster()
            ..owner(owner)
            ..origin(pos)
            ..delay(life)

// ============================================================
// Артефакт: BuyArtefacts — EVENT_PLAYER_UNIT_SELL_ITEM
// ============================================================

/** Артефакты «на урон» — их можно купить не больше limitArt */
function isDamageArtifact(int id) returns bool
    return id == 'I003' or id == 'I013' or id == 'I017' or id == 'I01B' or id == 'I01C' or id == 'I008' or id == 'I01J' or id == 'I01H' or id == 'I01E' or id == 'I01D'

/** Артефакты «на стан» — их можно купить не больше limitArt */
function isStunArtifact(int id) returns bool
    return id == 'I006' or id == 'I00E' or id == 'I00X' or id == 'I015' or id == 'I021' or id == 'I00J' or id == 'I00S'

/** Магазин «Проданное» команды игрока */
function player.soldShop() returns unit
    return magazin[forceG[1].containsPlayer(this) ? 7 : 16]

/** Лимит превышен: покупка отменяется, золото назад, предмет обратно в магазин команды */
function refuseArtifact(unit seller, item i, player p, string kind)
    let id = i.getTypeId()
    DisplayTextToPlayer(p, 0.0, 0.0, "Artifact limit for " + kind + " in the amount of " + limitArt[p.getId()] + " pcs")
    p.setGold(p.getGold() + i.getLife().toInt())
    powerItem[p.getId()] -= i.getLife().toInt()
    let shop = p.soldShop()
    AddItemToStock(shop, id, 1, 1)
    if seller.getTypeId() == 'n03P'
        // куплено в «Проданном»: пересоздать позицию, чтобы предмет там остался
        RemoveItemFromStock(shop, id)
        doAfter(0.01) ->
            AddItemToStock(shop, id, 1, 1)
    i.remove()

@noinline
function artBuyArtefacts()
    let u = GetBuyingUnit()
    let i = GetSoldItem()
    let p = u.getOwner()
    let idP = p.getId()
    let m = GetTriggerUnit()
    let id = i.getTypeId()
    powerItem[idP] += i.getLife().toInt()
    if m.getTypeId() == 'n03P'
        RemoveItemFromStock(m, id)
    if isDamageArtifact(id)
        itemZapretD[idP] += 1
        if itemZapretD[idP] > limitArt[idP]
            itemZapretD[idP] = limitArt[idP]
            refuseArtifact(m, i, p, "damage")
    else if isStunArtifact(id)
        itemZapretS[idP] += 1
        if itemZapretS[idP] > limitArt[idP]
            itemZapretS[idP] = limitArt[idP]
            refuseArtifact(m, i, p, "stun")

// ============================================================
// Артефакт: UpArt — EVENT_PLAYER_UNIT_USE_ITEM
// ============================================================

/** Артефакты с активной способностью: при использовании заряд возвращается (предмет не расходуется) */
function isActiveArtifact(int id) returns bool
    return id == 'I002' or id == 'I005' or id == 'I007' or id == 'I008' or id == 'I00D' or id == 'I00E' or id == 'I00I' or id == 'I00K' or id == 'I00M' or id == 'I00O' or id == 'I00P' or id == 'I00R' or id == 'I00S' or id == 'I00U' or id == 'I00Z' or id == 'I012' or id == 'I013' or id == 'I016' or id == 'I017' or id == 'I01B' or id == 'I01C' or id == 'I01D' or id == 'I01H' or id == 'I01J' or id == 'I01K' or id == 'I01L' or id == 'I01M' or id == 'I01N' or id == 'I01P' or id == 'I020' or id == 'I021' or id == 'I00T' or id == 'I025'

@noinline
function artUpArt()
    let i = GetManipulatedItem()
    if isActiveArtifact(i.getTypeId())
        i.setCharges(i.getCharges() + 1)

// ============================================================
// Артефакт: AddArtas — способность 'A0ER'
// ============================================================

function artAddArtas(unit caster)
    let i = GetSpellTargetItem()
    let id = caster.getOwner().getId()
    // в первый свободный из четырёх слотов Артаса; заряды сбрасываются до 1
    var free = -1
    for slot = 0 to 3
        if free < 0 and arthas[id].itemInSlot(slot) == null
            free = slot
    if free >= 0
        arthas[id].addItemHandle(i)
        if i.getCharges() >= 1
            i.setCharges(1)
        builders[id].removeItem(i)
        return
    DisplayTextToPlayer(caster.getOwner(), 0.0, 0.0, "Impossible")
    caster.issueImmediateOrder("stop")

