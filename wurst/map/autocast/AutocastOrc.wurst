package AutocastOrc
import Initialization
import MapGlobals
import ClosureEvents
import UnitEvents
import ClosureTimers
import ClosureForGroups
import DummyCaster
import InstantDummyCaster
import Orders
import UnitSearch
import GroupUtils

// ============================================================
// Триггер: Res — 'o005' (не призванный) после смерти встаёт полупрозрачным на 7 секунд
// ============================================================

@noinline
function res()
    let d = GetDyingUnit()
    if d.isType(UNIT_TYPE_SUMMONED)
        return
    CreateUnit(d.getOwner(), 'o005', d.getX(), d.getY(), 0.0)
        ..setVertexColor(255, 255, 255, 155)
        ..setTimedLife(7.0, 'BHwe')
        ..attackLane()
    d.remove()
    addEffect("Abilities\\Spells\\Human\\Resurrect\\ResurrectTarget.mdl", d.getPos()).destr()

// ============================================================
// Триггер: Viverna — каждая 6-я атака: на секунду 'A027'
// ============================================================

@noinline
function viverna()
    let a = GetAttacker()
    let lvl = a.getAbilityLevel('A028')
    if lvl <= 0
        return
    addEffect("Abilities\\Spells\\Undead\\ReplenishMana\\SpiritTouchTarget.mdl", a, "overhead").destr()
    if lvl == 1
        a.addAbility('A027')
        doAfter(1.0) ->
            a.removeAbility('A027')
    if lvl == 6
        a.setAbilityLevel('A028', 1)
    else
        a.incAbilityLevel('A028')

// ============================================================
// Триггер: Axe — с шансом 10% «вихрь»: 100 урона врагам рядом, 'A02F' снимается на 2 с; при HP <= 38% рёв и снятие 'A02E'
// ============================================================

@noinline
function axe()
    let c = GetTriggerUnit()
    if c.getAbilityLevel('A02F') != 1
        return
    let p = c.getOwner()
    if GetRandomInt(1, 100) <= 10 and c.isAlive()
        c.removeAbility('A02F')
        c.setAnimation("Spin")
        forUnitsInRange(c.getPos(), 220.0) u ->
            if u.isEnemyOf(p) and u.isAlive() and (u.isType(UNIT_TYPE_TAUREN) or u.isType(UNIT_TYPE_GIANT))
                c.damageTarget(u, 100.0, true, false, ATTACK_TYPE_MELEE, DAMAGE_TYPE_NORMAL, WEAPON_TYPE_WHOKNOWS)
                addEffect("Abilities\\Spells\\Other\\Stampede\\StampedeMissileDeath.mdl", u.getPos()).destr()
        doAfter(2.0) ->
            c.addAbility('A02F')
    if c.getHP() / c.getMaxHP() <= 0.38
        c.issueImmediateOrder("roar")
        doAfter(3.0) ->
            c.removeAbility('A02E')

// ============================================================
// Триггер: TotemDamage — 'o00L' при полной мане ставит тотем 'o00J' с 'A02C' на 10 секунд
// ============================================================

@noinline
function totemDamage()
    let a = GetAttacker()
    if a.getMana() != 60
        return
    CreateUnit(a.getOwner(), 'o00J', GetTriggerUnit().getX(), GetTriggerUnit().getY(), 0.0)
        ..setTimedLife(10.0, 'BHwe')
        ..addAbility('A02C')
    a.setMana(0.0)

// ============================================================
// Триггер: TrollB — тролли с шансом 25% получают набор способностей на 5 секунд
// ============================================================

@noinline
function trollB()
    let a = GetAttacker()
    let id = a.getTypeId()
    if a.hasAbility('A0BK') or a.hasAbility('A0BL') or GetRandomInt(1, 4) > 1
        return
    let strong = id == 'o009'
    let abil1 = strong ? 'A06L' : 'A0BM'
    let abil2 = strong ? 'A01M' : 'A0BH'
    let mark = strong ? 'A0BK' : 'A0BL'
    a..addAbility(abil1)..addAbility(abil2)..addAbility(mark)
    doAfter(5.0) ->
        a..removeAbility(abil1)..removeAbility(abil2)..removeAbility(mark)

// ============================================================
// Триггер: Troll — при HP >= 50% тролль бьёт дополнительно (4 / 10) ценой своего HP и держит 'A02G'
// ============================================================

@noinline
function troll()
    let a = GetAttacker()
    let id = a.getTypeId()
    if a.getHP() / a.getMaxHP() >= 0.50
        if not a.hasAbility('A02G')
            a.addAbility('A02G')
        let dmg = id == 'o00A' ? 4.0 : 10.0
        a.setHP(a.getHP() - dmg)
        a.damageTarget(GetTriggerUnit(), dmg, true, false, ATTACK_TYPE_NORMAL, DAMAGE_TYPE_ENHANCED, WEAPON_TYPE_WHOKNOWS)
    else if a.getAbilityLevel('A02G') == 1
        a.removeAbility('A02G')

// ============================================================
// Триггер: GoldUkral — мародёр с шансом 30% крадёт золото (3 у 'o00R', 5 у 'o006') и теряет 'A02H'
// ============================================================

@noinline
function goldUkral()
    let a = GetAttacker()
    let id = a.getTypeId()
    if a.getAbilityLevel('A02H') != 1 or GetRandomInt(1, 10) > 3
        return
    a.removeAbility('A02H')
    let gold = id == 'o00R' ? 3 : 5
    let p = a.getOwner()
    let victim = GetTriggerUnit().getOwner()
    p.setGold(p.getGold() + gold)
    victim.setGold(victim.getGold() - gold)
    rob[p.getId()] += gold
    DisplayTextToPlayer(p, 0.0, 0.0, "|cff80ff00Marauder: |r|cffffff00Boss, I swiped " + gold + " gold from the enemy!|r")

// ============================================================
// Триггер: RedOrk — 'o004': уровень 'A03G' = потерянные HP в десятках процентов + 1; ниже 38% — берсерк
// ============================================================

@noinline
function redOrk()
    let u = GetAttacker()
    let lost = 1 - u.getHP() / u.getMaxHP()
    let lvl = (100 * lost).toInt() div 10 + 1
    if u.getAbilityLevel('A03G') != lvl
        u.setAbilityLevel('A03G', lvl)
    if u.getHP() / u.getMaxHP() <= 0.38 and u.getAbilityLevel('A03F') != 2
        u.issueImmediateOrder("berserk")

// ============================================================
// Триггер: RedOrk1 — на время берсерка ('A03C', 3 с) 'A03F' второго уровня
// ============================================================

@noinline
function redOrk1(unit u)
    u.setAbilityLevel('A03F', 2)
    doAfter(3.0) ->
        u.setAbilityLevel('A03F', 1)

// ============================================================
// Триггер: KodoyRUINA — кодой 'o00D' с 'A02L' съедает ослабленную цель: HP, золото за неё, 'A02L' возвращается позже
// ============================================================

@noinline
function kodoyRuina()
    let a = GetAttacker()
    let t = GetTriggerUnit()
    if t.getAbilityLevel('A094') == 1 or a.getAbilityLevel('A02L') != 1 or t.getHP() > 600 or t.getMaxHP() > 1600
        return
    let gold = unitGold(t, t.getTypeId())
    let p = a.getOwner()
    doAfter(t.getHP() / 30) ->
        a.addAbility('A02L')
    doAfter(0.10) ->
        a.attackLane()
    a.setHP(a.getHP() + t.getHP())
    a.removeAbility('A02L')
    p.setGold(p.getGold() + gold)
    goldText(t, p, gold)
    t.remove()

// ============================================================
// Триггер: Tauren — с шансом 25% бьёт до трёх врагов рядом (40 у 'o008', 80 с эффектом у 'o007')
// ============================================================

@noinline
function tauren()
    let a = GetAttacker()
    if GetRandomInt(1, 4) != 1
        return
    let p = a.getOwner()
    let weak = a.getTypeId() == 'o008'
    // до трёх первых попавшихся врагов рядом
    let g = firstUnitsInRange(a.getPos(), 250.0, 3, (u) -> u.isEnemyOf(p) and u.isAlive() and u.getAbilityLevel('Avul') == 0)
    a.setAnimation("attack slam")
    g.forEachFrom() u ->
        if not a.isType(UNIT_TYPE_DEAD)
            a.damageTarget(u, weak ? 40.0 : 80.0, true, false, ATTACK_TYPE_NORMAL, DAMAGE_TYPE_ENHANCED, WEAPON_TYPE_WHOKNOWS)
            if not weak
                addEffect("Abilities\\Spells\\Human\\Thunderclap\\ThunderClapCaster.mdl", u.getPos()).destr()
    g.release()

// ============================================================
// Триггер: Tauren2 — 'o007' при HP <= 90% один раз получает 'A0DF' на 3 с (метка 'A0DE')
// ============================================================

@noinline
function tauren2()
    let t = GetTriggerUnit()
    if t.getAbilityLevel('A0DE') == 1 or t.getHP() / t.getMaxHP() > 0.90
        return
    t.addAbility('A0DF')
    t.addAbility('A0DE')
    doAfter(3.0) ->
        t.removeAbility('A0DF')
    addEffect("Abilities\\Spells\\Items\\TomeOfRetraining\\TomeOfRetrainingCaster.mdl", t.getPos()).destr()

// ============================================================
// Триггер: OgrMage — молот по случайному врагу; под 'B010' — мультикаст (см. Multikast)
// ============================================================

/** Огр-маг под «мультикастом» ('B010') сейчас кастует 'A03O' даммиком: раньше флаг висел на самом даммике
    (custom value = 5, потом hash), теперь даммик общий, а Multikast срабатывает прямо во время приказа — читает отсюда */
bool ogreMulticast = false

@noinline
function ogrMage()
    let a = GetAttacker()
    if a.getTypeId() == 'n00Y' and a.getMana() < 60
        return
    let p = a.getOwner()
    let t = randomUnitInRange(a.getPos(), 500.0, (u) -> u.isEnemyOf(p) and u.isAlive() and u.getAbilityLevel('Avul') != 1)
    ogreMulticast = a.getAbilityLevel('B010') > 0
    if ogreMulticast
        a.setMana(a.getMana() + 1)
        addEffect("Abilities\\Spells\\Undead\\ReplenishMana\\ReplenishManaCaster.mdl", a, "chest").destr()
    a.setMana(0.0)
    if t != null
        new DummyCaster()
            ..owner(p)
            ..origin(a.getPos())
            ..delay(3.0)
            ..castTarget('A03O', 1, OrderIds.thunderbolt, t)
    ogreMulticast = false

// ============================================================
// Триггер: Multikast — молот огра под мультикастом бьёт ещё 1-3 раза по 100
// ============================================================

@noinline
function multikast(unit caster)
    if not ogreMulticast
        return
    let t = GetSpellTargetUnit()
    let times = GetRandomInt(1, 3)
    text(t, "|cffFFff00X" + times + "|r", 12.0, 3.50, 50.0)
    for i = 1 to times
        addEffect("Abilities\\Spells\\Other\\Incinerate\\FireLordDeathExplode.mdl", t.getPos()).destr()
        caster.damageTarget(t, 100.0, true, false, ATTACK_TYPE_NORMAL, DAMAGE_TYPE_MAGIC, WEAPON_TYPE_WHOKNOWS)

// ============================================================
// Триггер: Beorn — 'A03R' растёт до 21 (на 10-м эффект); с шансом 10% +100 урона
// ============================================================

@noinline
function beorn()
    let a = GetAttacker()
    let lvl = a.getAbilityLevel('A03R')
    if lvl < 1
        return
    if lvl <= 20
        a.incAbilityLevel('A03R')
        if lvl + 1 == 10
            addEffect("Abilities\\Spells\\Orc\\TrollBerserk\\HeadhunterWEAPONSRight.mdl", a, "overhead")
    if GetRandomInt(1, 10) == 2 and a.isAlive()
        a.damageTarget(GetTriggerUnit(), 100.0, true, false, ATTACK_TYPE_MELEE, DAMAGE_TYPE_NORMAL, WEAPON_TYPE_WHOKNOWS)
        addEffect("Abilities\\Spells\\Orc\\WarStomp\\WarStompCaster.mdl", GetTriggerUnit().getPos()).destr()

// ============================================================
// Триггер: Attack2 — 'n00M'/'n00H' выпускают на секунду снаряд-юнита по другому гиганту рядом с целью
// ============================================================

@noinline
function attack2()
    let a = GetAttacker()
    let id = a.getTypeId()
    let p = a.getOwner()
    let c = GetTriggerUnit()
    let t = firstUnitInRange(c.getPos(), 500.0, (u) -> u.isEnemyOf(p) and u.isAlive() and u.isType(UNIT_TYPE_GIANT) and u != c)
    CreateUnit(p, id == 'n00H' ? 'n00A' : 'n010', c.getX(), c.getY(), 0.0)
        ..setTimedLife(1.0, 'BHwe')
        ..issueTargetOrder("attackonce", t)

// ============================================================
// Триггер: Fiol Salamandra — 'A044' при HP <= 675 (и 'B015'), снимается выше
// ============================================================

@noinline
function fiolSalamandra()
    let a = GetAttacker()
    if a.getAbilityLevel('B016') != 1 and a.getAbilityLevel('B015') >= 1 and a.getHP() <= 675 and a.getHP() > 1
        a.addAbility('A044')
    if a.getAbilityLevel('B016') >= 1 and a.getHP() > 675
        a.removeAbility('A044')

// ============================================================
// Триггер: KillMe — 'n03Q' взрывается ('unstableconcoction') о ближайшего летающего гиганта
// ============================================================

@noinline
function killMe()
    let c = GetTriggerUnit()
    let p = c.getOwner()
    let t = firstUnitInRange(c.getPos(), 500.0, (u) -> u.isEnemyOf(p) and u.isAlive() and u.isType(UNIT_TYPE_GIANT) and u.getAbilityLevel('A00W') == 1)
    if t != null
        c.issueTargetOrder("unstableconcoction", t)

// ============================================================
// Триггер: KillMe1 — после каста 'A07N': как только кастер умрёт (в течение 2 с), цель получает урон = его HP
// ============================================================

@noinline
function killMe1(unit c)
    let t = GetSpellTargetUnit()
    let hp = c.getHP()
    doPeriodicallyCounted(0.1, 20) cb ->
        if not c.isAlive()
            c.damageTarget(t, hp, true, false, ATTACK_TYPE_CHAOS, DAMAGE_TYPE_NORMAL, WEAPON_TYPE_WHOKNOWS)
            cb.stop()

// ============================================================
// Триггер: BloodLust — 'o00O'/'o00N' при полной мане кровожадность на случайного гиганта-рукопашника
// ============================================================

@noinline
function bloodLust()
    let a = GetAttacker()
    let id = a.getTypeId()
    if a.getMana() != 60
        return
    let p = a.getOwner()
    let t = randomUnitInRange(a.getPos(), 600.0, (u) -> u.isAllyOf(p) and u.isAlive() and u.getTypeId() != 'n03J' and u.isType(UNIT_TYPE_GIANT) and u.isType(UNIT_TYPE_MELEE_ATTACKER) and u.getAbilityLevel('Bblo') != 1)
    if t != null
        a.setMana(0.0)
        InstantDummyCaster.castTarget(p, id == 'o00O' ? 'A025' : 'A024', 1, OrderIds.bloodlust, t, a.getPos())

init
    onDeathOf('o005') ->
        res()
    onAnyAttack() ->
        viverna()
    onAnyAttack() ->
        axe()
    onAttackBy('o00L') ->
        totemDamage()
    onAttackBy('o00A', 'o009') ->
        trollB()
    onAttackBy('o009', 'o00A') ->
        troll()
    onAttackBy('o006', 'o00R') ->
        goldUkral()
    onAttackBy('o004') ->
        redOrk()
    onAttackBy('o00D') ->
        kodoyRuina()
    onAttackBy('o008', 'o007') ->
        tauren()
    onAttacked('o007') ->
        tauren2()
    onAttackBy('n00Y', 'n00D') ->
        ogrMage()
    onAnyAttack() ->
        beorn()
    onAttackBy('n00M', 'n00H') ->
        attack2()
    onAnyAttack() ->
        fiolSalamandra()
    onAttacked('n03Q') ->
        killMe()
    onAttackBy('o00O', 'o00N') ->
        bloodLust()
    EventListener.onCast('A03C') (caster) ->
        redOrk1(caster)
    EventListener.onCast('A03O') (caster) ->
        multikast(caster)
    EventListener.onCast('A07N') (caster) ->
        killMe1(caster)
