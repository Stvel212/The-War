package UpgradeCosts
import HashMap

/*
	Reforged показывает и списывает цену «Улучшить» как (цель − текущее здание), классика — цену самого улучшения.
	Чтобы игрок видел и платил столько же, сколько в оригинале, в объектах у целей улучшений стоит
	(своя цена + цена здания-источника). Здесь — обратная таблица, чтобы скрипт получал СВОЮ цену типа, как раньше.
	Таблица генерируется tools/UpgradeCosts.java из wurst/objects/units. */

constant sourceGold = new HashMap<int, int>()
constant sourceLumber = new HashMap<int, int>()

/** цена типа юнита без учёта здания, из которого он улучшается (= GetUnitGoldCost из оригинала) */
public function unitOwnGoldCost(int unitId) returns int
	return GetUnitGoldCost(unitId) - sourceGold.get(unitId)

public function unitOwnWoodCost(int unitId) returns int
	return GetUnitWoodCost(unitId) - sourceLumber.get(unitId)

